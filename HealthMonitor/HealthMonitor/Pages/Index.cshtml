@page "/Pages/Index"
@*@functions {}*@

<!DOCTYPE html>
<html>
<head>
    <title>Health Monitor</title>
    <style>
        body { background-color: #1e1e1e; color: #e0e0e0; font-family: 'Courier New', Courier, monospace; margin: 0; padding: 20px; }
        h1 { color: #ffcc00; }
        .chart-container { background-color: #252526; border: 1px solid #3e3e42; padding: 10px; margin-bottom: 20px; border-radius: 5px; }
        .controls { margin-bottom: 20px; padding: 10px; background-color: #333; display: inline-block; border-radius: 5px; }
        label { margin-right: 10px; }
        input, button { background-color: #3c3c3c; color: white; border: 1px solid #555; padding: 5px; border-radius: 3px; }
        button { cursor: pointer; }
        button:hover { background-color: #505050; }
        svg { background-color: black; width: 100%; height: 400px; }
        .axis-label { fill: white; font-size: 12px; }
        .legend { font-size: 12px; }
        .line { fill: none; stroke-width: 2px; }
        .grid line { stroke: #444; stroke-opacity: 0.7; shape-rendering: crispEdges; }
        .grid path { stroke-width: 0; }
    </style>
</head>
<body>

    <h1>Health Monitor Dashboard</h1>

    <div class="controls">
        <label>Retention (Days): <input type="number" id="daysInput" value="1" min="1" max="365"></label>
        <button onclick="loadData()">Reload</button>
        <button onclick="saveSvg('latencyChart')">Save Latency SVG</button>
        <button onclick="saveSvg('successChart')">Save Success SVG</button>
    </div>

    <h3>Latency (ms)</h3>
    <div class="chart-container">
        <svg id="latencyChart"></svg>
    </div>

    <h3>Success Rate (%)</h3>
    <div class="chart-container">
        <svg id="successChart"></svg>
    </div>

    <script src="/static/d3.js"></script>
    <script>
        // Color generator to match Eto random shapes/colors visually
        const colorScale = d3.scaleOrdinal(d3.schemeCategory10);
        
        async function loadData() {
            const days = document.getElementById('daysInput').value;
            try {
                const response = await fetch(`/api/pings?days=${days}`);
                const rawData = await response.json();
                
                renderChart(rawData, '#latencyChart', 'LatencyAverage', 'TimeIso');
                renderChart(rawData, '#successChart', 'SuccessRate', 'TimeIso');
            } catch (e) {
                console.error("Error loading data", e);
                alert("Failed to load data from API.");
            }
        }

        function renderChart(rawData, svgSelector, valueKey, timeKey) {
            const svg = d3.select(svgSelector);
            svg.selectAll("*").remove();

            const margin = {top: 20, right: 80, bottom: 30, left: 50};
            const width = svg.node().getBoundingClientRect().width - margin.left - margin.right;
            const height = 400 - margin.top - margin.bottom;

            const g = svg.append("g")
                .attr("transform", `translate(${margin.left},${margin.top})`);

            const x = d3.scaleTime().range([0, width]);
            const y = d3.scaleLinear().range([height, 0]);

            // Aggregate all points for domain calculation
            let allPoints = [];
            Object.keys(rawData).forEach(dest => {
                rawData[dest].forEach(d => {
                    allPoints.push({
                        date: new Date(d[timeKey]),
                        value: d[valueKey],
                        dest: dest
                    });
                });
            });

            if (allPoints.length === 0) {
                g.append("text").attr("fill", "white").text("No data for selected range.");
                return;
            }

            x.domain(d3.extent(allPoints, d => d.date));
            y.domain([0, d3.max(allPoints, d => d.value) * 1.1 || 100]);

            // Grid
            g.append("g")
                .attr("class", "grid")
                .attr("transform", `translate(0,${height})`)
                .call(d3.axisBottom(x).tickSize(-height).tickFormat(""));

            g.append("g")
                .attr("class", "grid")
                .call(d3.axisLeft(y).tickSize(-width).tickFormat(""));

            // Axes
            g.append("g")
                .attr("transform", `translate(0,${height})`)
                .call(d3.axisBottom(x).ticks(5).tickFormat(d3.timeFormat("%H:%M")))
                .selectAll("text").attr("fill", "white");

            g.append("g")
                .call(d3.axisLeft(y))
                .selectAll("text").attr("fill", "white");

            // Lines
            const line = d3.line()
                .x(d => x(new Date(d[timeKey])))
                .y(d => y(d[valueKey]))
                .curve(d3.curveMonotoneX);

            const destinations = Object.keys(rawData);
            destinations.forEach((dest, i) => {
                const data = rawData[dest];
                g.append("path")
                    .datum(data)
                    .attr("class", "line")
                    .attr("stroke", colorScale(i))
                    .attr("d", line);

                // Legend
                g.append("text")
                    .attr("transform", `translate(${width + 10},${i * 20})`)
                    .attr("fill", colorScale(i))
                    .attr("class", "legend")
                    .text(dest);
            });
        }

        function saveSvg(svgId) {
            const svg = document.getElementById(svgId);
            const serializer = new XMLSerializer();
            let source = serializer.serializeToString(svg);

            // Add namespace
            if(!source.match(/^<svg[^>]+xmlns="http\:\/\/www\.w3\.org\/2000\/svg"/)){
                source = source.replace(/^<svg/, '<svg xmlns="http://www.w3.org/2000/svg"');
            }
            
            const blob = new Blob([source], {type: "image/svg+xml;charset=utf-8"});
            const url = URL.createObjectURL(blob);
            
            const a = document.createElement("a");
            a.href = url;
            a.download = `health_monitor_${svgId}_${new Date().toISOString()}.svg`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

        // Initial load
        loadData();
    </script>
</body>
</html>