@page "/Index"
<!DOCTYPE html>
<html>
<head>
    <title>Health Monitor</title>
    <link rel="icon" type="image/svg+xml" href="/static/favicon.svg">
    <style>
        body {
            background-color: #1e1e1e;
            color: #e0e0e0;
            font-family: 'Courier New', Courier, monospace;
            margin: 0;
            padding: 20px;
        }

        h1 {
            color: #ffcc00;
        }

        .chart-container {
            background-color: #252526;
            border: 1px solid #3e3e42;
            padding: 10px;
            margin-bottom: 20px;
            border-radius: 5px;
        }

        /* Updated controls layout */
        .controls {
            margin-bottom: 20px;
            padding: 15px;
            background-color: #333;
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            align-items: center;
            border-radius: 5px;
        }

        label {
            margin-right: 5px;
        }

        input, button {
            background-color: #3c3c3c;
            color: white;
            border: 1px solid #555;
            padding: 5px;
            border-radius: 3px;
        }

            /* Specific style for text inputs to be wider */
            input[type="text"] {
                width: 200px;
            }

        button {
            cursor: pointer;
        }

            button:hover {
                background-color: #505050;
            }

        svg {
            background-color: black;
            width: 100%;
            height: 450px;
        }
        /* Slightly taller */
        .axis-label {
            fill: white;
            font-size: 12px;
        }

        .legend {
            font-size: 12px;
        }

        .line {
            fill: none;
            stroke-width: 2px;
        }

        .grid line {
            stroke: #444;
            stroke-opacity: 0.7;
            shape-rendering: crispEdges;
        }

        .grid path {
            stroke-width: 0;
        }
    </style>
</head>
<body>
    <!-- Add this right after <body> tag -->
    <div id="authBar" style="background-color: #333; padding: 5px 20px; display: flex; justify-content: space-between; border-bottom: 1px solid #555;">
        <span id="authStatus">Checking auth...</span>
    </div>
    <!-- Add this Navigation Bar -->
    <div class="nav-bar" style="background-color: #333; padding: 10px; margin-bottom: 20px; border-radius: 5px;">
        <a href="/Index" style="color: #add8e6; text-decoration: none; margin-right: 15px; font-weight: bold;">Ping Monitor ⏱</a>
        <a href="/ProcessStats" style="color: #add8e6; text-decoration: none; margin-right: 15px; font-weight: bold;">Process Stats 📊</a>
        <a href="/About" style="color: #add8e6; text-decoration: none; margin-right: 15px; font-weight: bold;">About 📜</a>
    </div>
    <!-- End Navigation Bar -->

    <h1>Health Monitor Dashboard</h1>

    <div class="controls">
        <div>
            <label>Retention (Days):</label>
            <input type="number" id="daysInput" value="1" min="1" max="365" style="width: 60px;">
        </div>

        <!-- NEW: Filter Input -->
        <div>
            <label>Filter Destinations:</label>
            <input type="text" id="filterInput" placeholder="e.g. 192.168 or 8.8.8.8">
        </div>

        <div>
            <button onclick="loadData()">Reload Data</button>
        </div>

        <div>
            <button onclick="saveSvg('latencyChart')">💾 Save Latency</button>
            <button onclick="saveSvg('successChart')">💾 Save Success</button>
        </div>
    </div>

    <h3>Latency (ms)</h3>
    <div class="chart-container">
        <svg id="latencyChart"></svg>
    </div>

    <h3>Success Rate (%)</h3>
    <div class="chart-container">
        <svg id="successChart"></svg>
    </div>

    <script src="/static/d3.js"></script>
    <script>
        const colorScale = d3.scaleOrdinal(d3.schemeCategory10);
        let cachedData = {}; // Cache data to avoid refetching when just filtering

                // Check Auth Status
        async function checkAuth() {
            try {
            const resp = await fetch('/api/auth/status');
            const data = await resp.json();
            const bar = document.getElementById('authStatus');
            const daysInput = document.getElementById('daysInput');

            if (data.authenticated) {
                bar.innerHTML = `<span style="color: #4caf50;">✔ Authenticated: ${data.user}</span>`;

                // --- SET UI LIMIT FOR AUTHENTICATED USERS ---
                if (daysInput) {
                    daysInput.max = 365; // Allow full range
                    daysInput.title = "Authenticated: Up to 365 days allowed.";
                }
                // --------------------------------------------
            } else {
                // --- SET UI LIMIT FOR ANONYMOUS USERS ---
                if (daysInput) {
                    daysInput.max = 7; // Restrict to 7
                    daysInput.title = "Anonymous: Up to 7 days allowed. Login for more.";

                    // Reset value if current value is too high
                    if (parseInt(daysInput.value) > 7) {
                        daysInput.value = 7;
                    }
                }
                // ----------------------------------------

                if ("@Config.AuthMode" === "None") {
                     bar.innerHTML = `<span style="color: #888;">Auth Disabled</span>`;
                } else {
                     bar.innerHTML = `<span style="color: #ffcc00;">⚠ Anonymous</span> | <a href="/Auth" style="color: #add8e6;">Login</a>`;
                }
            }
        } catch (e) {
            console.error("Auth check failed", e);
        }
        }
        checkAuth();

        async function loadData() {
            // 1. Get the elements and values
            const daysInput = document.getElementById('daysInput');
            const days = parseInt(daysInput.value);

            // 2. Get the max attribute (set by checkAuth)
            const maxDays = parseInt(daysInput.max) || 7;
            
                // --- ADD CLIENT SIDE CHECK ---
            if (days > maxDays) {
                alert(`Error: Maximum retention is ${maxDays} days. Login for more history.`);
                return;
            }
            console.log(`Fetching data for ${days} days...`);

            try {
                const response = await fetch(`/api/pings?days=${days}`);
                // --- ADD ERROR HANDLING ---
                if (!response.ok) {
                    const errData = await response.json();
                    throw new Error(errData.error || "Server error");
                }
                // --------------------------
                cachedData = await response.json();
                console.log("Raw Data Received:", cachedData);
                applyFilterAndRender();
            } catch (e) {
                console.error("Error loading data", e);
                alert("Failed to load data from API.");
            }
        }

        function applyFilterAndRender() {
            const filterText = document.getElementById('filterInput').value.toLowerCase();
            console.log(`Applying filter: "${filterText}"`);

            const filteredData = {};
            let hasData = false;

            Object.keys(cachedData).forEach(dest => {
                // Case-insensitive check
                if (dest.toLowerCase().includes(filterText)) {
                    filteredData[dest] = cachedData[dest];
                    hasData = true;
                }
            });

            if (!hasData && filterText !== "") {
                console.log("No destinations matched filter.");
            }

            // Keys must match the JSON property names (camelCase from ASP.NET Core)
            renderChart(filteredData, '#latencyChart', 'latencyAverage', 'timeIso');
            renderChart(filteredData, '#successChart', 'successRate', 'timeIso');
        }

                function renderChart(rawData, svgSelector, valueKey, timeKey) {
            const svg = d3.select(svgSelector);
            svg.selectAll("*").remove();

            const margin = {top: 20, right: 140, bottom: 30, left: 50};

            const getDimensions = () => ({
                width: svg.node().getBoundingClientRect().width - margin.left - margin.right,
                height: 450 - margin.top - margin.bottom
            });

            let dims = getDimensions();

            const g = svg.append("g")
                .attr("transform", `translate(${margin.left},${margin.top})`);

            const x = d3.scaleTime().range([0, dims.width]);
            const y = d3.scaleLinear().range([dims.height, 0]);

            let allPoints = [];

            Object.keys(rawData).forEach(dest => {
                rawData[dest].forEach(d => {
                    allPoints.push({
                        date: new Date(d[timeKey]),
                        value: d[valueKey],
                        dest: dest
                    });
                });
            });

            if (allPoints.length === 0) {
                g.append("text").attr("fill", "white").attr("x", 20).attr("y", 20).text("No data for selected range or filter.");
                return;
            }

            const xExtent = d3.extent(allPoints, d => d.date);
            const yMax = d3.max(allPoints, d => d.value);
            x.domain(xExtent);
            y.domain([0, (yMax || 100) * 1.1]);

            const xAxisGroup = g.append("g").attr("class", "x-axis").attr("transform", `translate(0,${dims.height})`);
            const yAxisGroup = g.append("g").attr("class", "y-axis");
            const xGridGroup = g.append("g").attr("class", "grid x-grid").attr("transform", `translate(0,${dims.height})`);
            const yGridGroup = g.append("g").attr("class", "grid y-grid");

            svg.append("defs").append("clipPath")
                .attr("id", "clip-" + svgSelector.replace('#', ''))
                .append("rect")
                .attr("width", dims.width)
                .attr("height", dims.height);

            const chartBody = g.append("g").attr("class", "chart-body")
                .attr("clip-path", "url(#clip-" + svgSelector.replace('#', '') + ")");

            const line = d3.line()
                .x(d => x(new Date(d[timeKey])))
                .y(d => y(d[valueKey]))
                .curve(d3.curveMonotoneX);

            const destinations = Object.keys(rawData);
            destinations.forEach((dest, i) => {
                const data = rawData[dest];
                chartBody.append("path").datum(data).attr("class", `line line-${i}`).attr("stroke", colorScale(i)).attr("d", line);
                chartBody.selectAll(`.dot-${i}`).data(data).enter().append("circle")
                    .attr("class", `dot-${i}`).attr("cx", d => x(new Date(d[timeKey]))).attr("cy", d => y(d[valueKey])).attr("r", 3).attr("fill", colorScale(i));
            });

            const legendGroup = g.append("g").attr("class", "legends");
            function updateLegends() {
                legendGroup.selectAll("text").remove();
                destinations.forEach((dest, i) => {
                    legendGroup.append("text").attr("x", dims.width + 10).attr("y", i * 20 + 5).attr("fill", colorScale(i)).text(dest);
                });
            }
            updateLegends();

            // --- Interaction Logic ---

            // 1. Zoom (Left Click & Wheel)
            const zoom = d3.zoom()
                .scaleExtent([0.5, 20])
                // Filter: Allow Left Click (0) and Wheel, Ignore Middle (1) and Right (2)
                .filter(event => (!event.button || event.type === 'wheel') && event.type !== 'contextmenu')
                .on("zoom", (event) => {
                    const { transform } = event;
                    const newX = transform.rescaleX(x);
                    const newY = y; // X-Only Zoom

                    xAxisGroup.call(d3.axisBottom(newX).ticks(5).tickFormat(d3.timeFormat("%H:%M")));
                    yAxisGroup.call(d3.axisLeft(newY));
                    xGridGroup.call(d3.axisBottom(newX).tickSize(-dims.height).tickFormat(""));
                    yGridGroup.call(d3.axisLeft(newY).tickSize(-dims.width).tickFormat(""));

                    destinations.forEach((dest, i) => {
                        const updatedLine = d3.line().x(d => newX(new Date(d[timeKey]))).y(d => newY(d[valueKey])).curve(d3.curveMonotoneX);
                        chartBody.select(`.line-${i}`).attr("d", updatedLine);
                        chartBody.selectAll(`.dot-${i}`).attr("cx", d => newX(new Date(d[timeKey]))).attr("cy", d => newY(d[valueKey]));
                    });
                });

            // Apply Zoom to SVG
            svg.call(zoom);

            // 2. Right Click Reset
            svg.on("contextmenu", (event) => {
                event.preventDefault();
                svg.transition().duration(300).call(zoom.transform, d3.zoomIdentity);
            });

            // 3. Brush (Middle Click)
            const brush = d3.brush()
                .filter(event => event.button === 1) // Only Middle Click
                .on("end", (event) => {
                    if (!event.selection) return;
                    const [[x0, y0], [x1, y1]] = event.selection;

                    const t = d3.zoomTransform(svg.node());
                    const currentX = t.rescaleX(x);
                    const x0d = currentX.invert(x0);
                    const x1d = currentX.invert(x1);

                    const xRangeOriginal = x(x1d) - x(x0d);
                    const k = dims.width / xRangeOriginal;
                    const tx = -x(x0d) * k;

                    svg.transition().duration(300).call(zoom.transform, d3.zoomIdentity.translate(tx, 0).scale(k));
                    g.select(".brush").call(brush.move, null);
                });

            const brushG = g.append("g").attr("class", "brush").call(brush);

            // Prevent Browser Middle-Click Scroll
            svg.on("mousedown.preventScroll", event => { if (event.button === 1) event.preventDefault(); });

            function draw() {
                xAxisGroup.call(d3.axisBottom(x).ticks(5).tickFormat(d3.timeFormat("%H:%M"))).selectAll("text").attr("fill", "white");
                yAxisGroup.call(d3.axisLeft(y)).selectAll("text").attr("fill", "white");
                xGridGroup.call(d3.axisBottom(x).tickSize(-dims.height).tickFormat(""));
                yGridGroup.call(d3.axisLeft(y).tickSize(-dims.width).tickFormat(""));
            }
            draw();

            window.addEventListener('resize', () => {
                dims = getDimensions();
                x.range([0, dims.width]);
                y.range([dims.height, 0]);
                svg.select("defs rect").attr("width", dims.width).attr("height", dims.height);
                svg.call(zoom.transform, d3.zoomIdentity);
                xAxisGroup.attr("transform", `translate(0,${dims.height})`);
                xGridGroup.attr("transform", `translate(0,${dims.height})`);
                destinations.forEach((dest, i) => {
                    chartBody.select(`.line-${i}`).attr("d", line);
                    chartBody.selectAll(`.dot-${i}`).attr("cx", d => x(new Date(d[timeKey]))).attr("cy", d => y(d[valueKey]));
                });
                updateLegends();
                draw();
            });
        }

        function saveSvg(svgId) {
            const svg = document.getElementById(svgId);
            const serializer = new XMLSerializer();
            let source = serializer.serializeToString(svg);

            if(!source.match(/^<svg[^>]+xmlns="http\:\/\/www\.w3\.org\/2000\/svg"/)){
                source = source.replace(/^<svg/, '<svg xmlns="http://www.w3.org/2000/svg"');
            }

            const blob = new Blob([source], {type: "image/svg+xml;charset=utf-8"});
            const url = URL.createObjectURL(blob);

            const a = document.createElement("a");
            a.href = url;
            a.download = `health_monitor_${svgId}_${new Date().toISOString()}.svg`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

        // Event listener for the filter input box
        document.getElementById('filterInput').addEventListener('input', applyFilterAndRender);

        // Initial load
        loadData();
    </script>
</body>
</html>