    <div>
        Is this program consuming too much RAM?
    </div><br />
    <div class="preformatted">PowerShell:
        $Env:DOTNET_TieredCompilation=0
        $Env:DOTNET_gcConcurrent=0
        $Env:DOTNET_ReadyToRun=0
        $Env:DOTNET_TieredPGO=0
        $Env:DOTNET_USE_POLLING_FILE_WATCHER=1
        $Env:DOTNET_GCConserveMemory=9
        $Env:DOTNET_gcServer=0
        $Env:DOTNET_GCHeapHardLimit="0xC000000"</div>
    <div class="preformatted">Bourne-style:
        export DOTNET_TieredCompilation=0
        export DOTNET_gcConcurrent=0
        export DOTNET_ReadyToRun=0
        export DOTNET_TieredPGO=0
        export DOTNET_USE_POLLING_FILE_WATCHER=1
        export DOTNET_GCConserveMemory=9
        export DOTNET_gcServer=0
        export DOTNET_GCHeapHardLimit="0xC000000"</div>
    <br />
    <br /><br />
    <details>
        <summary>Current env variables:</summary>
        <div class="preformatted currentenv">
            @foreach (System.Collections.DictionaryEntry entry in Environment.GetEnvironmentVariables())
            {
                @($"{entry.Key} = {entry.Value}") @Html.Raw("\n")
            }
        </div>
    </details>
    <details>
        <summary>System & Version Info</summary>
        <div class="preformatted">
            @{
                try
                {
                    var proc = System.Diagnostics.Process.GetCurrentProcess();
                    var entryAsm = System.Reflection.Assembly.GetEntryAssembly();
                    var mainPath = proc.MainModule?.FileName ?? "";

                    var ver = entryAsm?.GetName().Version;
                    var infoVer = "N/A";
                    try
                    {
                        infoVer = ((System.Reflection.AssemblyInformationalVersionAttribute)Attribute.GetCustomAttribute(entryAsm, typeof(System.Reflection.AssemblyInformationalVersionAttribute)))?.InformationalVersion;
                    }
                    catch { /* Ignore attr fail */ }

                    @($"Version:       {ver}") @Html.Raw("\n")
                    @($"Info Version:  {infoVer}") @Html.Raw("\n")
                    @($"Built/Mod:     {(string.IsNullOrEmpty(mainPath) ? "Unknown" : System.IO.File.GetLastWriteTime(mainPath).ToString("yyyy-MM-dd HH:mm"))}") @Html.Raw("\n")
                    @($"Process Path:  {mainPath}") @Html.Raw("\n")
                    @($"OS/Runtime:    {System.Runtime.InteropServices.RuntimeInformation.OSDescription} / {System.Runtime.InteropServices.RuntimeInformation.FrameworkDescription}") @Html.Raw("\n")
                    @($"Uptime:        {DateTime.Now - proc.StartTime}") @Html.Raw("\n")
                    @($"Threads/Mem:   {proc.Threads.Count} / {proc.PrivateMemorySize64 / 1024 / 1024}MB")
                }
                catch (Exception ex)
                {
                    @($"Diagnostic Error: {ex.Message}")
                }
            }
        </div>
    </details>

    <details>
        <summary>Storage & Mounts</summary>
        <div class="preformatted">
            @{
                try
                {
                    foreach (var d in System.IO.DriveInfo.GetDrives().Where(d => d.IsReady))
                    {
                        try
                        {
                            @($"{d.Name,-15} {d.DriveFormat,-6} Free: {d.AvailableFreeSpace / 1073741824,4}GB / {d.TotalSize / 1073741824,4}GB") @Html.Raw("\n")
                        }
                        catch
                        {
                            @($"{d.Name}: Access Denied\n")
                        }
                    }
                }
                catch (Exception ex)
                {
                    @($"Drive Error: {ex.Message}")
                }
            }
        </div>
    </details>

    <details>
        <summary>IP Addresses</summary>
        <div class="preformatted">
        @{
            try
            {
                var ips = new System.Collections.Generic.List<string>();
                foreach (var intf in System.Net.NetworkInformation.NetworkInterface.GetAllNetworkInterfaces())
                {
                    if (intf.OperationalStatus != System.Net.NetworkInformation.OperationalStatus.Up) continue;
                    foreach (var addr in intf.GetIPProperties().UnicastAddresses)
                    {
                        if (addr.Address.AddressFamily == System.Net.Sockets.AddressFamily.InterNetwork || addr.Address.AddressFamily == System.Net.Sockets.AddressFamily.InterNetworkV6)
                        {
                            string ip = addr.Address.ToString();
                            string prefix = "";
                            try { prefix = $"/{addr.PrefixLength}"; } catch { }
                            ips.Add($"{ip}{prefix}");
                        }
                    }
                }
                    // Sort: GUA -> Private(192.168) -> Private(Other) -> Bluetooth -> LinkLocal -> Multicast -> Loopback
                var sortedIps = ips.OrderBy(ip =>
                {
                    // 1. Loopback & Bluetooth (Push to end)
                    if (ip.StartsWith("192.168.56.")) return 50; // Bluetooth/Host-only
                    if (ip.StartsWith("127.") || ip == "::1") return 100; // Loopback

                    try
                        {
                        var addr = System.Net.IPAddress.Parse(ip.Split('/')[0]);
                        var bytes = addr.GetAddressBytes();

                        // IPv6 Logic
                        if (addr.AddressFamily == System.Net.Sockets.AddressFamily.InterNetworkV6)
                        {
                            if (bytes[0] >= 0x20 && bytes[0] <= 0x3F) return 0; // GUA
                            if (bytes[0] == 0xFC || bytes[0] == 0xFD) return 2; // ULA (Private Other)
                            if (bytes[0] == 0xFE && (bytes[1] & 0xC0) == 0x80) return 40; // Link-Local
                            if (bytes[0] == 0xFF) return 60; // Multicast
                            return 5; // Other
                         }

                            // IPv4 Logic
                         if (bytes[0] == 192 && bytes[1] == 168) return 1; // Private Preferred (Home LAN)

                         if (bytes[0] == 10) return 2;                    // Private Other
                         if (bytes[0] == 172 && bytes[1] >= 16 && bytes[1] <= 31) return 2; // Private Other

                         if (bytes[0] == 169 && bytes[1] == 254) return 40; // Link-Local
                         if (bytes[0] >= 224 && bytes[0] <= 239) return 60; // Multicast

                         return 0; // GUA / Public
                 }
                catch { return 99; }
                }).ThenBy(ip => ip).ToList(); // Secondary sort by string for logical ordering within groups
                foreach (var i in sortedIps)
                {
                    try
                    {
                        @($"{i}") @Html.Raw("\n")
                    }
                    catch
                    {
                            
                    }
                }
            }
            catch (Exception E) { }
        }
        </div>
    </details>
    <br />
    <br />
    <div>
        Loading this page triggers a manual garbage collection at the end.
    </div>
    </body>
</html>
@{
    GC.Collect(2, GCCollectionMode.Aggressive, blocking: true, compacting: true);
    GC.WaitForPendingFinalizers();
}