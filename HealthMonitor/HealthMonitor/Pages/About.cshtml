@page "/About"



<html>
<head>
    <style>
        body {
        background-color: #1e1e1e;
        color: #e0e0e0;
        font-family: 'Courier New', Courier, monospace;
        margin: 0;
        padding: 20px;
        }

        h1 {
        color: #ffcc00;
        }

        .chart-container {
        background-color: #252526;
        border: 1px solid #3e3e42;
        padding: 10px;
        margin-bottom: 20px;
        border-radius: 5px;
        }

        /* Updated controls layout */
        .controls {
        margin-bottom: 20px;
        padding: 15px;
        background-color: #333;
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
        align-items: center;
        border-radius: 5px;
        }

        label {
        margin-right: 5px;
        }

        input, button {
        background-color: #3c3c3c;
        color: white;
        border: 1px solid #555;
        padding: 5px;
        border-radius: 3px;
        }

        /* Specific style for text inputs to be wider */
        input[type="text"] {
        width: 200px;
        }

        button {
        cursor: pointer;
        }

        button:hover {
        background-color: #505050;
        }

        svg {
        background-color: black;
        width: 100%;
        height: 450px;
        }
        /* Slightly taller */
        .axis-label {
        fill: white;
        font-size: 12px;
        }

        .legend {
        font-size: 12px;
        }

        .line {
        fill: none;
        stroke-width: 2px;
        }

        .grid line {
        stroke: #444;
        stroke-opacity: 0.7;
        shape-rendering: crispEdges;
        }

        .grid path {
        stroke-width: 0;
        }
        #notes:hover {
        filter: brightness(150%);
        }
        .preformatted {
        white-space: pre;
        margin-bottom: 1em;
        }
        .preformatted:hover {
        filter: brightness(150%);
        }
        .currentenv {
        font-size: 50%;
        }
    </style>
    <script>
        async function checkAuth() {
        try {
        const resp = await fetch('/api/auth/status');
        const data = await resp.json();
        const bar = document.getElementById('authStatus');
        const daysInput = document.getElementById('daysInput');

        if (data.authenticated) {
        bar.innerHTML = `<span style="color: #4caf50;">✔ Authenticated: ${data.user}</span>`;

        // --- SET UI LIMIT FOR AUTHENTICATED USERS ---
        if (daysInput) {
        daysInput.max = 365; // Allow full range
        daysInput.title = "Authenticated: Up to 365 days allowed.";
        }
        // --------------------------------------------
        } else {
        // --- SET UI LIMIT FOR ANONYMOUS USERS ---
        if (daysInput) {
        daysInput.max = 7; // Restrict to 7
        daysInput.title = "Anonymous: Up to 7 days allowed. Login for more.";

        // Reset value if current value is too high
        if (parseInt(daysInput.value) > 7) {
        daysInput.value = 7;
        }
        }
        // ----------------------------------------

        if ("@Config.AuthMode" === "None") {
        bar.innerHTML = `<span style="color: #888;">Auth Disabled</span>`;
        } else {
        bar.innerHTML = `<span style="color: #ffcc00;">⚠ Anonymous</span> | <a href="/Auth" style="color: #add8e6;">Login</a>`;
        }
        }
        } catch (e) {
        console.error("Auth check failed", e);
        }
        }
        checkAuth();
    </script>
</head>
<body>
    <div id="authBar" style="background-color: #333; padding: 5px 20px; display: flex; justify-content: space-between; border-bottom: 1px solid #555;">
        <span id="authStatus">Checking auth...</span>
    </div>
    <!-- Add this Navigation Bar -->
    <div class="nav-bar" style="background-color: #333; padding: 10px; margin-bottom: 20px; border-radius: 5px;">
        <span>
            @Environment.MachineName 🖥 &emsp; @TimeSpan.FromMilliseconds(Environment.TickCount64).ToString(@"dd\.hh\:mm\:ss") ⏲ &emsp;
            @((new System.IO.DriveInfo(System.IO.Directory.GetDirectoryRoot(System.AppContext.BaseDirectory)).AvailableFreeSpace / 1e9).ToString("F2")) GB (free) 💽
        </span>
        <br />
        <a href="/Index" style="color: #add8e6; text-decoration: none; margin-right: 15px; font-weight: bold;">Ping Monitor ⏱</a>
        <a href="/ProcessStats" style="color: #add8e6; text-decoration: none; margin-right: 15px; font-weight: bold;">Process Stats 📊</a>

        <a href="/Certs" style="color: #add8e6; text-decoration: none; margin-right: 15px; font-weight: bold;">Certificates 🔐</a>
