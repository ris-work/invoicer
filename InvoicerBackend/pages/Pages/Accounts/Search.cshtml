@page "/Pages/Accounts/Search"
@functions {
    }
<!DOCTYPE html>
<html>
<head><title>Search Accounts</title><style>body{font-family:sans-serif;padding:20px;} .card{border:1px solid #ccc; padding:10px; margin-bottom:10px;}</style></head>
<body>
    <h2>Search Accounts</h2>
    <input type="text" id="query" placeholder="Account Name..." oninput="search()">
    <div id="results"></div>
    <a href="/Pages/Accounts/Add">Add New</a> | <a href="/Pages/Flows/BeginFlowLinkAccount">Link Account to PII</a>

    <script>
        function getCookie(n) { const v = `; ${document.cookie}`; const p = v.split(`; ${n}=`); return p.length === 2 ? p.pop().split(';').shift() : null; }
        async function search() {
            const token = getCookie("auth-token");
            const q = document.getElementById('query').value;
            const res = await fetch('/SearchAccountsWeb', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ Query: q })
            });
            const data = await res.json();
            document.getElementById('results').innerHTML = data.map(a => `
                <div class="card">
                    <strong>${a.accountName}</strong> (ID: ${a.accountNo})<br>
                    <small>PII ID: ${a.accountPii || 'None'}</small>
                    <br><a href="/Pages/Accounts/Edit?id=${a.accountNo}">Edit</a>
                </div>
            `).join('');
        }
    </script>
</body>
</html>