@page "/Pages/Accounts/Search"
@functions { }
<!DOCTYPE html>
<html>
<head>
    <title>Search Accounts</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
</head>
<body>
    <h2>Search Accounts</h2>
    <div id="permWarning" class="perm-warning" style="display:none;"></div>

    <input type="text" id="query" placeholder="Account Name..." oninput="search()">
    <div id="results"></div>

    <div style="margin-top: 20px;">
        <a href="/Pages/Accounts/Add" class="btn btn-primary">Add New</a>
        <a href="/Pages/Flows/BeginFlowLinkAccount" class="btn btn-secondary">Link Account to PII</a>
    </div>

    <script src="/Pages/static/u.js"></script>
    <script>
        const requiredEndpoints = ["SearchAccountsWeb"];

        async function search() {
            const token = await getCookie("auth-token");
            const q = document.getElementById('query').value;
            const res = await fetch('/SearchAccountsWeb', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ Query: q })
            });
            const data = await res.json();
            document.getElementById('results').innerHTML = data.map(a => s`
                <div class="card">
                    <strong>${a.accountName}</strong> (ID: ${a.accountNo})<br>
                    <small>PII ID: ${a.accountPii || 'None'}</small>
                    <br><a href="/Pages/Accounts/Edit?id=${a.accountNo}">Edit</a>
                </div>
            `).join('');
        }

        checkPagePermissions(requiredEndpoints);
        search();
    </script>
</body>
</html>