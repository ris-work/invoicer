@page "/Pages/Accounts/LiveViewFuture"
@functions { }
<!DOCTYPE html>
<html>
<head>
    <title>Scheduled Entries Overview</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
</head>
<body>
    <h2>Scheduled Entries (Past & Future)</h2>
    <div id="permWarning" class="perm-warning" style="display:none;"></div>
    <p><small>Auto-refreshes every 60 seconds.</small></p>

    <div id="status">Loading...</div>
    <div id="gridContainer"></div>

    <script src="/Pages/static/u.js"></script>
    <script>
        const requiredEndpoints = ["GetFutureJournalOverview"];

        function getStatusIcon(status) {
            if(status === "Overdue") return "⚠️"; if(status === "Due Today") return "🔥";
            if(status === "Scheduled") return "📅"; return "";
        }

        async function loadData() {
            const token = await getCookie("auth-token");
            const container = document.getElementById('gridContainer');
            const statusDiv = document.getElementById('status');

            try {
                const res = await fetch('/GetFutureJournalOverview', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({})
                });

                if (!res.ok) throw new Error(await res.text());
                const data = await res.json();
                statusDiv.style.display = 'none';

                if (data.length === 0) { container.innerHTML = "<p>No pending entries found.</p>"; return; }

                let html = `<table><thead><tr><th>Status</th><th>Date</th><th>Type</th><th>Amount</th><th>Debit</th><th>Credit</th><th>Description</th></tr></thead><tbody>`;
                data.forEach(e => {
                    const rowClass = e.status.toLowerCase().replace(' ', '-');
                    const icon = getStatusIcon(e.status);
                    html += s`<tr class="${rowClass}">
                        <td>${icon} ${e.status}</td><td>${new Date(e.date).toLocaleDateString()}</td>
                        <td>${e.source}</td><td>${e.amount.toFixed(2)}</td>
                        <td>${e.debitAccountName}</td><td>${e.creditAccountName}</td>
                        <td>${e.description || ''}</td>
                    </tr>`;
                });
                html += `</tbody></table>`;
                container.innerHTML = html;
            } catch (err) {
                statusDiv.innerText = "Error: " + err.message;
                statusDiv.style.color = "red";
            }
        }

        checkPagePermissions(requiredEndpoints);
        loadData();
        setInterval(loadData, 60000);
    </script>
</body>
</html>