@page "/Pages/Accounts/LiveViewFutureAccounts"
@functions { }
<!DOCTYPE html>
<html>
<head>
    <title>Account Timeline</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
</head>
<body>
    <div id="status">Loading Flow...</div>
    <div id="permWarning" class="perm-warning" style="display:none;"></div>

    <div id="content" style="display:none;">
        <div class="header" style="margin-bottom: 20px; border-bottom: 1px solid #eee; padding-bottom: 10px;">
            <h2>Timeline: <span id="accName"></span></h2>
            <p><small>Account No: <span id="accNo"></span></small></p>
        </div>
        <div id="gridContainer">Loading data...</div>
    </div>

    <script src="/Pages/static/u.js"></script>
    <script>
        const params = new URLSearchParams(window.location.search);
        const flowId = params.get('flowId');
        const requiredEndpoints = ["GetFlowData", "GetAccountFuture"];

        function getStatusIcon(status) {
            if(status === "Overdue") return "⚠️"; if(status === "Due Today") return "🔥";
            if(status === "Scheduled") return "📅"; if(status === "Posted") return "✅"; return "";
        }

        async function init() {
            const token = await getCookie("auth-token");
            const loadKey = async (key) => {
                const res = await fetch('/GetFlowData', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ FlowId: flowId, Key: key })
                });
                return (await res.json()).value;
            };

            const accNo = await loadKey("selectedAccountNo");
            const accName = await loadKey("selectedAccountName");

            if (!accNo) { document.getElementById('status').innerText = "Flow Broken: No Account selected."; return; }

            document.getElementById('accName').innerText = accName;
            document.getElementById('accNo').innerText = accNo;
            document.getElementById('status').style.display = 'none';
            document.getElementById('content').style.display = 'block';

            await loadData(accNo, token);
        }

        async function loadData(accNo, token) {
            const container = document.getElementById('gridContainer');
            try {
                const res = await fetch('/GetAccountFuture', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ AccountNo: parseInt(accNo) })
                });

                if (!res.ok) throw new Error(await res.text());
                const data = await res.json();
                if (data.length === 0) { container.innerHTML = "<p>No entries found.</p>"; return; }

                let html = `<table><thead><tr><th>Status</th><th>Date</th><th>Type</th><th>Amount</th><th>Debit</th><th>Credit</th><th>Description</th></tr></thead><tbody>`;
                data.forEach(e => {
                    const rowClass = e.status.toLowerCase().replace(' ', '-');
                    const icon = getStatusIcon(e.status);
                    html += s`<tr class="${rowClass}">
                        <td>${icon} ${e.status}</td><td>${new Date(e.date).toLocaleString()}</td>
                        <td>${e.source}</td><td>${e.amount.toFixed(2)}</td>
                        <td>${e.debitAccountName}</td><td>${e.creditAccountName}</td>
                        <td>${e.description || ''}</td>
                    </tr>`;
                });
                html += `</tbody></table>`;
                container.innerHTML = html;
            } catch (err) { container.innerHTML = s`<p style="color:red;">Error: ${err.message}</p>`; }
        }

        checkPagePermissions(requiredEndpoints);
        init();
        setInterval(async () => {
             const token = await getCookie("auth-token");
             const accNo = document.getElementById('accNo').innerText;
             if(accNo) loadData(accNo, token);
        }, 60000);
    </script>
</body>
</html>