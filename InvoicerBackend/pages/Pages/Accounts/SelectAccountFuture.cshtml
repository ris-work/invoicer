@page "/Pages/Accounts/SelectAccountFuture"
@functions { }
<!DOCTYPE html>
<html>
<head>
    <title>Select Account</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
</head>
<body>
    <h2>Select Account to View Future</h2>
    <div id="permWarning" class="perm-warning" style="display:none;"></div>

    <input type="text" id="query" placeholder="Search Account..." oninput="search()">
    <div id="results"></div>

    <script src="/Pages/static/u.js"></script>
    <script>
        const params = new URLSearchParams(window.location.search);
        const flowId = params.get('flowId');
        const requiredEndpoints = ["SearchAccountsWeb", "SetFlowData"];

        async function search() {
            const token = await getCookie("auth-token");
            const q = document.getElementById('query').value;
            const res = await fetch('/SearchAccountsWeb', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ Query: q })
            });
            const data = await res.json();
            document.getElementById('results').innerHTML = data.map(a => s`
                <div class="card" onclick="select(${a.accountNo}, '${a.accountName.replace(/'/g, "\\'")}')">
                    <strong>${a.accountName}</strong> (${a.accountNo})
                </div>
            `).join('');
        }

        async function select(id, name) {
            const token = await getCookie("auth-token");
            await fetch('/SetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "selectedAccountNo", Value: id.toString() })
            });
            await fetch('/SetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "selectedAccountName", Value: name })
            });
            window.location.href = '/Pages/Accounts/LiveViewFutureAccounts?flowId=' + flowId;
        }

        checkPagePermissions(requiredEndpoints);
    </script>
</body>
</html>