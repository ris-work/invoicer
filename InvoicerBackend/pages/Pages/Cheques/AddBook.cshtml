@page "/Pages/Cheques/AddBook"
@functions { }
<!DOCTYPE html>
<html>
<head>
    <title>Add Cheque Book</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
</head>
<body>
    <div class="container">
        <h2>Add Cheque Book</h2>
        <div id="permWarning" class="perm-warning" style="display:none;"></div>

        <div class="form-group">
            <label>Bank Account</label>
            <input type="text" id="accSearch" placeholder="Type to search..." oninput="searchAccs()">
            <input type="hidden" id="selectedAccId">
            <div id="accResults" class="search-results" style="display:none;"></div>
            <div id="selectedAccDisplay" style="margin-top:5px; font-weight:bold;"></div>
        </div>

        <div class="form-group"><label>Start Number</label><input type="number" id="startNo" oninput="calcCount()"></div>
        <div class="form-group"><label>End Number</label><input type="number" id="endNo" oninput="calcCount()"></div>
        <div id="countInfo" style="margin-bottom: 15px;"></div>
        <button class="btn btn-primary" onclick="createBook()">Create Book</button>
    </div>

    <script src="/Pages/static/u.js"></script>
    <script>
        const requiredEndpoints = ["SearchAccountsWeb", "CreateChequeBook"];

        async function searchAccs() {
            const token = await getCookie("auth-token");
            const q = document.getElementById('accSearch').value;
            const resDiv = document.getElementById('accResults');
            if(q.length < 1) { resDiv.style.display = 'none'; return; }

            const res = await fetch('/SearchAccountsWeb', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ Query: q })
            });
            const data = await res.json();
            const banks = data.filter(a => a.isBank);

            if(banks.length > 0) {
                resDiv.style.display = 'block';
                resDiv.innerHTML = banks.map(a => s`
                    <div class="search-item" onclick="selectAcc(${a.accountNo}, '${a.accountName.replace(/'/g, "\\'")}')">
                        ${a.accountName} (${a.accountNo})
                    </div>
                `).join('');
            } else {
                resDiv.innerHTML = '<div class="search-item">No banks found</div>';
                resDiv.style.display = 'block';
            }
        }

        function selectAcc(id, name) {
            document.getElementById('selectedAccId').value = id;
            document.getElementById('accSearch').value = "";
            document.getElementById('accResults').style.display = 'none';
            document.getElementById('selectedAccDisplay').innerText = `Selected: ${name} (ID: ${id})`;
        }

        function calcCount() {
            const s = parseInt(document.getElementById('startNo').value);
            const e = parseInt(document.getElementById('endNo').value);
            const div = document.getElementById('countInfo');
            if (s && e && e >= s) {
                const count = e - s + 1;
                let msg = s`<strong>Total Leaves:</strong> ${count}`;
                if (count > 200) msg += s`<br><div class="warning">⚠️ Warning: Book is large (>200).</div>`;
                div.innerHTML = msg;
            } else { div.innerHTML = ""; }
        }

        async function createBook() {
            const token = await getCookie("auth-token");
            const payload = {
                AccountId: parseInt(document.getElementById('selectedAccId').value),
                StartNumber: parseInt(document.getElementById('startNo').value),
                EndNumber: parseInt(document.getElementById('endNo').value)
            };

            if (!payload.AccountId || !payload.StartNumber || !payload.EndNumber) { alert("Fill all fields."); return; }

            try {
                const res = await fetch('/CreateChequeBook', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (res.ok) { alert("Success!"); location.reload(); }
                else alert("Error: " + await res.text());
            } catch(err) { alert(err.message); }
        }

        checkPagePermissions(requiredEndpoints);
    </script>
</body>
</html>