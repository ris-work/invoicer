@page "/Pages/Batches/Split"
@functions { }
<!DOCTYPE html>
<html>
<head>
    <title>Split Batch</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
</head>
<body>
    <h2>Split Batch</h2>
    <div id="permWarning" class="perm-warning" style="display:none;"></div>
    <div id="info" class="card">Loading batch info...</div>
    <div id="form" style="display:none;">
        <p>Enter the quantity to <strong>keep in the original batch</strong>.</p>
        <div class="form-group"><label>Quantity to Keep</label><input type="number" id="qtyKeep" placeholder="e.g. 10"></div>
        <p>Result:</p>
        <ul>
            <li>Original Batch: <span id="origBatchId">-</span> will have <span id="origQty">-</span> units.</li>
            <li>New Batch: will have <span id="newQty">-</span> units.</li>
        </ul>
        <button class="btn btn-warning" onclick="executeSplit()">Confirm Split</button>
    </div>

    <script src="/Pages/static/u.js"></script>
    <script>
        const params = new URLSearchParams(window.location.search);
        const flowId = params.get('flowId');
        const itemCode = params.get('itemCode');
        const batchCode = params.get('batchCode');
        let currentUnits = 0;
        const requiredEndpoints = ["GetBatchWeb", "SplitBatchWeb"];

        async function init() {
            const token = await getCookie("auth-token");
            const res = await fetch('/GetBatchWeb', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ ItemCode: parseInt(itemCode), BatchCode: parseInt(batchCode) })
            });
            const batch = await res.json();
            currentUnits = batch.units;
            document.getElementById('info').innerText = `Item: ${batch.itemcode} | Batch: ${batch.batchcode} | Total: ${currentUnits}`;
            document.getElementById('origBatchId').innerText = batch.batchcode;
            document.getElementById('form').style.display = 'block';
        }

        document.getElementById('qtyKeep').addEventListener('input', function() {
            const keep = parseFloat(this.value) || 0;
            document.getElementById('origQty').innerText = keep;
            document.getElementById('newQty').innerText = Math.max(0, currentUnits - keep);
        });

        async function executeSplit() {
            const token = await getCookie("auth-token");
            const keep = parseFloat(document.getElementById('qtyKeep').value);
            if (keep <= 0 || keep >= currentUnits) { alert("Invalid quantity."); return; }
            const res = await fetch('/SplitBatchWeb', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ ItemCode: parseInt(itemCode), BatchCode: parseInt(batchCode), NewQuantityForOriginal: keep })
            });
            if (res.ok) {
                const result = await res.json();
                alert(`Success! New Batch #${result.newBatchCode} created.`);
                window.location.href = '/Pages/Batches/Edit?flowId=' + flowId;
            } else alert("Split failed.");
        }

        checkPagePermissions(requiredEndpoints);
        init();
    </script>
</body>
</html>