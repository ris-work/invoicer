@page "/Pages/Batches/Adjust"
@functions { }
<!DOCTYPE html>
<html>
<head>
    <title>Adjust Batch Inventory</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
</head>
<body>
    <h2>Adjust Batch Inventory</h2>
    <div id="permWarning" class="perm-warning" style="display:none;"></div>
    <div class="warning"><strong>Warning:</strong> Adjustments affect stock levels, Bin Cards, and Accounting.</div>

    <div id="info" class="card">Loading batch info...</div>
    <div id="form" style="display:none;">
        <div class="form-group"><label>Document Number (User Generated)</label><input type="text" id="docNumber" placeholder="e.g. ADJ-001"></div>
        <div class="form-group"><label>Current Quantity (System)</label><input type="number" id="currentQty" readonly></div>
        <div class="row">
            <div class="form-group"><label>New Quantity (Count)</label><input type="number" id="newQty" placeholder="Enter physical count"></div>
            <div class="form-group"><label>Difference (+/-)</label><input type="number" id="difference" placeholder="e.g. -3"></div>
        </div>
        <div class="form-group"><label>Reason</label><textarea id="reason" rows="3"></textarea></div>
        <div style="margin-top: 20px;">
            <button class="btn btn-danger" onclick="executeAdjust()">Post Immediately</button>
            <button class="btn btn-secondary" onclick="saveUnposted()">Save Unposted</button>
        </div>
    </div>

    <script src="/Pages/static/u.js"></script>
    <script>
        const params = new URLSearchParams(window.location.search);
        const flowId = params.get('flowId');
        const itemCode = params.get('itemCode');
        const batchCode = params.get('batchCode');
        let currentQty = 0;
        const requiredEndpoints = ["GetBatchWeb", "AdjustmentAddToBatch", "CreateUnpostedAdjustment"];

        async function init() {
            const token = await getCookie("auth-token");
            const res = await fetch('/GetBatchWeb', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ ItemCode: parseInt(itemCode), BatchCode: parseInt(batchCode) })
            });
            const batch = await res.json();
            currentQty = batch.units;
            document.getElementById('info').innerText = `Item: ${batch.itemcode} | Batch: ${batch.batchcode} | Cost: ${batch.costPrice}`;
            document.getElementById('currentQty').value = currentQty;
            document.getElementById('form').style.display = 'block';
        }

        document.getElementById('newQty').addEventListener('input', function(e) {
            const val = parseFloat(e.target.value) || 0;
            document.getElementById('difference').value = (val - currentQty).toFixed(2);
        });
        document.getElementById('difference').addEventListener('input', function(e) {
            const diff = parseFloat(e.target.value) || 0;
            document.getElementById('newQty').value = (currentQty + diff).toFixed(2);
        });

        async function executeAdjust() {
            const token = await getCookie("auth-token");
            const diff = parseFloat(document.getElementById('difference').value);
            const reason = document.getElementById('reason').value;
            const docNum = document.getElementById('docNumber').value;
            if (!docNum || !reason || isNaN(diff) || diff === 0) { alert("Fill all fields correctly."); return; }
            if (!confirm(`Confirm POST adjustment of ${diff} units?`)) return;

            const res = await fetch('/AdjustmentAddToBatch', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ ItemCode: parseInt(itemCode), BatchCode: parseInt(batchCode), Difference: diff, Reason: reason, DocumentNumber: docNum })
            });
            if (res.ok) { alert("Success!"); window.location.href = '/Pages/Batches/Edit?flowId=' + flowId; }
            else alert("Failed: " + await res.text());
        }

        async function saveUnposted() {
            const token = await getCookie("auth-token");
            const diff = parseFloat(document.getElementById('difference').value);
            const reason = document.getElementById('reason').value;
            const docNum = document.getElementById('docNumber').value;
            if (!docNum || !reason || isNaN(diff) || diff === 0) { alert("Fill all fields correctly."); return; }
            if (!confirm(`Save UNPOSTED adjustment?`)) return;

            const res = await fetch('/CreateUnpostedAdjustment', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ ItemCode: parseInt(itemCode), BatchCode: parseInt(batchCode), Difference: diff, Reason: reason, DocumentNumber: docNum })
            });
            if (res.ok) { alert("Saved Unposted."); window.location.href = '/Pages/Batches/Edit?flowId=' + flowId; }
            else alert("Failed: " + await res.text());
        }

        checkPagePermissions(requiredEndpoints);
        init();
    </script>
</body>
</html>