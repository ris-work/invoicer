@page "/Pages/Docs/Search"
@functions { }
<!DOCTYPE html>
<html>
<head>
    <title>Search Documents</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
</head>
<body>
    <h1>Search Documents</h1>
    <div id="permWarning" class="perm-warning" style="display:none;"></div>

    <div class="form-group"><label>Query</label><input type="text" id="searchQuery"></div>
    <div class="form-group"><label>From</label><input type="date" id="dateFrom"></div>
    <div class="form-group"><label>To</label><input type="date" id="dateTo"></div>
    <div class="form-group"><label><input type="checkbox" id="exactMatch"> Exact Match</label></div>

    <button class="btn btn-primary" id="btnSearch">Search</button>
    <div id="results" style="margin-top: 20px;"></div>

    <div style="margin-top: 20px;"><a href="/Pages/Docs/Index">Back</a> | <a href="/Pages/Docs/Add">Add New</a></div>

    <script src="/Pages/static/u.js"></script>
    <script>
        const requiredEndpoints = ["SearchDocuments", "SuggestDocuments"];
        
        document.getElementById('btnSearch').addEventListener('click', async function() {
            const token = await getCookie("auth-token");
            const resultsDiv = document.getElementById('results');
            const query = document.getElementById('searchQuery').value;
            const fromVal = document.getElementById('dateFrom').value;
            const toVal = document.getElementById('dateTo').value;
            const isExact = document.getElementById('exactMatch').checked;

            if (!query && !fromVal && !toVal) { alert("Input required."); return; }
            resultsDiv.innerHTML = "Searching...";

            const payload = {
                Query: query,
                From: fromVal ? new Date(fromVal).toISOString() : null,
                To: toVal ? new Date(toVal).toISOString() : null
            };

            const endpoint = isExact ? '/SearchDocuments' : '/SuggestDocuments';

            try {
                const res = await fetch(endpoint, {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (!res.ok) throw new Error("Failed");
                const docs = await res.json();

                if (docs.length === 0) { resultsDiv.innerHTML = "<p>No results.</p>"; return; }

                let html = `<h3>${docs.length} Result(s)</h3>`;
                docs.forEach(doc => {
                    html += s`
                        <div class="doc-card">
                            <div class="doc-title"><a href="/Pages/Docs/Index?id=${doc.refId}">${doc.refText || 'Untitled'}</a></div>
                            <div>ID: ${doc.refId} | Created: ${new Date(doc.createdAt).toLocaleString()}</div>
                        </div>`;
                });
                resultsDiv.innerHTML = html;
            } catch (err) { resultsDiv.innerHTML = s`<p style="color:red;">Error: ${err.message}</p>`; }
        });

        checkPagePermissions(requiredEndpoints);
    </script>
</body>
</html>