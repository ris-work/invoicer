@page "/Pages/Pii/Search"
@functions { }
<!DOCTYPE html>
<html>
<head>
    <title>Search PII</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
</head>
<body>
    <div class="container">
        <h2>Search PII</h2>
        <div id="permWarning" class="perm-warning" style="display:none;"></div>

        <div class="form-group">
            <input type="text" id="query" placeholder="Name or Email..." oninput="search()">
        </div>
        <div id="results"></div>
        <div style="margin-top:20px;"><a href="/Pages/Pii/Add" class="btn btn-primary">Add New PII</a></div>
    </div>

    <script src="/Pages/static/u.js"></script>
    <script>
        const requiredEndpoints = ["SearchPiiWeb"];

        async function init() {
            await checkPagePermissions(requiredEndpoints);
        }

        async function search() {
            const token = await getCookie("auth-token");
            const q = document.getElementById('query').value;
            if(!q) return;
            const res = await fetch('/SearchPiiWeb', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ Query: q })
            });
            const data = await res.json();
            document.getElementById('results').innerHTML = data.map(p => s`
                <div class="card">
                    <strong>${p.name}</strong> (${p.isCompany ? 'Company' : 'Individual'})<br>
                    <small>${p.email || 'No Email'}</small>
                    <br><a href="/Pages/Pii/Edit?id=${p.id}">Edit</a>
                </div>
            `).join('');
        }

        init();
    </script>
</body>
</html>