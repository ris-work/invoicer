@page "/Pages/Adjustments/Index"

@functions {
}

<!DOCTYPE html>
<html>
<head>
    <title>Inventory Adjustments</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            font-family: sans-serif;
            padding: 20px;
        }

        .card {
            border: 1px solid #ddd;
            padding: 15px;
            margin-bottom: 10px;
            border-radius: 5px;
        }

        .card-header {
            font-weight: bold;
            margin-bottom: 5px;
        }

        .unposted {
            border-left: 5px solid #ffc107;
            background: #fffcf0;
        }

        .posted {
            border-left: 5px solid #28a745;
            background: #f0fff0;
        }

        .filter-bar {
            margin-bottom: 20px;
            padding: 10px;
            background: #eee;
            border-radius: 5px;
        }

        button {
            padding: 5px 10px;
            cursor: pointer;
        }

        .btn-post {
            background: #28a745;
            color: white;
            border: none;
        }
    </style>
</head>
<body>
    <h2>Inventory Adjustments</h2>

    <div class="filter-bar">
        <label><strong>Filter:</strong></label>
        <select id="filterStatus" onchange="loadAdjustments()">
            <option value="false">Unposted Only</option>
            <option value="true">Posted Only</option>
            <option value="all">All</option>
        </select>
    </div>

    <div id="list">Loading...</div>

    <script>
        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
        }

        async function loadAdjustments() {
            const token = getCookie("auth-token");
            const filter = document.getElementById('filterStatus').value;
            const listDiv = document.getElementById('list');

            let postedParam = null;
            if (filter === "true") postedParam = true;
            if (filter === "false") postedParam = false;

            const res = await fetch('/GetInventoryAdjustments', {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ Posted: postedParam })
            });

            if (!res.ok) { listDiv.innerText = "Error loading data"; return; }

            const items = await res.json();

            if (items.length === 0) {
                listDiv.innerHTML = "<p>No adjustments found.</p>";
                return;
            }

            listDiv.innerHTML = items.map(a => {
                const date = new Date(a.createdAt).toLocaleString();
                const statusClass = a.posted ? 'posted' : 'unposted';
                const statusText = a.posted ? 'Posted' : 'Unposted';

                let actionBtn = '';
                if (!a.posted) {
                    actionBtn = `<button class="btn-post" onclick="postAdjustment(${a.entryId})">Approve & Post</button>`;
                }

                return `
                    <div class="card ${statusClass}">
                        <div class="card-header">
                            Doc: ${a.referenceCode}
                            <span style="float:right; font-size:0.8em; font-weight:normal;">${statusText}</span>
                        </div>
                        <div>
                            Item: ${a.itemcode} | Batch: ${a.batchcode}<br>
                            Change: ${a.count} (From ${a.beforeQty} to ${a.afterQty})<br>
                            Reason: ${a.reason}<br>
                            <small>Created: ${date} by User #${a.createdBy}</small>
                        </div>
                        <div style="margin-top:10px;">
                            ${actionBtn}
                        </div>
                    </div>
                `;
            }).join('');
        }

        async function postAdjustment(entryId) {
            if (!confirm("Are you sure you want to POST this adjustment? This will affect inventory and accounting.")) return;

            const token = getCookie("auth-token");
            const res = await fetch('/PostAdjustment', {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ EntryId: entryId })
            });

            if (res.ok) {
                alert("Adjustment posted successfully!");
                loadAdjustments(); // Refresh list
            } else {
                const err = await res.text();
                alert("Failed to post: " + err);
            }
        }

        loadAdjustments();
    </script>
</body>
</html>