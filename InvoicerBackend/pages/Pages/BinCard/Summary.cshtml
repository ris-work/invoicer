@page "/Pages/BinCard/Summary"
@functions { }
<!DOCTYPE html>
<html>
<head>
    <title>Bin Card Summary</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
</head>
<body>
    <h2>Bin Card Summary</h2>
    <div id="permWarning" class="perm-warning" style="display:none;"></div>

    <div class="filter-bar">
        <div class="filter-row">
            <div class="filter-group"><label>Tag</label><select id="filterTagSelect" onchange="syncTagInput()"><option value="">All</option></select></div>
            <div class="filter-group"><label>Or Search</label><input list="tagList" id="filterTagInput"><datalist id="tagList"></datalist></div>
        </div>
        <div class="filter-row">
            <div class="filter-group"><label>Period</label><select id="periodType"><option value="monthly">Monthly</option><option value="daily">Daily</option></select></div>
            <div class="filter-group"><label>From</label><input type="date" id="filterFrom"></div>
            <div class="filter-group"><label>To</label><input type="date" id="filterTo"></div>
            <div class="filter-group" style="justify-content: flex-end;"><button class="btn btn-primary" onclick="loadData()">Generate</button></div>
        </div>
    </div>
    <div id="gridContainer" class="table-container"></div>

    <script src="/Pages/static/u.js"></script>
    <script>
        const requiredEndpoints = ["GetAllTags", "GetBinCardSummary"];
        const ACTION_ORDER = ["purchase", "production", "purchasereturn", "sale", "salesreturn", "consumption", "issue", "adjustment", "deprecated"];

        async function init() {
            const token = await getCookie("auth-token");
            const res = await fetch('/GetAllTags', { method: 'POST', headers: { 'Authorization': `Bearer ${token}` }, body: JSON.stringify({}) });
            const tags = await res.json();
            const select = document.getElementById('filterTagSelect');
            select.innerHTML = '<option value="">All</option>' + tags.map(t => s`<option value="${t.tag}">${t.tag}</option>`).join('');
            document.getElementById('tagList').innerHTML = tags.map(t => s`<option value="${t.tag}">`).join('');
            // Set default dates
            const now = new Date();
            document.getElementById('filterTo').value = now.toISOString().split('T')[0];
            now.setMonth(now.getMonth() - 3);
            document.getElementById('filterFrom').value = now.toISOString().split('T')[0];
        }
        function syncTagInput() { document.getElementById('filterTagInput').value = document.getElementById('filterTagSelect').value; }

        async function loadData() {
            const token = await getCookie("auth-token");
            const container = document.getElementById('gridContainer');
            const tagVal = document.getElementById('filterTagSelect').value || document.getElementById('filterTagInput').value;

            const payload = {
                PeriodType: document.getElementById('periodType').value,
                From: document.getElementById('filterFrom').value ? new Date(document.getElementById('filterFrom').value).toISOString() : null,
                To: document.getElementById('filterTo').value ? new Date(document.getElementById('filterTo').value).toISOString() : null,
                Tags: tagVal ? [tagVal] : null
            };
            container.innerHTML = "Aggregating...";
            try {
                const res = await fetch('/GetBinCardSummary', { method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
                if (!res.ok) throw new Error(await res.text());
                renderPivotTable(await res.json());
            } catch (err) { container.innerHTML = s`<p style="color:red;">Error: ${err.message}</p>`; }
        }

        function renderPivotTable(data) {
            const container = document.getElementById('gridContainer');
            const periods = data.periods;
            const actions = data.actions;
            if (periods.length === 0) { container.innerHTML = "<p>No data.</p>"; return; }

            const pivotMap = {};
            periods.forEach(p => {
                const key = `${p.itemcode}|${p.period}`;
                if (!pivotMap[key]) pivotMap[key] = { ItemCode: p.itemcode, ItemName: p.itemName, Period: p.period, Actions: {} };
                pivotMap[key].StartQty = p.startQty; pivotMap[key].EndQty = p.endQty;
            });
            actions.forEach(a => {
                const key = `${a.itemcode}|${a.period}`;
                if (!pivotMap[key]) pivotMap[key] = { ItemCode: a.itemcode, ItemName: a.itemName, Period: a.period, Actions: {} };
                if (!pivotMap[key].Actions[a.actionType]) pivotMap[key].Actions[a.actionType] = 0;
                pivotMap[key].Actions[a.actionType] += a.totalUnits;
            });

            let html = '<table><thead><tr><th>Item Code</th><th>Item Name</th><th>Period</th><th>Start</th>';
            ACTION_ORDER.forEach(act => html += s`<th>${act}</th>`);
            html += '<th>End</th></tr></thead><tbody>';

            Object.keys(pivotMap).sort().forEach(key => {
                const row = pivotMap[key];
                html += s`<tr>
                    <td class="item-code">${row.ItemCode}</td>
                    <td class="item-name">${row.ItemName || ''}</td>
                    <td class="period-col">${row.Period}</td>
                    <td class="start-qty">${row.StartQty.toFixed(2)}</td>`;
                ACTION_ORDER.forEach(act => { const val = row.Actions[act]; html += s`<td>${val ? val.toFixed(2) : ''}</td>`; });
                html += s`<td class="end-qty">${row.EndQty.toFixed(2)}</td></tr>`;
            });
            container.innerHTML = html + '</tbody></table>';
        }

        checkPagePermissions(requiredEndpoints);
        init();
    </script>
</body>
</html>