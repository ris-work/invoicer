@page "/Pages/Journal/EnterDetails"

@*
  FLOW: Add Journal Entry
  STEP: 5 (Terminal / Editor)
  SETS: N/A
  READS: selectedJournalNo, selectedDebitAccountNo, selectedDebitAccountName, selectedCreditAccountNo, selectedCreditAccountName
  REDIRECTS: /Pages/Accounts/LiveView
*@

@functions {
    }
<!DOCTYPE html>
<html>
<head>
    <title>Enter Journal Details</title>
    <style>
        body {
            font-family: sans-serif;
            padding: 20px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }

        input, textarea {
            width: 100%;
            padding: 8px;
            box-sizing: border-box;
        }

        button {
            padding: 10px 15px;
            cursor: pointer;
            background: #28a745;
            color: white;
            border: none;
        }

        .summary {
            background: #f8f9fa;
            padding: 15px;
            border: 1px solid #ddd;
            margin-bottom: 20px;
            border-radius: 5px;
        }

            .summary p {
                margin: 5px 0;
            }
    </style>
</head>
<body>
    <h2>Enter Journal Details</h2>
    <div id="status">Loading Flow...</div>

    <div id="form" style="display:none;">
        <div class="summary">
            <p><strong>Journal:</strong> <span id="dispJournal"></span></p>
            <hr>
            <p><strong>Debit Account:</strong> <span id="dispDebitName"></span> (ID: <span id="dispDebitNo"></span>)</p>
            <p><strong>Credit Account:</strong> <span id="dispCreditName"></span> (ID: <span id="dispCreditNo"></span>)</p>
        </div>

        <div class="form-group">
            <label>Amount</label>
            <input type="number" id="amount" step="0.01" placeholder="0.00">
        </div>
        <div class="form-group">
            <label>Description</label>
            <textarea id="description" rows="3"></textarea>
        </div>
        <div class="form-group">
            <label>Reference No (Optional)</label>
            <input type="text" id="refNo">
        </div>

        <button onclick="submit()">Submit Entry</button>
    </div>

    <script>
        const params = new URLSearchParams(window.location.search);
        const flowId = params.get('flowId');
        const journalNames = ["", "General", "Purchase", "Sales", "Cash Receipts", "Cash Payments", "Purchase Returns", "Sales Returns", "Adjusting", "Reversing", "Closing"];

        function getCookie(n) { const v = `; ${document.cookie}`; const p = v.split(`; ${n}=`); return p.length === 2 ? p.pop().split(';').shift() : null; }

        async function init() {
            const token = getCookie("auth-token");

            const loadKey = async (key) => {
                const res = await fetch('/GetFlowData', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ FlowId: flowId, Key: key })
                });
                return (await res.json()).value;
            };

            const jNo = await loadKey("selectedJournalNo");
            const dNo = await loadKey("selectedDebitAccountNo");
            const dName = await loadKey("selectedDebitAccountName");
            const cNo = await loadKey("selectedCreditAccountNo");
            const cName = await loadKey("selectedCreditAccountName");

            if (!jNo || !dNo || !cNo) {
                document.getElementById('status').innerText = "Flow Broken: Missing data.";
                return;
            }

            document.getElementById('dispJournal').innerText = `${journalNames[parseInt(jNo)]} (${jNo})`;

            document.getElementById('dispDebitName').innerText = dName || "N/A";
            document.getElementById('dispDebitNo').innerText = dNo;

            document.getElementById('dispCreditName').innerText = cName || "N/A";
            document.getElementById('dispCreditNo').innerText = cNo;

            document.getElementById('status').style.display = 'none';
            document.getElementById('form').style.display = 'block';
        }

        async function submit() {
            const token = getCookie("auth-token");
            const btn = document.querySelector("button");
            btn.disabled = true;
            btn.innerText = "Saving...";

            try {
                const payload = {
                    JournalNo: parseInt(document.getElementById('dispJournal').innerText.match(/\((\d+)\)/)[1]),
                    DebitAccountNo: parseInt(document.getElementById('dispDebitNo').innerText),
                    CreditAccountNo: parseInt(document.getElementById('dispCreditNo').innerText),
                    Amount: parseFloat(document.getElementById('amount').value),
                    Description: document.getElementById('description').value,
                    RefNo: document.getElementById('refNo').value
                };

                if (!payload.Amount || payload.Amount <= 0) throw new Error("Invalid Amount.");

                const res = await fetch('/AddJournalEntryWeb', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (!res.ok) throw new Error(await res.text());

                alert("Journal Entry Added!");
                window.location.href = '/Pages/Accounts/LiveView';

            } catch (err) {
                alert("Error: " + err.message);
                btn.disabled = false;
                btn.innerText = "Submit Entry";
            }
        }

        init();
    </script>
</body>
</html>