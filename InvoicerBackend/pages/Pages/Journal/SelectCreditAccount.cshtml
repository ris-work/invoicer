@page "/Pages/Journal/SelectCreditAccount"

@*
  FLOW: Generic Selector (Credit)
  SETS: selectedCreditAccountNo, selectedCreditAccountName
  READS: flowId, FlowSteps
*@

@functions {
    }
<!DOCTYPE html>
<html>
<head>
    <title>Select Credit Account</title>
    <style>
        body {
            font-family: sans-serif;
            padding: 20px;
        }

        input {
            width: 100%;
            padding: 8px;
            box-sizing: border-box;
        }

        .card {
            border: 1px solid #ccc;
            padding: 10px;
            margin-bottom: 5px;
            cursor: pointer;
        }

        .current-bar {
            background: #e3f2fd;
            padding: 10px;
            margin-bottom: 20px;
            border-radius: 5px;
            border: 1px solid #90caf9;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .current-bar button {
                padding: 5px 10px;
                cursor: pointer;
                background: #1976d2;
                color: white;
                border: none;
                border-radius: 3px;
            }
    </style>
</head>
<body>
    <h2>Select Credit Account</h2>

    <!-- Current Selection Bar -->
    <div id="currentBar" style="display:none;" class="current-bar">
        <div>
            <strong>Current:</strong> <span id="currentName"></span> (<span id="currentId"></span>)
        </div>
        <button onclick="proceedWithCurrent()">Proceed with Current</button>
    </div>

    <input type="text" id="query" placeholder="Search Account Name or No..." oninput="search()">
    <div id="results"></div>

    <script>
        const params = new URLSearchParams(window.location.search);
        const flowId = params.get('flowId');
        function getCookie(n) { const v = `; ${document.cookie}`; const p = v.split(`; ${n}=`); return p.length === 2 ? p.pop().split(';').shift() : null; }

        async function init() {
            const token = getCookie("auth-token");

            // Check if already set
            const resId = await fetch('/GetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "selectedCreditAccountNo" })
            });
            const dataId = await resId.json();

            if(dataId.value) {
                const resName = await fetch('/GetFlowData', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ FlowId: flowId, Key: "selectedCreditAccountName" })
                });
                const dataName = await resName.json();

                document.getElementById('currentId').innerText = dataId.value;
                document.getElementById('currentName').innerText = dataName.value || "Unknown";
                document.getElementById('currentBar').style.display = 'flex';
            }
        }

        async function search() {
            const token = getCookie("auth-token");
            const q = document.getElementById('query').value;
            const res = await fetch('/SearchAccountsWeb', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ Query: q })
            });
            const data = await res.json();
            document.getElementById('results').innerHTML = data.map(a => `
                <div class="card" onclick="select(${a.accountNo}, '${a.accountName.replace(/'/g, "\\'")}')">
                    <strong>${a.accountName}</strong> (ID: ${a.accountNo})
                </div>
            `).join('');
        }

        async function select(id, name) {
            const token = getCookie("auth-token");
            await fetch('/SetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "selectedCreditAccountNo", Value: id.toString() })
            });
            await fetch('/SetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "selectedCreditAccountName", Value: name })
            });

            const defaultNext = '/Pages/Journal/EnterDetails?flowId=' + flowId;
            await navigateNext(defaultNext);
        }

        async function proceedWithCurrent() {
            const defaultNext = '/Pages/Journal/EnterDetails?flowId=' + flowId;
            await navigateNext(defaultNext);
        }

        async function navigateNext(defaultUrl) {
            const token = getCookie("auth-token");
            const res = await fetch('/GetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "FlowSteps" })
            });
            const data = await res.json();

            if (data.value) {
                const steps = JSON.parse(data.value);
                let currentIndex = parseInt(await getCurrentStepIndex(token));

                currentIndex++;
                if (currentIndex < steps.length) {
                    await fetch('/SetFlowData', {
                        method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                        body: JSON.stringify({ FlowId: flowId, Key: "FlowStepIndex", Value: currentIndex.toString() })
                    });
                    window.location.href = steps[currentIndex] + "?flowId=" + flowId;
                    return;
                }
            }
            window.location.href = defaultUrl;
        }

        async function getCurrentStepIndex(token) {
            const res = await fetch('/GetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "FlowStepIndex" })
            });
            const data = await res.json();
            return data.value || "0";
        }

        init();
    </script>
</body>
</html>