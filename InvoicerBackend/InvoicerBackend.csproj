<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OutputType>Exe</OutputType>
    </PropertyGroup>
    <ItemGroup>
        <None Remove="connstring.toml" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="connstring.toml">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.2" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.2" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.2" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
        <PackageReference Include="RazorSlices" Version="0.9.5" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.1" />
    </ItemGroup>
    <ItemGroup>
        <None Update="InvoicerBackend.http">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="sample_to_transcribe.jpg">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>
	<PropertyGroup>
		<EnableDefaultRazorSlices>false</EnableDefaultRazorSlices>
	</PropertyGroup>
	<ItemGroup>
		<!-- Only treat .cshtml files in Slices directory as Razor Slices -->
		<RazorSlice Include="Slices\**\*.cshtml" />
	</ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Common\common.csproj" />
    </ItemGroup>
</Project>
