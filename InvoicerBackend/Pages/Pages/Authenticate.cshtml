@page "/Pages/Authenticate"

@functions {
    public string RedirectUrl { get; set; } = "/DumpAuth";

    public void OnGet()
    {
        var qsToken = Request.Query["token"].ToString();
        if (!string.IsNullOrEmpty(qsToken))
        {
            SetCookie(qsToken);
            // Redirect immediately after setting the cookie
            Response.Redirect(RedirectUrl);
        }
    }

    private void SetCookie(string tokenValue)
    {
        var options = new CookieOptions
            {
                // IMPORTANT: HttpOnly is FALSE (or omitted) so JS can read it!
                HttpOnly = false,
                Secure = false, // Set true if using HTTPS
                IsEssential = true,
                SameSite = SameSiteMode.Lax
            };

        Response.Cookies.Append("auth-token", tokenValue, options);
    }
}

<!DOCTYPE html>
<html>
<body>
    <h1>Authenticating...</h1>
    <p>If you are not redirected, <a href="/Pages/DumpAuth">click here</a>.</p>
</body>
</html>