@page "/Pages/Echo"

@functions {
}

<!DOCTYPE html>
<html>
<head>
    <title>Token Utilities</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body { font-family: sans-serif; padding: 20px; max-width: 800px; margin: 0 auto; }
        h1 { border-bottom: 1px solid #eee; padding-bottom: 10px; }

        .section { margin-bottom: 20px; padding: 15px; background: #f8f9fa; border-radius: 5px; }
        .section h3 { margin-top: 0; }

        .btn { padding: 8px 15px; border: none; border-radius: 4px; cursor: pointer; font-size: 0.95em; margin-right: 5px; }
        .btn-primary { background: #007bff; color: white; }
        .btn-secondary { background: #6c757d; color: white; }
        .btn-warning { background: #ffc107; color: #212529; }

        .result-box { margin-top: 10px; padding: 10px; border: 1px solid #e9ecef; background: #fff; border-radius: 4px; }

        /* JSON View */
        pre { background: #282c34; color: #abb2bf; padding: 10px; border-radius: 4px; overflow-x: auto; font-size: 0.9em; }

        /* Privilege Tags */
        .priv-list { display: flex; flex-wrap: wrap; gap: 5px; }
        .priv-tag { background: #e9ecef; padding: 4px 8px; border-radius: 3px; font-family: monospace; font-size: 0.9em; border: 1px solid #dee2e6; }
        .priv-tag.has-access { background: #d4edda; color: #155724; border-color: #c3e6cb; }

        .warning { color: #856404; background: #fff3cd; padding: 5px 10px; border-radius: 3px; font-size: 0.85em; margin-bottom: 10px; display: inline-block; }
    </style>
</head>
<body>
    <h1>Token Utilities</h1>

    <!-- Section 1: Check Privileges -->
    <div class="section">
        <h3>1. Check Privileges</h3>
        <p>Retrieves the string array of permitted actions for the current token.</p>
        <button onclick="checkPrivileges()" class="btn btn-primary">Get Privileges</button>
        <div id="privResult" class="result-box" style="display:none;"></div>
    </div>

    <!-- Section 2: Full Echo (Sensitive) -->
    <div class="section">
        <h3>2. Full Echo (Debug)</h3>
        <span class="warning">Sensitive Data</span>
        <p>Returns the full <code>LoginDetails</code> object (User ID, Request ID, etc.).</p>
        <button onclick="fullEcho()" class="btn btn-warning">Run Full Echo</button>
        <div id="echoResult" class="result-box" style="display:none;"></div>
    </div>

    <script src="/Pages/static/u.js"></script>
    <script>
        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
        }

        async function checkPrivileges() {
            const token = getCookie("auth-token");
            const div = document.getElementById('privResult');
            div.style.display = 'block';
            div.innerHTML = "Loading...";

            if (!token) {
                div.innerHTML = "<span style='color:red'>No token found.</span>";
                return;
            }

            try {
                const res = await fetch('/BearerPrivileges', {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({})
                });

                if (!res.ok) throw new Error(`HTTP ${res.status}`);

                const data = await res.json(); // Returns string[]

                if (!data || data.length === 0) {
                    div.innerHTML = "<em>No privileges found for this token.</em>";
                    return;
                }

                // Render Tags
                // We assume u.js s`${...} exists for safety
                const safeInterpolate = (str) => (typeof s === 'function') ? s`${str}` : str;

                div.innerHTML = `<div class='priv-list'>
                    ${data.map(p => `<span class='priv-tag has-access'>${safeInterpolate(p)}</span>`).join('')}
                </div>`;

            } catch (err) {
                div.innerHTML = `<span style='color:red'>Error: ${err.message}</span>`;
            }
        }

        async function fullEcho() {
            const token = getCookie("auth-token");
            const div = document.getElementById('echoResult');
            div.style.display = 'block';
            div.innerHTML = "Loading...";

            if (!token) {
                div.innerHTML = "<span style='color:red'>No token found.</span>";
                return;
            }

            try {
                const res = await fetch('/BearerEcho', {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({})
                });

                if (!res.ok) throw new Error(`HTTP ${res.status}`);

                const data = await res.json(); // Returns LoginDetails

                // Pretty print JSON
                // We assume u.js s`${...} exists for safety
                const safeInterpolate = (str) => (typeof s === 'function') ? s`${str}` : str;

                div.innerHTML = `<pre>${safeInterpolate(JSON.stringify(data, null, 2))}</pre>`;

            } catch (err) {
                div.innerHTML = `<span style='color:red'>Error: ${err.message}</span>`;
            }
        }
    </script>
</body>
</html>