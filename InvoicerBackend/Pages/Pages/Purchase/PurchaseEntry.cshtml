@page "/Pages/Purchase/Entry"

@functions { }
<!DOCTYPE html>
<html>
<head>
    <title>Purchase Entry</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
    <style>
        .calc-box {
            background: #e9ecef;
            padding: 5px;
            border-radius: 3px;
            font-family: monospace;
            min-height: 20px;
        }

        .effective-cost {
            background: #fff3cd;
            font-weight: bold;
            border: 2px solid #ffc107;
        }

        input[readonly] {
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>Purchase Entry</h2>
        <div id="status">Loading...</div>
        <div id="form" style="display:none;">

            <div class="header">
                <h3 id="itemName">Select Item</h3>
                <p>Item Code: <span id="itemCode">-</span></p>
            </div>

            <!-- Quantities -->
            <div class="row">
                <div class="col"><label>Pack Size</label><input type="number" id="PackSize" oninput="recalculate('PackSize')"></div>
                <div class="col"><label>Pack Qty</label><input type="number" id="PackQuantity" oninput="recalculate('PackQuantity')"></div>
                <div class="col"><label>Free Packs</label><input type="number" id="FreePacks" oninput="recalculate('FreePacks')"></div>
            </div>

            <div class="row">
                <div class="col"><label>Loose Units (Add)</label><input type="number" id="ReceivedAsUnitQuantity" oninput="recalculate('ReceivedAsUnitQuantity')"></div>
                <div class="col"><label>Free Units</label><input type="number" id="FreeUnits" oninput="recalculate('FreeUnits')"></div>
                <div class="col" style="background: #d4edda; padding: 10px;">
                    <label>Total Units (Gross)</label>
                    <div class="calc-box" id="TotalUnits">0</div>
                </div>
            </div>

            <hr>

            <!-- Costs (INDEPENDENT) -->
            <div class="row">
                <div class="col">
                    <label>Cost Per Pack</label>
                    <input type="number" step="0.01" id="CostPerPack" oninput="recalculate('CostPerPack')">
                </div>
                <div class="col">
                    <label>Cost Per Unit (Loose)</label>
                    <input type="number" step="0.01" id="CostPerUnit" oninput="recalculate('CostPerUnit')">
                </div>
                <div class="col" style="background: #e8f5e9; padding: 10px;">
                    <label>Gross Total</label>
                    <div class="calc-box" id="GrossTotal">0.00</div>
                </div>
            </div>

            <!-- Discount -->
            <div class="row">
                <div class="col"><label>Discount %</label><input type="number" step="0.01" id="DiscountPercentage" oninput="recalculate('DiscountPercentage')"></div>
                <div class="col"><label>Discount (Abs)</label><input type="number" step="0.01" id="DiscountAbsolute" oninput="recalculate('DiscountAbsolute')"></div>
                <div class="col" style="background: #fff3cd; padding: 10px;">
                    <label>Net Price</label>
                    <div class="calc-box" id="NetTotalPrice">0.00</div>
                </div>
            </div>

            <!-- VAT -->
            <div class="row">
                <div class="col"><label>VAT %</label><input type="number" step="0.01" id="VatPercentage" oninput="recalculate('VatPercentage')"></div>
                <div class="col"><label>VAT (Abs)</label><input type="number" step="0.01" id="VatAbsolute" oninput="recalculate('VatAbsolute')"></div>
                <div class="col">
                    <label>VAT Disallowed?</label>
                    <select id="IsVatADisallowedInputTax" onchange="recalculate('IsVatADisallowedInputTax')">
                        <option value="false">No (Reclaimable)</option>
                        <option value="true">Yes (Absorb into Cost)</option>
                    </select>
                </div>
                <div class="col" style="background: #cce5ff; padding: 10px;">
                    <label>Total Due</label>
                    <div class="calc-box" id="TotalAmountDue">0.00</div>
                </div>
            </div>

            <hr>

            <!-- Costing & Pricing -->
            <div class="row">
                <div class="col" style="padding: 10px;">
                    <label>Net Total Cost</label>
                    <div class="calc-box" id="NetTotalCost">0.00</div>
                    <small style="color:#666">Final cost (Inc. VAT if disallowed)</small>
                </div>
                <div class="col effective-cost" style="padding: 10px;">
                    <label>Effective Unit Cost</label>
                    <div class="calc-box" id="NetCostPerUnit">0.0000</div>
                    <small style="color:#856404">Cost per unit (incl. free items)</small>
                </div>
            </div>

            <div class="row">
                <div class="col">
                    <label>Markup %</label>
                    <input type="number" step="0.01" id="GrossMarkupPercentage" oninput="recalculate('GrossMarkupPercentage')">
                </div>
                <div class="col">
                    <label>Selling Price</label>
                    <input type="number" step="0.01" id="SellingPrice" oninput="recalculate('SellingPrice')">
                </div>
            </div>

            <div class="row">
                <div class="col"><label>Expiry Date</label><input type="date" id="ExpiryDate"></div>
                <div class="col"><label>Batch ID</label><input type="text" id="ManufacturerBatchId"></div>
            </div>

            <div style="margin-top: 20px;">
                <button class="btn btn-success" onclick="saveItem(true)">Add & Next</button>
                <button class="btn btn-primary" onclick="saveItem(false)">Save & Review</button>
                <button class="btn btn-secondary" onclick="cancelEdit()" id="btnCancel" style="display:none">Cancel Edit</button>
            </div>
        </div>
    </div>

    <script src="/Pages/static/u.js"></script>
    <script>
        const params = new URLSearchParams(window.location.search);
        const flowId = params.get('flowId');
        const editIndex = params.get('editIndex'); // Check if we are editing
        let currentItem = null;

        async function init() {
            const token = await getCookie("auth-token");

            if (editIndex !== null) {
                // EDIT MODE
                document.getElementById('btnCancel').style.display = 'inline-block';
                const res = await fetch('/GetFlowData', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ FlowId: flowId, Key: "purchaseItems" })
                });
                const data = await res.json();
                const list = JSON.parse(data.value || "[]");
                currentItem = list[parseInt(editIndex)];
                if(!currentItem) { alert("Item not found"); return; }
            } else {
                // NEW MODE
                const resItem = await fetch('/GetFlowData', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ FlowId: flowId, Key: "selectedItemCode" })
                });
                const dataItem = await resItem.json();
                if (!dataItem.value) { alert("No item selected."); return; }

                currentItem = {
                    Itemcode: parseInt(dataItem.value),
                    ProductName: "Loading...",
                    PackSize: 1, PackQuantity: 0, FreePacks: 0, ReceivedAsUnitQuantity: 0, FreeUnits: 0,
                    CostPerPack: 0, CostPerUnit: 0, DiscountPercentage: 0, DiscountAbsolute: 0,
                    VatPercentage: 0, VatAbsolute: 0, IsVatADisallowedInputTax: false,
                    GrossMarkupPercentage: 20, SellingPrice: 0,
                    TotalUnits: 0, GrossTotal: 0, NetTotalPrice: 0, TotalAmountDue: 0, NetCostPerUnit: 0, NetTotalCost: 0
                };
                currentItem.ExpiryDate = document.getElementById('ExpiryDate').value || null;
                currentItem.ManufacturingDate = document.getElementById('ManufacturingDate')?.value || null;

                // Fetch Name
                const ctxRes = await fetch('/GetPricingContext', {
                     method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                     body: JSON.stringify(currentItem.Itemcode)
                });
                const ctx = await ctxRes.json();
                currentItem.ProductName = ctx.DefaultSellingPrice || "Item " + currentItem.Itemcode;
                currentItem.SellingPrice = ctx.DefaultSellingPrice || 0;
                currentItem.ProductName = ctx.itemName || "Item " + currentItem.Itemcode;
                currentItem.CurrentStock = ctx.currentStock || 0;
                currentItem.SellingPrice = ctx.defaultSellingPrice || 0;
            }

            renderForm();
            recalculate('Init');
            document.getElementById('status').style.display = 'none';
            document.getElementById('form').style.display = 'block';
        }

        function renderForm() {
            document.getElementById('itemCode').textContent = currentItem.Itemcode;
            document.getElementById('itemName').textContent = currentItem.ProductName;

            const fields = ["PackSize", "PackQuantity", "FreePacks", "ReceivedAsUnitQuantity", "FreeUnits",
                            "CostPerPack", "CostPerUnit", "DiscountPercentage", "DiscountAbsolute",
                            "VatPercentage", "VatAbsolute", "IsVatADisallowedInputTax",
                            "GrossMarkupPercentage", "SellingPrice", "ExpiryDate", "ManufacturerBatchId"];

            fields.forEach(f => {
                const el = document.getElementById(f);
                if(el) el.value = currentItem[f];
            });
            updateCalculatedFields();
        }

        function updateCalculatedFields() {
            document.getElementById('TotalUnits').textContent = currentItem.TotalUnits.toFixed(2);
            document.getElementById('GrossTotal').textContent = currentItem.GrossTotal.toFixed(2);
            document.getElementById('NetTotalPrice').textContent = currentItem.NetTotalPrice.toFixed(2);
            document.getElementById('TotalAmountDue').textContent = currentItem.TotalAmountDue.toFixed(2);
            document.getElementById('NetCostPerUnit').textContent = currentItem.NetCostPerUnit.toFixed(4);
            document.getElementById('NetTotalCost').textContent = currentItem.NetTotalCost.toFixed(2);
        }

                function recalculate(origin) {
            const getVal = (id) => parseFloat(document.getElementById(id).value) || 0;

            // 1. Inputs
            currentItem.PackSize = getVal('PackSize');
            currentItem.PackQuantity = getVal('PackQuantity');
            currentItem.FreePacks = getVal('FreePacks');
            currentItem.ReceivedAsUnitQuantity = getVal('ReceivedAsUnitQuantity');
            currentItem.FreeUnits = getVal('FreeUnits');

            // 2. Independent Costs
            currentItem.CostPerPack = getVal('CostPerPack');
            currentItem.CostPerUnit = getVal('CostPerUnit');

            currentItem.IsVatADisallowedInputTax = document.getElementById('IsVatADisallowedInputTax').value === 'true';

            // 3. Total Units
            currentItem.TotalUnits =
                ((currentItem.PackQuantity + currentItem.FreePacks) * currentItem.PackSize)
                + currentItem.ReceivedAsUnitQuantity
                + currentItem.FreeUnits;

            // 4. Gross Total
            currentItem.GrossTotal = (currentItem.PackQuantity * currentItem.CostPerPack)
                                     + (currentItem.ReceivedAsUnitQuantity * currentItem.CostPerUnit);

            // --- DISCOUNT REACTIVITY FIX ---
            const discPctField = document.getElementById('DiscountPercentage');
            const discAbsField = document.getElementById('DiscountAbsolute');

            // Helper to safely calculate percentage
            const calcDiscPct = () => {
                if (currentItem.GrossTotal === 0) return 0; // Default to 0 if no base
                return (currentItem.DiscountAbsolute / currentItem.GrossTotal) * 100.0;
            };

            if (origin === 'DiscountPercentage') {
                currentItem.DiscountPercentage = getVal('DiscountPercentage');
                currentItem.DiscountAbsolute = currentItem.GrossTotal * (currentItem.DiscountPercentage / 100.0);
                discAbsField.value = currentItem.DiscountAbsolute.toFixed(2);
            }
            else if (origin === 'DiscountAbsolute') {
                currentItem.DiscountAbsolute = getVal('DiscountAbsolute');
                // FIX: Always update percentage, even if Gross is 0 (results in 0)
                currentItem.DiscountPercentage = calcDiscPct();
                discPctField.value = currentItem.DiscountPercentage.toFixed(2);
            }
            else {
                // If Cost/Qty changed:
                // We try to preserve the user's last intent.
                // If they typed Absolute recently, Abs is in the box. We recalc %.
                // If they typed Percentage recently, % is in the box. We recalc Abs.

                // Heuristic: If Abs field is non-zero, assume Abs is the master.
                if (getVal('DiscountAbsolute') !== 0) {
                    currentItem.DiscountAbsolute = getVal('DiscountAbsolute');
                    currentItem.DiscountPercentage = calcDiscPct();
                    discPctField.value = currentItem.DiscountPercentage.toFixed(2);
                } else {
                    // Else assume Percentage is master (or both are 0)
                    currentItem.DiscountPercentage = getVal('DiscountPercentage');
                    currentItem.DiscountAbsolute = currentItem.GrossTotal * (currentItem.DiscountPercentage / 100.0);
                    discAbsField.value = currentItem.DiscountAbsolute.toFixed(2);
                }
            }

            currentItem.NetTotalPrice = currentItem.GrossTotal - currentItem.DiscountAbsolute;

            // --- VAT REACTIVITY FIX ---
            const vatPctField = document.getElementById('VatPercentage');
            const vatAbsField = document.getElementById('VatAbsolute');

            const calcVatPct = () => {
                if (currentItem.NetTotalPrice === 0) return 0;
                return (currentItem.VatAbsolute / currentItem.NetTotalPrice) * 100.0;
            };

            if (origin === 'VatPercentage') {
                currentItem.VatPercentage = getVal('VatPercentage');
                currentItem.VatAbsolute = currentItem.NetTotalPrice * (currentItem.VatPercentage / 100.0);
                vatAbsField.value = currentItem.VatAbsolute.toFixed(2);
            }
            else if (origin === 'VatAbsolute') {
                currentItem.VatAbsolute = getVal('VatAbsolute');
                // FIX: Always update percentage
                currentItem.VatPercentage = calcVatPct();
                vatPctField.value = currentItem.VatPercentage.toFixed(2);
            }
            else {
                if (getVal('VatAbsolute') !== 0) {
                    currentItem.VatAbsolute = getVal('VatAbsolute');
                    currentItem.VatPercentage = calcVatPct();
                    vatPctField.value = currentItem.VatPercentage.toFixed(2);
                } else {
                    currentItem.VatPercentage = getVal('VatPercentage');
                    currentItem.VatAbsolute = currentItem.NetTotalPrice * (currentItem.VatPercentage / 100.0);
                    vatAbsField.value = currentItem.VatAbsolute.toFixed(2);
                }
            }

            currentItem.TotalAmountDue = currentItem.NetTotalPrice + currentItem.VatAbsolute;

            // 7. Net costs (Effective Values)
            currentItem.NetTotalCost = currentItem.IsVatADisallowedInputTax ? currentItem.TotalAmountDue : currentItem.NetTotalPrice;
            currentItem.NetCostPerUnit = currentItem.TotalUnits > 0 ? currentItem.NetTotalCost / currentItem.TotalUnits : 0;

            // 8. Pricing
            if (origin === 'GrossMarkupPercentage') {
                currentItem.GrossMarkupPercentage = getVal('GrossMarkupPercentage');
                currentItem.SellingPrice = currentItem.NetCostPerUnit * (1 + (currentItem.GrossMarkupPercentage / 100.0));
                document.getElementById('SellingPrice').value = currentItem.SellingPrice.toFixed(2);
            } else if (origin === 'SellingPrice') {
                currentItem.SellingPrice = getVal('SellingPrice');
                if (currentItem.NetCostPerUnit > 0) {
                    currentItem.GrossMarkupPercentage = ((currentItem.SellingPrice - currentItem.NetCostPerUnit) / currentItem.NetCostPerUnit) * 100.0;
                    document.getElementById('GrossMarkupPercentage').value = currentItem.GrossMarkupPercentage.toFixed(2);
                }
            }

            updateCalculatedFields();
        }

        async function saveItem(addMore) {
            const token = await getCookie("auth-token");
            currentItem.ExpiryDate = document.getElementById('ExpiryDate').value;
            currentItem.ManufacturerBatchId = document.getElementById('ManufacturerBatchId').value;

            // Load list
            const resList = await fetch('/GetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "purchaseItems" })
            });
            const dataList = await resList.json();
            let list = JSON.parse(dataList.value || "[]");

            if (editIndex !== null) {
                list[parseInt(editIndex)] = currentItem; // UPDATE
            } else {
                list.push(currentItem); // ADD
            }

            await fetch('/SetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "purchaseItems", Value: JSON.stringify(list) })
            });

            if (addMore) window.location.href = '/Pages/SearchAndSelect/ItemSelect?flowId=' + flowId;
            else window.location.href = '/Pages/Purchase/Review?flowId=' + flowId;
        }

        function cancelEdit() {
            window.location.href = '/Pages/Purchase/Review?flowId=' + flowId;
        }

        init();
    </script>
</body>
</html>