@page "/Pages/Purchase/Review"
@functions { }
<!DOCTYPE html>
<html>
<head>
    <title>Review Purchase</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
    <style>
        .section-box {
            background: #fff;
            border: 1px solid #dee2e6;
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 5px;
        }

        .expense-row {
            display: flex;
            gap: 10px;
            margin-bottom: 10px;
            align-items: center;
        }

        .payment-row {
            display: flex;
            justify-content: space-between;
            padding: 8px;
            border-bottom: 1px solid #eee;
            background: #f8f9fa;
            margin-bottom: 5px;
        }

            .payment-row.credit {
                background: #e3f2fd;
                border-left: 4px solid #2196f3;
            }
    </style>
</head>
<body>
    <div class="container">
        <h2>Review Purchase Invoice</h2>
        <div id="content" class="result-box">Loading...</div>
    </div>

    <script src="/Pages/static/u.js"></script>
    <script>
        const params = new URLSearchParams(window.location.search);
        const flowId = params.get('flowId');
        let currentSupplierId = 0;

        async function run() {
            const token = await getCookie("auth-token");
            const contentDiv = document.getElementById('content');

            // 1. Load Data
            const itemsVal = await getFlowKey("purchaseItems");
            const paymentsVal = await getFlowKey("payments"); // NEW
            const expensesVal = await getFlowKey("expenses"); // NEW
            const piiVal = await getFlowKey("selectedPiiId");
            const piiName = await getFlowKey("selectedPiiName"); // Fetch Name

            if (piiVal) {
                currentSupplierId = parseInt(piiVal);
                currentSupplierName = piiName || "Unknown"; // Store Name
            }

            if (!itemsVal) { contentDiv.innerHTML = `<p class="warning">No items found.</p>`; return; }
            const items = JSON.parse(itemsVal);
            if (items.length === 0) { contentDiv.innerHTML = `<p class="warning">Item list is empty.</p>`; return; }

            currentSupplierId = piiVal ? parseInt(piiVal) : 0;

            // 2. Fetch Stock
            let stockMap = {};
            try {
                const itemCodes = items.map(i => i.Itemcode); // PascalCase fix
                const stockRes = await fetch('/GetStockInfo', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify(itemCodes)
                });
                if (stockRes.ok) stockMap = await stockRes.json();
            } catch (e) { console.error("Stock fetch failed", e); }

            // 3. Load Data
            const payments = paymentsVal ? JSON.parse(paymentsVal) : [];
            const expenses = expensesVal ? JSON.parse(expensesVal) : [];

            // 4. Prepare Header
            let header = {
                SupplierId: currentSupplierId, 
                SupplierName: currentSupplierName, // Use Name
                CreatedAt: new Date().toISOString()
            };

            // 5. Simulate (Pass Payments/Expenses)
            try {
                const res = await fetch('/SimulatePurchase', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ Header: header, Items: items, Payments: payments, Expenses: expenses })
                });
                const result = await res.json();
                render(result, stockMap, payments, expenses);
            } catch (e) {
                contentDiv.innerHTML = `<p class="warning">Error: ${e.message}</p>`;
            }
        }

        function render(result, stockMap, payments, expenses) {
            const contentDiv = document.getElementById('content');
            let html = "";

            if (!result.success) {
                // Show error prominently and STOP.
                contentDiv.innerHTML = `<div class="result-error-box"><h3>Validation Error</h3><p>${he(result.message)}</p><button class="btn btn-primary" onclick="location.href='/Pages/SearchAndSelect/PiiSelect?flowId=${flowId}'">Select Supplier</button></div>`;
                return;
            }

            if (!result.success && result.message) html += `<p class="warning">${he(result.message)}</p>`;

            // --- ITEMS ---
            html += `<div class="section-box"><h3>Items</h3><div class="item-list">`;
            // Use optional chaining (?.) and fallbacks for safety
            (result.items || []).forEach((item, i) => {
                // FIX: Use camelCase to match JSON from C# backend
                const sih = (stockMap && stockMap[item.itemcode]) ? stockMap[item.itemcode].toFixed(2) : "0.00";

                html += `<div class="item-row">
                    <div style="flex: 2;">
                        <strong>${he(item.productName || "Unknown")}</strong><br>
                        <small>Code: ${item.itemcode} | SIH: ${sih}</small>
                    </div>
                    <div>Qty: ${(item.totalUnits || 0).toFixed(2)}</div>
                    <div>Cost: ${(item.netCostPerUnit || 0).toFixed(2)}</div>
                    <div>Total: ${(item.totalAmountDue || 0).toFixed(2)}</div>
                    <div>
                        <a href="/Pages/Purchase/Entry?flowId=${flowId}&editIndex=${i}" class="btn-sm btn-primary">Edit</a>
                        <span class="remove-btn" onclick="removeItem(${i})">✕</span>
                    </div>
                </div>`;
            });
            html += `</div></div>`;

            // --- MISC EXPENSES ---
            html += `<div class="section-box">
                <h3>Misc. Expenses (Shipping/Labour)</h3>
                <div id="expenseList">`;

            (expenses || []).forEach((exp, i) => {
                 html += `<div class="expense-row">
                    <input type="text" value="${he(exp.description)}" style="flex:3" onchange="updateExpense(${i}, 'description', this.value)">
                    <input type="number" value="${exp.amount}" step="0.01" style="flex:1" onchange="updateExpense(${i}, 'amount', parseFloat(this.value))">
                    <span class="remove-btn" onclick="removeExpense(${i})">✕</span>
                </div>`;
            });

            html += `</div>
                <button class="btn btn-secondary" onclick="addExpense()">Add Expense Row</button>
            </div>`;

            // --- PAYMENTS ---
            const totalPaid = payments.reduce((sum, p) => sum + p.Amount, 0);
            const grandTotal = result.header.totalAmountDue || 0; // Assuming backend sums expenses now
            const balance = grandTotal - totalPaid;

            html += `<div class="section-box">
                <h3>Payments & Settlement</h3>
                <div id="paymentList">`;

            payments.forEach((p, i) => {
                const isCredit = p.Type === "ACCOUNT" && p.AccountNo !== 0; // Heuristic for "On Account"
                const cls = isCredit ? "payment-row credit" : "payment-row";
                html += `<div class="${cls}">
                    <div><strong>${he(p.AccountName || 'Cash/Bank')}</strong>
                         ${isCredit ? '<span style="color:#2196f3; font-size:0.8em">(On Account / Credit)</span>' : ''}
                    </div>
                    <div>${p.Amount.toFixed(2)}</div>
                    <div><span class="remove-btn" onclick="removePayment(${i})">✕</span></div>
                </div>`;
            });

            html += `</div>
            <div style="margin-top: 10px; display: flex; gap: 10px; flex-wrap: wrap;">
                <button class="btn btn-primary" onclick="addPayment('CASH')">Add Cash</button>
                <button class="btn btn-primary" onclick="addPayment('BANK')">Add Bank</button>
                <button class="btn btn-warning" onclick="addCreditPayment()" ${currentSupplierId === 0 ? 'disabled' : ''}>
                    Add Credit (On Account)
                </button>
            </div>`;

            // --- TOTALS ---
            html += `<div class="summary-box">
                <p><strong>Gross Total:</strong> ${result.header.grossTotal.toFixed(2)}</p>
                <p><strong>VAT Total:</strong> ${result.header.vatTotal.toFixed(2)}</p>
                <h3><strong>Total Amount Due:</strong> ${grandTotal.toFixed(2)}</h3>
                <hr>
                <p><strong>Paid/Allocated:</strong> ${totalPaid.toFixed(2)}</p>
                <p style="color:${balance > 0 ? 'red' : 'green'}"><strong>Balance:</strong> ${balance.toFixed(2)}</p>
            </div>`;

            // --- ACTIONS ---
            html += `<div style="margin-top: 15px;">
                <button class="btn btn-primary" onclick="addItem()">Add More Items</button>
                <button class="btn btn-warning" onclick="saveDraft()">Save Draft</button>
                <button class="btn btn-success" onclick="post()">POST INVOICE</button>
            </div>`;

            contentDiv.innerHTML = html;
        }

        // --- ACTIONS ---

        async function addExpense() {
            const token = await getCookie("auth-token");
            const rawData = await getFlowKeyRaw("expenses");
            const dataObj = JSON.parse(rawData || '{"value":"[]"}');
            let list = JSON.parse(dataObj.value || "[]");
            list.push({ description: "New Expense", amount: 0 });

            await fetch('/SetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "expenses", Value: JSON.stringify(list) })
            });
            run();
        }

        async function updateExpense(index, field, value) {
            const token = await getCookie("auth-token");
            const rawData = await getFlowKeyRaw("expenses");
            const dataObj = JSON.parse(rawData || '{"value":"[]"}');
            let list = JSON.parse(dataObj.value || "[]");
            if (list[index]) list[index][field] = value;

            await fetch('/SetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "expenses", Value: JSON.stringify(list) })
            });
            run(); // Re-run to update totals
        }

        async function removeExpense(index) {
            if(!confirm("Remove expense?")) return;
            const token = await getCookie("auth-token");
            const rawData = await getFlowKeyRaw("expenses");
            const dataObj = JSON.parse(rawData || '{"value":"[]"}');
            let list = JSON.parse(dataObj.value || "[]");
            list.splice(index, 1);
            await fetch('/SetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "expenses", Value: JSON.stringify(list) })
            });
            run();
        }

        async function addPayment(type) {
            // Redirect directly to the Amount Entry page for the specific type (CASH/BANK)
            window.location.href = `/Pages/Purchase/EnterPaymentAmount?flowId=${flowId}&type=${type}`;
        }

        async function addCreditPayment() {
            // Redirect to the Amount Entry page with type=CREDIT
            // The payment page will handle the "Auto-Fill" logic for the balance
            window.location.href = `/Pages/Purchase/EnterPaymentAmount?flowId=${flowId}&type=CREDIT`;
        }

        async function removePayment(index) {
            if(!confirm("Remove payment?")) return;
            const token = await getCookie("auth-token");
            const rawData = await getFlowKeyRaw("payments");
            const dataObj = JSON.parse(rawData || '{"value":"[]"}');
            let list = JSON.parse(dataObj.value || "[]");
            list.splice(index, 1);
            await fetch('/SetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "payments", Value: JSON.stringify(list) })
            });
            run();
        }

        async function addItem() {
            window.location.href = '/Pages/SearchAndSelect/ItemSelect?flowId=' + flowId;
        }

        async function removeItem(index) {
            if(!confirm("Remove item?")) return;
            const token = await getCookie("auth-token");
            const data = JSON.parse(await getFlowKeyRaw("purchaseItems"));
            let list = JSON.parse(data.value || "[]");
            list.splice(index, 1);
            await fetch('/SetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "purchaseItems", Value: JSON.stringify(list) })
            });
            run();
        }

        async function post() {
            const token = await getCookie("auth-token");
            if(!confirm("Post this invoice? This will update inventory and accounts.")) return;

            if (!currentSupplierName) {
                currentSupplierName = await getFlowKey("selectedPiiName") || "Unknown";
            }


            const payload = {
                Header: { SupplierId: currentSupplierId, SupplierName: currentSupplierName, Remarks: "Purchase via Web UI" },
                Items: JSON.parse(await getFlowKey("purchaseItems")),
                Payments: JSON.parse(await getFlowKey("payments") || "[]"),
                Expenses: JSON.parse(await getFlowKey("expenses") || "[]")
            };

            try {
                const res = await fetch('/PostPurchase', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ Payload: JSON.stringify(payload) })
                });
                const result = await res.json();

                if(result.success) {
                    alert("Invoice Posted! ID: " + result.invoiceId);
                    window.location.href = '/Pages/Flows/BeginFlowPurchase';
                } else {
                    alert("Error: " + result.message);
                }
            } catch(e) { alert("Network Error: " + e.message); }
        }

        // --- HELPERS ---
        async function getFlowKey(key) {
            const val = await getFlowKeyRaw(key);
            return val ? JSON.parse(val).value : null;
        }
        async function getFlowKeyRaw(key) {
            const token = await getCookie("auth-token");
            const res = await fetch('/GetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: key })
            });
            if (!res.ok) return null;
            return await res.text();
        }

        run();
    </script>
</body>
</html>