@page "/Pages/Sales/SelectPaymentMethod"
@functions { }

<!DOCTYPE html>
<html>
<head>
    <title>Select Payment Method</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
    <style>
        .method-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-top: 20px;
        }

        .method-card {
            border: 2px solid #eee;
            padding: 30px;
            text-align: center;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
            background: white;
        }

            .method-card:hover {
                border-color: #007bff;
                background: #f8f9fa;
                transform: translateY(-2px);
            }

            .method-card h3 {
                margin-bottom: 10px;
                color: #333;
            }

            .method-card p {
                font-size: 0.9em;
                color: #666;
            }

            .method-card.disabled {
                opacity: 0.5;
                pointer-events: none;
                background: #f0f0f0;
            }
    </style>
</head>
<body>
    <div class="container">
        <h2>Select Payment Method</h2>
        <div id="permWarning" class="perm-warning" style="display:none;"></div>

        <div id="summary" class="summary" style="margin-bottom:20px;">
            <p><strong>Total Due:</strong> <span id="totalDue">Loading...</span></p>
            <p><strong>Remaining:</strong> <span id="remainingDue" style="color:#d9534f;">Loading...</span></p>
        </div>

        <div class="method-grid">
            <!-- Cash -->
            <div class="method-card" onclick="selectCash()">
                <h3>💵 Cash</h3>
                <p>Physical currency</p>
            </div>

            <!-- Bank / Card -->
            <div class="method-card" onclick="selectBank()">
                <h3>💳 Card / Bank</h3>
                <p>Credit, Debit, or Transfer</p>
            </div>

            <!-- Loyalty Points -->
            <div class="method-card" onclick="selectLP()">
                <h3>⭐ Loyalty Points</h3>
                <p>Redeem points (1pt = $1.00)</p>
            </div>

            <!-- Account / Credit Sale -->
            <div class="method-card" onclick="selectAccount()">
                <h3>🏠 House Account</h3>
                <p>Charge to customer account</p>
            </div>

            <!-- Voucher (Placeholder) -->
            <!--
            <div class="method-card disabled">
                <h3>🎟️ Voucher</h3>
                <p>Gift cards / Coupons</p>
            </div>
            -->
        </div>
    </div>

    <script src="/Pages/static/u.js"></script>
    <script>
        const requiredEndpoints = ["GetFlowData", "SimulateSaleWithPayments"];
        const params = new URLSearchParams(window.location.search);
        const flowId = params.get('flowId');

        async function init() {
            await checkPagePermissions(requiredEndpoints);
            const token = await getCookie("auth-token");

            const piiId = await getFlowKey("selectedPiiId");
            const items = JSON.parse(await getFlowKey("orderItems") || "[]");
            const payments = JSON.parse(await getFlowKey("payments") || "[]");

            if (!piiId || items.length === 0) {
                document.getElementById('summary').innerHTML = "<em>No items in order.</em>";
                return;
            }

            const res = await fetch('/SimulateSaleWithPayments', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ PiiId: parseInt(piiId), Items: items, Payments: payments })
            });
            const data = await res.json();

            document.getElementById('totalDue').innerText = data.grandTotal.toFixed(2);
            document.getElementById('remainingDue').innerText = (data.grandTotal - data.totalPaid).toFixed(2);
        }

        async function selectCash() {
            // Redirect to standard payment entry, defaulting to Cash logic
            window.location.href = '/Pages/Sales/EnterPaymentAmount?flowId=' + flowId + '&type=CASH';
        }

        async function selectBank() {
            window.location.href = '/Pages/Sales/EnterPaymentAmount?flowId=' + flowId + '&type=BANK';
        }

        async function selectLP() {
            window.location.href = '/Pages/Sales/EnterLoyaltyPoints?flowId=' + flowId;
        }

        async function selectAccount() {
            // We need to select WHICH account to charge.
            // Redirect to the generic Account Selector used in flows.
            // Set a flag so we know we are paying, not just selecting a journal debit.
            const token = await getCookie("auth-token");
            await fetch('/SetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "paymentAccountSelect", Value: "true" })
            });

            // Use the existing Account Selection page
            window.location.href = '/Pages/Journal/SelectDebitAccount?flowId=' + flowId;
        }

        async function getFlowKey(key) {
            const token = await getCookie("auth-token");
            const res = await fetch('/GetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: key })
            });
            return (await res.json()).value;
        }

        init();
    </script>
</body>
</html>