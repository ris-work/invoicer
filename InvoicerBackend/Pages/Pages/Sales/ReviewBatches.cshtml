@page "/Pages/Sales/ReviewBatches"

@*
  FLOW: Sales Simulation / Sale Order
  STEP: Final (Review & Payment)
*@

@functions { }

<!DOCTYPE html>
<html>
<head>
    <title>Review Sale Order</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
    <style>
        /* Page-specific styles */
        .item-card {
            background: white;
            border: 1px solid #dee2e6;
            margin-bottom: 20px;
            border-radius: 5px;
        }

        .item-header {
            background: #f8f9fa;
            padding: 15px;
            border-bottom: 1px solid #eee;
            font-weight: bold;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .status-ok {
            color: #28a745;
        }

        .status-fail {
            color: #dc3545;
        }

        .debug-details {
            border-top: 1px solid #eee;
            padding: 10px;
            background: #fafafa;
        }

            .debug-details summary {
                cursor: pointer;
                color: #666;
                font-size: 0.9em;
            }

        .row-selected {
            background-color: #e8f5e9;
        }

        .row-skipped {
            color: #999;
            background-color: #fff;
        }

        .remove-btn {
            margin-left: 15px;
            color: #dc3545;
            cursor: pointer;
            font-weight: bold;
        }

        .hint {
            color: #666;
            font-size: 0.9em;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>Review Sale Order</h2>
        <div id="content" class="result-box"><p>Processing Order...</p></div>
    </div>

    <script src="/Pages/static/u.js"></script>
    <script>
        const params = new URLSearchParams(window.location.search);
        const flowId = params.get('flowId');
        function getCookie(n) { const v = `; ${document.cookie}`; const p = v.split(`; ${n}=`); return p.length === 2 ? p.pop().split(';').shift() : null; }

        async function run() {
            const token = getCookie("auth-token");
            const contentDiv = document.getElementById('content');

            // 1. Load Order Data
            const orderItemsVal = await getFlowKey("orderItems");
            const piiIdVal = await getFlowKey("selectedPiiId");

            if (!orderItemsVal || !piiIdVal) {
                contentDiv.innerHTML = s`<p class="warning">Error: Missing flow data.</p>`;
                return;
            }

            const orderItems = JSON.parse(orderItemsVal);
            const piiId = parseInt(piiIdVal);

            if (orderItems.length === 0) {
                contentDiv.innerHTML = s`<p class="warning">Error: Order is empty.</p>`;
                return;
            }

            try {
                // 2. Load Payments
                const paymentsVal = await getFlowKey("payments");
                const payments = paymentsVal ? JSON.parse(paymentsVal) : [];

                // 3. Call FULL Simulation API (Re-validates everything)
                const simRes = await fetch('/SimulateSaleWithPayments', {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        PiiId: piiId,
                        Items: orderItems,
                        Payments: payments
                    })
                });

                if (!simRes.ok) throw new Error(await simRes.text());
                const result = await simRes.json();

                // 4. Render
                render(result, orderItems);

            } catch (err) {
                contentDiv.innerHTML = s`<p class="warning">API Error: ${err.message}</p>`;
            }
        }

        function render(result, orderItems) {
            const contentDiv = document.getElementById('content');
            let html = "";

            if (!result.success) {
                html += `<p class="warning">Order Cannot Be Fulfilled Completely</p>`;
            } else {
                html += `<p style="color: #28a745; font-weight: bold;">Order Ready for Execution</p>`;
            }

            // Items
            result.items.forEach((item, index) => {
                const statusClass = item.success ? "status-ok" : "status-fail";
                const statusText = item.success ? "OK" : "FAILED";

                html += `<div class="item-card">`;
                html += s`<div class="item-header">
                    <span>Item ${item.itemCode}</span>
                    <div>
                        <span class="${statusClass}">${statusText}: ${item.message}</span>
                        <span class="remove-btn" onclick="removeItem(${index})">✕</span>
                    </div>
                </div>`;

                html += `<div style="padding: 10px;">
                    <h4>Selected Batches</h4>
                    <table>
                        <thead><tr><th>Batch</th><th>Qty</th><th>Price</th><th>Disc</th><th>Tax %</th><th>Tax Amt</th></tr></thead>
                        <tbody>`;

                item.selectedBatches.forEach(b => {
                    const taxRate = b.taxRate || 0;
                    const taxAmount = b.taxAmount || 0;
                    const taxSource = b.taxSource || "N/A";

                    html += s`<tr class="row-selected">
                        <td>${b.batchcode}</td>
                        <td>${b.quantity.toFixed(2)}</td>
                        <td>${b.unitPrice.toFixed(2)}</td>
                        <td>${b.unitDiscount.toFixed(2)}</td>
                        <td>${taxRate.toFixed(1)}% <span style="font-size:0.8em;color:#888">(${taxSource})</span></td>
                        <td>${taxAmount.toFixed(2)}</td>
                    </tr>`;
                });

                html += `</tbody></table>`;

                // Debug Details
                html += `<details class="debug-details">
                    <summary>All Batches (Debug Info)</summary>
                    <table>
                        <thead><tr><th>ID</th><th>Initial</th><th>VI Initial</th><th>Avail</th><th>Status</th><th>Eff. Price</th></tr></thead>
                        <tbody>`;

                item.allBatches.forEach(b => {
                    let rowClass = b.status === "Selected" ? "row-selected" : "row-skipped";
                    html += s`<tr class="${rowClass}">
                        <td>${b.batchcode}</td>
                        <td>${b.initialQty.toFixed(2)}</td>
                        <td>${b.viInitialQty.toFixed(2)}</td>
                        <td>${b.availableQty.toFixed(2)}</td>
                        <td>${b.status}</td>
                        <td>${b.effectivePrice ? b.effectivePrice.toFixed(2) : '-'}</td>
                    </tr>`;
                });

                html += `</tbody></table></details></div></div>`;
            });

            // Payments
                        // Payments
            html += `<h3>Payments</h3><div class="item-card"><div style="padding:10px;">`;

            const payments = result.paymentResults || [];

            if (payments.length > 0) {
                html += `<table><thead><tr><th>Type</th><th>Account</th><th>Amount</th><th>LP Earned</th><th></th></tr></thead><tbody>`;
                payments.forEach((p, i) => {

                    let typeDisplay = s`<span class="badge-check">${p.type || 'CASH'}</span>`;
                    let details = "";

                    // Special Rendering for LP
                    if (p.type === 'LP') {
                        details = s`<br><small style="color:#666">${p.pointsRedeemed.toFixed(0)} Points</small>`;
                    }
                    // Special Rendering for Account
                    else if (p.type === 'ACCOUNT') {
                        details = s`<br><small style="color:#dc3545">Credit Sale</small>`;
                    }

                    html += s`<tr>
                        <td>${typeDisplay}</td>
                        <td>${p.accountName} ${details}</td>
                        <td>${p.amountTendered.toFixed(2)}</td>
                        <td>${p.lpEarned.toFixed(2)}</td>
                        <td><span class="remove-btn" onclick="removePayment(${i})">✕</span></td>
                    </tr>`;
                });
                html += `</tbody></table>`;
            } else {
                html += `<p class="hint">No payments added yet.</p>`;
            }

            html += `<button class="btn btn-primary" onclick="addPayment()">Add Payment</button>`;
            html += `</div></div>`;



            // Totals
            let grandTotal = result.grandTotal || 0;
            const totalPaid = result.totalPaid || 0;
            const balance = (result.balance !== undefined) ? result.balance : (totalPaid - grandTotal);
            const lpFinal = result.loyaltyPointsFinal || 0;

            html += s`<div class="summary">
                <p><strong>Grand Total:</strong> ${grandTotal.toFixed(2)}</p>
                <p><strong>Paid:</strong> ${totalPaid.toFixed(2)}</p>
                <p style="color:${balance < 0 ? 'red' : 'green'}"><strong>Balance:</strong> ${balance.toFixed(2)}</p>
                <hr>
                <p><strong>Total LP:</strong> ${lpFinal.toFixed(2)}</p>
            </div>`;

            // Actions
            html += `<div style="margin-top: 15px;">
                <button class="btn btn-success" onclick="pay()">PAY (Post)</button>
                <button class="btn btn-secondary" onclick="saveDraft()">Save Draft</button>
            </div>`;

            contentDiv.innerHTML = html;
        }

        // --- ACTIONS ---

        async function removeItem(index) {
            if (!confirm("Remove this item from the order?")) return;
            const token = getCookie("auth-token");

            const dataList = await getFlowKeyRaw("orderItems");
            let list = JSON.parse(dataList || "[]");
            list.splice(index, 1);

            await fetch('/SetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "orderItems", Value: JSON.stringify(list) })
            });
            run();
        }

        async function removePayment(index) {
            if (!confirm("Remove payment?")) return;
            const token = getCookie("auth-token");

            const dataList = await getFlowKeyRaw("payments");
            let list = JSON.parse(dataList || "[]");
            list.splice(index, 1);

            await fetch('/SetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "payments", Value: JSON.stringify(list) })
            });
            run();
        }

        async function addPayment() {
            const token = getCookie("auth-token");
            //const redirTo = '/Pages/Sales/EnterPaymentAmount?flowId=' + flowId;
            // Redirect to the new Method Selector
            window.location.href = '/Pages/Sales/SelectPaymentMethod?flowId=' + flowId;
        }

        async function saveDraft() {
            const token = getCookie("auth-token");

            const payload = {
                PiiId: parseInt(await getFlowKey("selectedPiiId")),
                Items: JSON.parse(await getFlowKey("orderItems")),
                Payments: JSON.parse(await getFlowKey("payments") || "[]")
            };

            try {
                const res = await fetch('/SaveDraftInvoice', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ Payload: JSON.stringify(payload) })
                });

                if (!res.ok) throw new Error(await res.text());
                const id = await res.json();

                // Store ID so Pay can mark it posted
                await fetch('/SetFlowData', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ FlowId: flowId, Key: "tempInvoiceId", Value: id.toString() })
                });

                alert("Draft Saved! ID: " + id);
            } catch (err) {
                alert("Error saving draft: " + err.message);
            }
        }

        async function pay() {
            const token = getCookie("auth-token");
            const btn = event.target;
            btn.disabled = true; btn.innerText = "Processing...";

            try {
                const tempId = await getFlowKey("tempInvoiceId");

                const payload = {
                    PiiId: parseInt(await getFlowKey("selectedPiiId")),
                    Items: JSON.parse(await getFlowKey("orderItems")),
                    Payments: JSON.parse(await getFlowKey("payments") || "[]")
                };

                const res = await fetch('/PostInvoice', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ Payload: JSON.stringify(payload), TempId: tempId ? parseInt(tempId) : null })
                });

                if (!res.ok) throw new Error(await res.text());
                const result = await res.json();

                if (!result.success) {
                    alert("Validation Failed.");
                    btn.disabled = false; btn.innerText = "PAY (Post)";
                    run(); // Refresh to see errors
                    return;
                }

                alert("SUCCESS! Invoice Posted.");
                showAccountingResult(result);

            } catch (err) {
                alert("Error: " + err.message);
                btn.disabled = false; btn.innerText = "PAY (Post)";
            }
        }

        function showAccountingResult(result) {
            const contentDiv = document.getElementById('content');
            let html = `<h2>Transaction Complete</h2>`;
            html += s`<p>LP Earned: ${result.loyaltyPointsFinal.toFixed(2)}</p>`;
            html += `<h3>Accounting Entries</h3>`;
            html += `<table class="card"><thead><tr><th>Dr</th><th>Cr</th><th>Amount</th><th>Narrative</th></tr></thead><tbody>`;

            (result.accountingEntries || []).forEach(e => {
                html += s`<tr>
                    <td>${e.debitAccountName} (${e.debitAccount})</td>
                    <td>${e.creditAccountName} (${e.creditAccount})</td>
                    <td>${e.amount.toFixed(2)}</td>
                    <td>${e.narrative}</td>
                </tr>`;
            });
            html += `</tbody></table>`;

            contentDiv.innerHTML = html;
        }

        // --- HELPERS ---
        async function getFlowKey(key) {
            const val = await getFlowKeyRaw(key);
            return val ? JSON.parse(val).value : null;
        }

        async function getFlowKeyRaw(key) {
            const token = getCookie("auth-token");
            const res = await fetch('/GetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: key })
            });
            if (!res.ok) return null;
            return await res.text();
        }

        run();
    </script>
</body>
</html>