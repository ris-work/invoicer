@page "/Pages/Sales/EnterPaymentAmount"
@functions { }

<!DOCTYPE html>
<html>
<head>
    <title>Enter Payment</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
</head>
<body>
    <div class="container">
        <h2>Enter Payment Amount</h2>
        <div id="permWarning" class="perm-warning" style="display:none;"></div>
        <div id="orderBalance" style="margin-bottom: 15px; border: 1px solid #ccc; padding: 10px; border-radius: 4px; background: #fff;">
            <div style="display: flex; justify-content: space-between;">
                <div style="font-size: 1.2em;"><strong>Total:</strong> <span id="totalAmt">0.00</span></div>
                <div style="font-size: 1.2em;">
                    <strong>Remaining:</strong>
                    <span id="remainingAmt" style="color: #d9534f; font-weight: bold;">0.00</span>
                </div>
            </div>
            <div style="margin-top: 5px; font-size: 0.9em; color: #666;">
                Paid so far: <span id="paidAmt">0.00</span>
            </div>
        </div>
        <div id="status">Loading...</div>

        <div id="form" style="display:none;">
            <div class="summary">
                <p><strong>Account:</strong> <span id="dispDebitName">N/A</span> (<span id="dispDebitNo">0</span>)</p>
                <p><strong>Type:</strong> <span id="dispType">CASH</span></p>
            </div>

            <div class="form-group">
                <label>Amount</label>
                <input type="number" id="amount" step="0.01" class="form-control" placeholder="0.00">
            </div>

            <button class="btn btn-success" onclick="save()">Confirm Payment</button>
        </div>
    </div>

    <script src="/Pages/static/u.js"></script>
    <script>
        const requiredEndpoints = ["GetFlowData", "SetFlowData", "SearchAccountsWeb"];
        const params = new URLSearchParams(window.location.search);
        const flowId = params.get('flowId');

        // We might get accNo from URL (Cash/Bank) or we might not (Account)
        const accNoQS = params.get('accNo');
        const typeQS = params.get('type') || 'CASH';

        async function init() {
            await checkPagePermissions(requiredEndpoints);
            const token = await getCookie("auth-token");
            if (!token) { window.location.href = '/Pages/LoginWeb'; return; }
            loadOrderSummary();

            let targetAccNo = accNoQS;
            let targetAccName = null;

            // IF NO ACCOUNT ID PROVIDED, LOOKUP DEFAULTS
            if (targetAccNo === null || targetAccNo === undefined) {
                // 1. Check Flow Data (in case coming from Account Selector)
                const resFlow = await fetch('/GetFlowData', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ FlowId: flowId, Key: "selectedDebitAccountNo" })
                });
                const dataFlow = await resFlow.json();

                if (dataFlow && dataFlow.value) {
                    targetAccNo = dataFlow.value;
                } else {
                    // 2. If still null, ask Backend for Default Terminal Accounts
                    const resTerm = await fetch('/GetTerminalAccounts', {
                        method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                        body: JSON.stringify({}) // Empty request uses MachineName
                    });
                    const termData = await resTerm.json();

                    if (typeQS === 'CASH') {
                        targetAccNo = termData.cashAccountNo;
                        targetAccName = termData.cashAccountName;
                    } else if (typeQS === 'BANK') {
                        targetAccNo = termData.bankAccountNo;
                        targetAccName = termData.bankAccountName;
                    }
                }
            }

            // VALIDATION: Did we get a value at all?
            if (targetAccNo === null || targetAccNo === undefined) {
                 document.getElementById('status').innerHTML = "<span style='color:red'>Error: No Account ID provided and no default found.</span>";
                 return;
            }

            // UI Update
            const dispNo = document.getElementById('dispDebitNo');
            const dispName = document.getElementById('dispDebitName');
            const dispType = document.getElementById('dispType');

            if(dispNo) dispNo.textContent = targetAccNo;
            if(dispType) dispType.textContent = typeQS;

            // Fetch Name only if not already resolved by Terminal Lookup
            if (!targetAccName) {
                try {
                    const resSearch = await fetch('/SearchAccountsWeb', {
                        method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                        body: JSON.stringify({ Query: targetAccNo })
                    });
                    const list = await resSearch.json();
                    const acc = list.find(a => a.accountNo == targetAccNo);
                    if(dispName) dispName.textContent = acc ? acc.accountName : "Unknown Account";
                } catch (e) {
                    if(dispName) dispName.textContent = "Error Loading Name";
                }
            } else {
                if(dispName) dispName.textContent = targetAccName;
            }

            document.getElementById('status').style.display = 'none';
            document.getElementById('form').style.display = 'block';
        }

        async function save() {
            const token = await getCookie("auth-token");
            const amount = parseFloat(document.getElementById('amount').value);

            // READ FROM UI (What You See Is What You Get)
            const accNoStr = document.getElementById('dispDebitNo').textContent;
            const accName = document.getElementById('dispDebitName').textContent;

            const accNo = parseInt(accNoStr);

            // Debug
            console.log("Saving Payment:", { AccountNo: accNo, AccountName: accName, Type: typeQS, Amount: amount });

            if (!amount || amount <= 0) { alert("Invalid amount"); return; }
            if (!accNo || accNo === 0) { alert("Invalid Account ID (0). Did the account load correctly?"); return; }

            const newPayment = {
                AccountNo: accNo,
                AccountName: accName, // PASS NAME EXPLICITLY
                Amount: amount,
                Type: typeQS
            };

            try {
                const resList = await fetch('/GetFlowData', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ FlowId: flowId, Key: "payments" })
                });
                const dataList = await resList.json();
                let list = JSON.parse(dataList.value || "[]");

                list.push(newPayment);

                await fetch('/SetFlowData', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ FlowId: flowId, Key: "payments", Value: JSON.stringify(list) })
                });

                window.location.href = '/Pages/Sales/ReviewBatches?flowId=' + flowId;
            } catch (err) {
                alert("Error saving payment: " + err.message);
            }
        }
                async function loadOrderSummary() {
            const token = await getCookie("auth-token");
            const piiId = await getFlowKey("selectedPiiId");
            const items = JSON.parse(await getFlowKey("orderItems") || "[]");
            const payments = JSON.parse(await getFlowKey("payments") || "[]");

            if (!piiId || items.length === 0) {
                const balanceDiv = document.getElementById('orderBalance');
                if(balanceDiv) balanceDiv.innerHTML = "<em>Add items to see total.</em>";
                return;
            }

            try {
                const res = await fetch('/SimulateSaleWithPayments', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ PiiId: parseInt(piiId), Items: items, Payments: payments })
                });
                const data = await res.json();

                const total = data.grandTotal || 0;
                const paid = data.totalPaid || 0;
                const remaining = total - paid;

                // Update specific elements
                const totalEl = document.getElementById('totalAmt');
                const paidEl = document.getElementById('paidAmt');
                const remainingEl = document.getElementById('remainingAmt');

                if (totalEl) totalEl.innerText = total.toFixed(2);
                if (paidEl) paidEl.innerText = paid.toFixed(2);

                if (remainingEl) {
                    remainingEl.innerText = remaining.toFixed(2);
                    // Color: Red if balance > 0, Green if 0 or less
                    remainingEl.style.color = remaining > 0 ? '#d9534f' : '#5cb85c';
                }

            } catch (e) {
                console.error("Error loading balance", e);
                const balanceDiv = document.getElementById('orderBalance');
                if(balanceDiv) balanceDiv.innerHTML = "<span style='color:red'>Error loading totals</span>";
            }
        }

        // Helper to get Flow Data directly
        async function getFlowKey(key) {
            const token = await getCookie("auth-token");
            const res = await fetch('/GetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: key })
            });
            const data = await res.json();
            return data.value;
        }

        init();
    </script>
</body>
</html>