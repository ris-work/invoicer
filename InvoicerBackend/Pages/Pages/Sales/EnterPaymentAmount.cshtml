@page "/Pages/Sales/EnterPaymentAmount"

@functions { }

<!DOCTYPE html>
<html>
<head>
    <title>Enter Payment</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
</head>
<body>
    <div class="container">
        <h2>Enter Payment Amount</h2>
        <div id="status">Loading...</div>
        <div id="content" style="display:none;">
            <p>Account: <strong id="accName"></strong></p>
            <div class="form-group">
                <label>Amount</label>
                <input type="number" id="amount" step="0.01" class="form-control">
            </div>
            <button class="btn btn-success" onclick="save()">Add Payment</button>
        </div>
    </div>

    <script src="/Pages/static/u.js"></script>
    <script>
        const params = new URLSearchParams(window.location.search);
        const flowId = params.get('flowId');
        function getCookie(n) { const v = `; ${document.cookie}`; const p = v.split(`; ${n}=`); return p.length === 2 ? p.pop().split(';').shift() : null; }

                async function init() {
            await checkPagePermissions(requiredEndpoints);
            const token = await getCookie("auth-token");

            // Check QueryString for Pre-fill (from SelectPaymentMethod)
            const qsAccNo = params.get('accNo');
            const qsType = params.get('type') || 'CASH';

            if (qsAccNo) {
                // Direct Mode (Cash/Bank selected)
                document.getElementById('dispDebitNo').textContent = qsAccNo;

                // Fetch Name for display
                const resSearch = await fetch('/SearchAccountsWeb', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ Query: qsAccNo })
                });
                const list = await resSearch.json();
                const acc = list.find(a => a.accountNo == qsAccNo);

                document.getElementById('dispDebitName').textContent = acc ? acc.accountName : "Account";

                document.getElementById('status').style.display = 'none';
                document.getElementById('form').style.display = 'block';
            } else {
                // Fallback: Manual Selection Flow (Old Logic)
                // ... (Keep existing manual flow logic here if needed)
                document.getElementById('status').innerText = "No account specified.";
            }
        }

                async function save() {
            const token = await getCookie("auth-token");
            const amount = parseFloat(document.getElementById('amount').value);
            if(!amount || amount <= 0) { alert("Invalid amount"); return; }

            const accNo = parseInt(document.getElementById('dispDebitNo').textContent);
            const type = params.get('type') || 'CASH'; // Get type from URL

            const newPayment = {
                AccountNo: accNo,
                Amount: amount,
                Type: type
            };

            // Save to flow
            const dataList = await getFlowKeyRaw("payments");
            let list = JSON.parse(dataList || "[]");
            list.push(newPayment);

            await fetch('/SetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "payments", Value: JSON.stringify(list) })
            });

            window.location.href = '/Pages/Sales/ReviewBatches?flowId=' + flowId;
        }

        init();
    </script>
</body>
</html>