@page "/Pages/Sales/EnterQuantity"

@functions { }

<!DOCTYPE html>
<html>
<head>
    <title>Enter Quantity</title>
    <style>
        body { font-family: sans-serif; padding: 20px; }
        input { padding: 8px; font-size: 1.2em; width: 100px; }
        .btn-group { margin-top: 20px; display: flex; gap: 10px; }
    </style>
</head>
<body>
    <h2>Enter Quantity</h2>
    <div id="summary" style="background:#f0f0f0; padding:10px; margin-bottom:20px;"></div>
    
    <!-- ADDED step="1" -->
    Quantity: <input type="number" id="qty" step="1" value="1">
    
    <div class="btn-group">
        <button class="btn btn-primary" onclick="addToList(true)">Add Another Item</button>
        <button class="btn btn-success" onclick="addToList(false)">Review Order</button>
    </div>

    <script src="/Pages/static/u.js"></script>
    <script>
        const params = new URLSearchParams(window.location.search);
        const flowId = params.get('flowId');
        function getCookie(n) { const v = `; ${document.cookie}`; const p = v.split(`; ${n}=`); return p.length === 2 ? p.pop().split(';').shift() : null; }

        async function loadContext() {
            const token = getCookie("auth-token");
            const keys = ["selectedItemCode", "selectedItemDescription", "selectedPrice", "isManualPrice"];
            const data = {};
            
            for (const key of keys) {
                const res = await fetch('/GetFlowData', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ FlowId: flowId, Key: key })
                });
                data[key] = (await res.json()).value;
            }

            document.getElementById('summary').innerHTML = s`
                <strong>Item:</strong> ${data.selectedItemDescription || data.selectedItemCode}<br>
                <strong>Price:</strong> ${data.selectedPrice || 'Standard'} ${data.isManualPrice === 'true' ? '(Manual)' : ''}
            `;
        }

        async function addToList(addMore) {
            const token = getCookie("auth-token");
            const qty = parseFloat(document.getElementById('qty').value);
            if (!qty || qty <= 0) { alert("Invalid quantity."); return; }

            // Get Current List
            const resList = await fetch('/GetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "orderItems" })
            });
            const dataList = await resList.json();
            let list = JSON.parse(dataList.value || "[]");

            // Get Item Details
            const itemCodeRes = await fetch('/GetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "selectedItemCode" })
            });
            const priceRes = await fetch('/GetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "selectedPrice" })
            });
            const manualRes = await fetch('/GetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "isManualPrice" })
            });

            const itemCode = (await itemCodeRes.json()).value;
            const price = (await priceRes.json()).value;
            const manual = (await manualRes.json()).value;

            list.push({
                ItemCode: parseInt(itemCode),
                Quantity: qty,
                TargetPrice: price ? parseFloat(price) : null,
                IsManualPrice: manual === 'true'
            });

            await fetch('/SetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "orderItems", Value: JSON.stringify(list) })
            });

            if (addMore) {
                window.location.href = '/Pages/SearchAndSelect/ItemSelect?flowId=' + flowId;
            } else {
                window.location.href = '/Pages/Sales/ReviewBatches?flowId=' + flowId;
            }
        }

        loadContext();
    </script>
</body>
</html>