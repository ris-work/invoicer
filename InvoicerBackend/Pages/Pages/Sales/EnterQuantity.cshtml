@page "/Pages/Sales/EnterQuantity"

@*
  FLOW: Sales Simulation
  STEP: 4 (Quantity Input)
  SETS: selectedQuantity
*@

@functions { }

<!DOCTYPE html>
<html>
<head>
    <title>Enter Quantity</title>
    <style>
        body {
            font-family: sans-serif;
            padding: 20px;
        }

        input {
            padding: 8px;
            font-size: 1.2em;
        }
    </style>
</head>
<body>
    <h2>Enter Quantity</h2>
    <input type="number" id="qty" placeholder="Quantity" step="0.01">
    <button onclick="save()">Next</button>

    <script>
        const params = new URLSearchParams(window.location.search);
        const flowId = params.get('flowId');
        function getCookie(n) { const v = `; ${document.cookie}`; const p = v.split(`; ${n}=`); return p.length === 2 ? p.pop().split(';').shift() : null; }

        async function save() {
            const token = getCookie("auth-token");
            const qty = document.getElementById('qty').value;
            if (!qty) return;

            await fetch('/SetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "selectedQuantity", Value: qty })
            });

            window.location.href = '/Pages/Sales/ReviewBatches?flowId=' + flowId;
        }
    </script>
</body>
</html>