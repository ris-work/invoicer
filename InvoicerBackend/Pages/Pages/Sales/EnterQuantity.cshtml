@page "/Pages/Sales/EnterQuantity"

@*
  FLOW: Sales Simulation
  STEP: 4 (Quantity Input)
  SETS: selectedQuantity
*@

@functions { }
<!DOCTYPE html>
<html>
<head>
    <title>Enter Quantity</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
</head>
<body>
    <div class="container">
        <h2>Enter Quantity</h2>
        <div id="permWarning" class="perm-warning" style="display:none;"></div>

        <div class="form-group">
            <input type="number" id="qty" placeholder="Quantity" step="0.01" class="input-lg">
        </div>
        <button class="btn btn-primary" onclick="save()">Next</button>
    </div>

    <script src="/Pages/static/u.js"></script>
    <script>
        const requiredEndpoints = ["SetFlowData"];
        const params = new URLSearchParams(window.location.search);
        const flowId = params.get('flowId');

        async function init() {
            await checkPagePermissions(requiredEndpoints);
        }

        async function save() {
            const token = await getCookie("auth-token");
            const qty = document.getElementById('qty').value;
            if (!qty) return;

            await fetch('/SetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "selectedQuantity", Value: qty })
            });

            window.location.href = '/Pages/Sales/ReviewBatches?flowId=' + flowId;
        }

        init();
    </script>
</body>
</html>