@page "/Pages/SearchAndSelect/AccountSelect"

@*
  ====================================================================
  FLOW: Generic Selector (Account)
  ====================================================================
  PURPOSE:
  Allows user to search and select a GL Account. Used for Journal Entries, 
  Payment Methods, etc.

  FLOW VARIABLES:
  - SETS: selectedAccountNo (long), selectedAccountName (string)
  - READS: flowId, redirTo (Query String)

  REDIRECTION:
  - On selection or 'Proceed', redirects to URL provided in 'redirTo'.
  - 'redirTo' must be URL encoded if it contains parameters.
  ====================================================================
*@

@functions { }

<!DOCTYPE html>
<html>
<head>
    <title>Select Account</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
    <style>
        .current-bar {
            background: #e3f2fd;
            padding: 10px;
            margin-bottom: 20px;
            border-radius: 5px;
            border: 1px solid #90caf9;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>Select Account</h2>
        <div id="permWarning" class="perm-warning" style="display:none;"></div>

        <!-- Current Selection Bar -->
        <div id="currentBar" style="display:none;" class="current-bar">
            <div>
                <strong>Current:</strong> <span id="currentName"></span> (<span id="currentId"></span>)
            </div>
            <button class="btn btn-primary" onclick="proceedWithCurrent()">Proceed</button>
        </div>

        <div class="form-group">
            <input type="text" id="query" class="form-control" placeholder="Search Account Name or No..." oninput="search()">
        </div>

        <div id="results" class="result-box">Start typing to search...</div>
    </div>

    <script src="/Pages/static/u.js"></script>
    <script>
        const requiredEndpoints = ["GetFlowData", "SetFlowData", "SearchAccountsWeb"];
        const params = new URLSearchParams(window.location.search);
        const flowId = params.get('flowId');
        const redirTo = params.get('redirTo');

        async function init() {
            await checkPagePermissions(requiredEndpoints);
            const token = await getCookie("auth-token");

            if (!flowId) {
                document.getElementById('results').innerHTML = "<p class='warning'>Error: FlowId missing.</p>";
                return;
            }

            // Check if already set
            const resId = await fetch('/GetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "selectedAccountNo" })
            });
            const dataId = await resId.json();

            if (dataId.value) {
                const resName = await fetch('/GetFlowData', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ FlowId: flowId, Key: "selectedAccountName" })
                });
                const dataName = await resName.json();

                document.getElementById('currentId').innerText = dataId.value;
                document.getElementById('currentName').innerText = dataName.value || "Unknown";
                document.getElementById('currentBar').style.display = 'flex';
            }
        }

        async function search() {
            const token = await getCookie("auth-token");
            const q = document.getElementById('query').value;

            if (!q) {
                document.getElementById('results').innerHTML = "Start typing to search...";
                return;
            }

            try {
                const res = await fetch('/SearchAccountsWeb', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ Query: q })
                });

                if (!res.ok) throw new Error("Search failed");
                const data = await res.json();
                const resultsDiv = document.getElementById('results');

                if (!data || data.length === 0) {
                    resultsDiv.innerHTML = "<p>No accounts found.</p>";
                    return;
                }

                let html = "";
                data.forEach(a => {
                    // Using he() for safety inside onclick string generation
                    const safeName = he(a.accountName);
                    html += s`<div class="card" onclick="select(${a.accountNo}, '${safeName}')">
                        <strong>${a.accountName}</strong> (ID: ${a.accountNo})<br>
                        <small>Type: ${a.accountType}</small>
                    </div>`;
                });
                resultsDiv.innerHTML = html;
            } catch (err) {
                document.getElementById('results').innerHTML = s`<p class="warning">Error: ${err.message}</p>`;
            }
        }

        async function select(id, name) {
            const token = await getCookie("auth-token");

            await fetch('/SetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "selectedAccountNo", Value: id.toString() })
            });
            await fetch('/SetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "selectedAccountName", Value: name })
            });

            proceed();
        }

        async function proceedWithCurrent() {
            proceed();
        }

        function proceed() {
            if (redirTo) {
                window.location.href = redirTo;
            } else {
                alert("Error: No redirect target specified.");
            }
        }

        init();
    </script>
</body>
</html>