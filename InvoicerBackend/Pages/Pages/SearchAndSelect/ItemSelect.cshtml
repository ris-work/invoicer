@page "/Pages/SearchAndSelect/ItemSelect"

@*
  FLOW: Generic Selector (Item)
  STEP: 2 (Selector)
  SETS: selectedItemCode, selectedItemDescription
  READS: flowId, FlowSteps, selectedItemCode
  REDIRECTS: Next step in FlowSteps or [redirTo] (fallback)

  SUMMARY:
  1. Checks if 'selectedItemCode' is already set. Shows "Current: [Code] - [Desc]".
  2. Handles Barcode scanning (auto-redirects if match found).
  3. Handles text search.
  4. Uses 'navigateNext' for flow control.
*@

@functions {
}

<!DOCTYPE html>
<html>
<head>
    <title>Select Item</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            font-family: sans-serif;
            padding: 20px;
        }

        input {
            width: 100%;
            padding: 8px;
            margin-bottom: 10px;
            box-sizing: border-box;
        }

        .result-card {
            border: 1px solid #ddd;
            padding: 10px;
            margin-bottom: 10px;
            cursor: pointer;
        }

            .result-card:hover {
                background: #f0f0f0;
            }

        .error {
            color: red;
            font-weight: bold;
        }

        /* Current Selection Bar Styles */
        .current-bar {
            background: #e3f2fd;
            padding: 10px;
            margin-bottom: 20px;
            border-radius: 5px;
            border: 1px solid #90caf9;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .current-bar button {
                padding: 5px 10px;
                cursor: pointer;
                background: #1976d2;
                color: white;
                border: none;
                border-radius: 3px;
            }
    </style>
</head>
<body>
    <h2>Select an Item</h2>

    <!-- Current Selection Bar -->
    <div id="currentBar" style="display:none;" class="current-bar">
        <div>
            <strong>Current:</strong> <span id="currentItemDisplay"></span>
        </div>
        <button onclick="proceedWithCurrent()">Proceed with Current</button>
    </div>

    <div id="errorBox" class="error" style="display:none;"></div>

    <div id="content">
        <input type="text" id="searchQuery" placeholder="Search name or scan barcode...">
        <div id="results"></div>
    </div>

    <script>
        const params = new URLSearchParams(window.location.search);
        const flowId = params.get('flowId');
        const redirTo = params.get('redirTo');

        if (!flowId) {
            document.getElementById('errorBox').innerText = "Error: Invalid Flow. No Flow ID.";
            document.getElementById('errorBox').style.display = 'block';
            document.getElementById('content').style.display = 'none';
        }

        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
        }

        async function init() {
            const token = getCookie("auth-token");

            // Check if already set
            const resId = await fetch('/GetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "selectedItemCode" })
            });
            const dataId = await resId.json();

            if (dataId.value) {
                const resDesc = await fetch('/GetFlowData', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ FlowId: flowId, Key: "selectedItemDescription" })
                });
                const dataDesc = await resDesc.json();

                document.getElementById('currentItemDisplay').innerText = `${dataId.value} - ${dataDesc.value || 'No Desc'}`;
                document.getElementById('currentBar').style.display = 'flex';
            }
        }

        let debounceTimer;
        document.getElementById('searchQuery').addEventListener('input', function(e) {
            clearTimeout(debounceTimer);
            const query = e.target.value;
            debounceTimer = setTimeout(() => { handleInput(query); }, 300);
        });

        async function handleInput(query) {
            const token = getCookie("auth-token");
            const resultsDiv = document.getElementById('results');

            if (!query) { resultsDiv.innerHTML = ""; return; }
            resultsDiv.innerHTML = "Checking...";

            try {
                // 1. Try Barcode
                const barcodeRes = await fetch('/ResolveBarcode', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify(query)
                });

                if (barcodeRes.ok) {
                    const barcodeData = await barcodeRes.json();
                    if (barcodeData.found && barcodeData.itemCode) {
                        resultsDiv.innerHTML = "<p>Barcode found! Redirecting...</p>";

                        // We might not have the description from barcode scan, set a placeholder or fetch it
                        await select(barcodeData.itemCode, "Scanned Item", barcodeData.batchCode);
                        return;
                    }
                }

                // 2. Search Catalogue
                resultsDiv.innerHTML = "Searching...";
                const searchRes = await fetch('/SearchCatalogueWeb', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ Query: query })
                });

                if (!searchRes.ok) return;
                const items = await searchRes.json();

                resultsDiv.innerHTML = items.map(i => `
                    <div class="result-card" onclick="select(${i.itemcode}, '${(i.description || 'No Desc').replace(/'/g, "\\'")}')">
                        <strong>${i.itemcode}</strong>: ${i.description || 'No Desc'}
                    </div>
                `).join('');

            } catch (err) { console.error(err); resultsDiv.innerHTML = "Error searching."; }
        }

        async function select(itemCode, description, batchCode = null) {
            const token = getCookie("auth-token");

            await fetch('/SetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "selectedItemCode", Value: itemCode.toString() })
            });
            await fetch('/SetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "selectedItemDescription", Value: description })
            });

            // Logic for Batch Edit shortcut
            if (batchCode && redirTo && redirTo.includes("Batches/Edit")) {
                 window.location.href = redirTo + "?flowId=" + flowId + "&batchCode=" + batchCode;
            } else {
                 await navigateNext();
            }
        }

        async function proceedWithCurrent() {
            await navigateNext();
        }

        async function navigateNext() {
            const token = getCookie("auth-token");
            const res = await fetch('/GetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "FlowSteps" })
            });
            const data = await res.json();

            if (data.value) {
                const steps = JSON.parse(data.value);
                let currentIndex = parseInt(await getCurrentStepIndex(token));

                currentIndex++;
                if (currentIndex < steps.length) {
                    await fetch('/SetFlowData', {
                        method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                        body: JSON.stringify({ FlowId: flowId, Key: "FlowStepIndex", Value: currentIndex.toString() })
                    });
                    window.location.href = steps[currentIndex] + "?flowId=" + flowId;
                    return;
                }
            }

            if(redirTo) window.location.href = redirTo + "?flowId=" + flowId;
        }

        async function getCurrentStepIndex(token) {
            const res = await fetch('/GetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "FlowStepIndex" })
            });
            const data = await res.json();
            return data.value || "0";
        }

        init();
    </script>
</body>
</html>