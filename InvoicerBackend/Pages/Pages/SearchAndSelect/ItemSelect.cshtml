@page "/Pages/SearchAndSelect/ItemSelect"

@functions {
}

<!DOCTYPE html>
<html>
<head>
    <title>Select Item</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            font-family: sans-serif;
            padding: 20px;
        }

        input {
            width: 100%;
            padding: 8px;
            margin-bottom: 10px;
            box-sizing: border-box;
        }

        .result-card {
            border: 1px solid #ddd;
            padding: 10px;
            margin-bottom: 10px;
            cursor: pointer;
        }

            .result-card:hover {
                background: #f0f0f0;
            }

        .error {
            color: red;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <h2>Select an Item</h2>
    <div id="errorBox" class="error" style="display:none;"></div>

    <div id="content" style="display:none;">
        <input type="text" id="searchQuery" placeholder="Search name or scan barcode...">
        <div id="results"></div>
    </div>

    <script>
        const params = new URLSearchParams(window.location.search);
        const flowId = params.get('flowId');
        const redirTo = params.get('redirTo');

        // Strict Check: Flow must be initialized
        if (!flowId || !redirTo) {
            document.getElementById('errorBox').innerText = "Error: Invalid Flow. No Flow ID or Redirect target specified.";
            document.getElementById('errorBox').style.display = 'block';
        } else {
            document.getElementById('content').style.display = 'block';
        }

        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
        }

        let debounceTimer;
        document.getElementById('searchQuery').addEventListener('input', function(e) {
            clearTimeout(debounceTimer);
            const query = e.target.value;

            // Debounce to prevent searching while scanning
            debounceTimer = setTimeout(() => {
                handleInput(query);
            }, 300);
        });

        async function handleInput(query) {
            const token = getCookie("auth-token");
            const resultsDiv = document.getElementById('results');

            if (!query) { resultsDiv.innerHTML = ""; return; }
            resultsDiv.innerHTML = "Checking...";

            try {
                // 1. Try to resolve as Barcode
                const barcodeRes = await fetch('/ResolveBarcode', {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify(query)
                });

                if (barcodeRes.ok) {
                    const barcodeData = await barcodeRes.json();

                    if (barcodeData.found && barcodeData.itemCode) {
                        resultsDiv.innerHTML = "<p>Barcode found! Redirecting...</p>";

                        // Set Flow Data
                        await fetch('/SetFlowData', {
                            method: 'POST',
                            headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                            body: JSON.stringify({ FlowId: flowId, Key: "selectedItemCode", Value: barcodeData.itemCode.toString() })
                        });

                        // Redirect Logic
                        // If redirTo is Batch Edit AND we have a specific batch code, go directly to it
                        if (barcodeData.batchCode && redirTo.includes("Batches/Edit")) {
                            window.location.href = redirTo + "?flowId=" + flowId + "&batchCode=" + barcodeData.batchCode;
                        } else {
                            // Otherwise just go to the default redirect (e.g. Batch List for Item)
                            window.location.href = redirTo + "?flowId=" + flowId;
                        }
                        return; // Stop execution here
                    }
                }

                // 2. Fallback to Catalogue Search
                resultsDiv.innerHTML = "Searching...";
                const searchRes = await fetch('/SearchCatalogueWeb', {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ Query: query })
                });

                if (!searchRes.ok) return;
                const items = await searchRes.json();

                resultsDiv.innerHTML = items.map(i => `
                    <div class="result-card" onclick="selectItem(${i.itemcode})">
                        <strong>${i.itemcode}</strong>: ${i.description || 'No Desc'}
                    </div>
                `).join('');

            } catch (err) {
                console.error(err);
                resultsDiv.innerHTML = "Error searching.";
            }
        }

        async function selectItem(itemCode) {
            const token = getCookie("auth-token");

            try {
                // Set Flow Data
                const setRes = await fetch('/SetFlowData', {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ FlowId: flowId, Key: "selectedItemCode", Value: itemCode.toString() })
                });

                if (!setRes.ok) {
                    alert("Failed to save selection.");
                    return;
                }

                // Redirect
                window.location.href = redirTo + "?flowId=" + flowId;
            } catch (err) {
                console.error(err);
            }
        }
    </script>
</body>
</html>