@page "/Pages/Accounts/LiveView"
@functions { }
<!DOCTYPE html>
<html>
<head>
    <title>Accounts Live View</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
</head>
<body>
    <h2>Accounts Live View</h2>
    <div id="permWarning" class="perm-warning" style="display:none;"></div>
    <p><small>Auto-refreshes every 30 seconds.</small></p>

    <div class="filter-bar">
        <div class="filter-row">
            <div class="filter-group">
                <label>Journal Type</label>
                <select id="filterJournal"><option value="">All Journals</option><option value="1">General</option></select>
            </div>
            <div class="filter-group">
                <label>Account No</label>
                <input type="number" id="filterAccount" placeholder="e.g. 101">
            </div>
        </div>
        <div class="filter-row">
            <div class="filter-group"><label>From</label><input type="date" id="filterFrom"></div>
            <div class="filter-group"><label>To</label><input type="date" id="filterTo"></div>
            <div class="filter-group" style="justify-content: flex-end;">
                <button class="btn btn-primary" onclick="loadData()">Apply Filter</button>
            </div>
        </div>
    </div>

    <div id="tableContainer">Loading...</div>

    <script src="/Pages/static/u.js"></script>
    <script>
        const requiredEndpoints = ["SearchJournalEntriesWeb"];

        function renderTable(data) {
            if (!data || data.length === 0) return "<p>No records found.</p>";
            let html = "<table><thead><tr><th>Date</th><th>Description</th><th>Debit</th><th>Credit</th><th>Amount</th><th>Ref</th></tr></thead><tbody>";
            data.forEach(row => {
                const date = new Date(row.timeTai).toLocaleString();
                html += s`<tr>
                    <td>${date}</td><td>${row.description || ''}</td>
                    <td>${row.debitAccountName || row.debitAccountNo}</td>
                    <td>${row.creditAccountName || row.creditAccountNo}</td>
                    <td style="text-align:right;">${row.amount.toFixed(2)}</td>
                    <td>${row.refNo || ''}</td>
                </tr>`;
            });
            html += "</tbody></table>";
            return html;
        }

        async function loadData() {
            const token = await getCookie("auth-token");
            const container = document.getElementById('tableContainer');
            if (!token) { window.location.href = '/Pages/LoginWeb'; return; }

            const payload = {};
            const journalNo = document.getElementById('filterJournal').value;
            const accountNo = document.getElementById('filterAccount').value;
            const from = document.getElementById('filterFrom').value;
            const to = document.getElementById('filterTo').value;

            if (journalNo) payload.JournalNo = parseInt(journalNo);
            if (accountNo) payload.AccountNo = parseInt(accountNo);
            if (from) payload.From = new Date(from).toISOString();
            if (to) payload.To = new Date(to).toISOString();

            try {
                container.innerHTML = "Fetching...";
                const res = await fetch('/SearchJournalEntriesWeb', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (res.status === 401 || res.status === 403) { window.location.href = '/Pages/LoginWeb'; return; }
                if (!res.ok) throw new Error(await res.text());

                container.innerHTML = renderTable(await res.json());
            } catch (err) { container.innerHTML = s`<p style="color:red;">Error: ${err.message}</p>`; }
        }

        checkPagePermissions(requiredEndpoints);
        loadData();
        setInterval(loadData, 30000);
    </script>
</body>
</html>