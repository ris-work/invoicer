@page "/Pages/DumpAuth"
@functions {
    public string FoundToken { get; set; } = "Checking...";
}
<!DOCTYPE html>
<html>
<head>
    <title>Dump Auth & Test API</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/Pages/static/u.css">
</head>
<body>
    <h1>Dump Auth & Test API</h1>
    <p><strong>Server says:</strong> @FoundToken</p>

    <button onclick="testAuthenticatedEcho()" class="btn btn-primary">Call /BearerEcho (POST)</button>

    <div id="result" class="result-box" style="min-height: 50px;">
        <em>Click button to test...</em>
    </div>

    <div style="margin-top: 20px; padding-top: 20px; border-top: 1px solid #eee;">
        <a href="/Pages/Docs/Index" class="btn btn-success">Back to List</a>
        <a href="/Pages/Docs/Search" class="btn btn-secondary">Search</a>
        <a href="/Pages/Docs/Add" class="btn btn-primary">Add New</a>
    </div>

    <script src="/Pages/static/u.js"></script>
    <script>
        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
        }

        async function testAuthenticatedEcho() {
            const token = getCookie("auth-token");
            const display = document.getElementById("result");

            if (!token) {
                display.innerHTML = "Error: No 'auth-token' cookie found.";
                return;
            }

            display.innerHTML = "Sending POST request to /BearerEcho...";

            try {
                const response = await fetch('/BearerEcho', {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({})
                });

                if (response.ok) {
                    const data = await response.json();
                    display.innerHTML = s`
                        <div style="color: green;"><strong>Success (200 OK)</strong></div>
                        <pre>${JSON.stringify(data, null, 2)}</pre>
                    `;
                } else {
                    const errorText = await response.text();
                    display.innerHTML = s`<div style="color: red;"><strong>Error ${response.status}</strong><br>${errorText}</div>`;
                }
            } catch (err) {
                display.innerHTML = s`<div style="color: red;">Network Error: ${err}</div>`;
            }
        }
    </script>
</body>
</html>