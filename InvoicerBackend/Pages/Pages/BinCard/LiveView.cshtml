@page "/Pages/BinCard/LiveView"
@functions { }
<!DOCTYPE html>
<html>
<head>
    <title>Bin Card Live View</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
</head>
<body>
    <h2>Bin Card Live View</h2>
    <div id="permWarning" class="perm-warning" style="display:none;"></div>
    <p><small>Auto-refreshes every 30 seconds.</small></p>

    <div class="filter-bar">
        <div class="filter-row">
            <div class="filter-group filter-combo" style="min-width: 200px;">
                <label>Filter by Tag</label>
                <select id="tagDropdown" onchange="syncTagInput()"><option value="">All Tags</option></select>
                <input type="text" id="tagInput" list="tagDatalist" placeholder="Or type..." oninput="syncTagDropdown()">
                <datalist id="tagDatalist"></datalist>
            </div>
            <div class="filter-group"><label>Item Code</label><input type="number" id="filterItem"></div>
            <div class="filter-group"><label>Batch Code</label><input type="number" id="filterBatch"></div>
            <div class="filter-group" style="justify-content: flex-end;"><button class="btn btn-primary" onclick="loadData()">Apply</button></div>
        </div>
    </div>

    <div id="tableContainer">Loading...</div>

    <script src="/Pages/static/u.js"></script>
    <script>
        const requiredEndpoints = ["GetAllTags", "SearchBinCardWeb"];

        function syncTagInput() { if (document.getElementById('tagDropdown').value) document.getElementById('tagInput').value = document.getElementById('tagDropdown').value; }
        function syncTagDropdown() { /* logic unchanged */ }

        function renderTable(data) {
            if (!data || data.length === 0) return "<p>No records.</p>";
            let html = "<table><thead><tr><th>Time</th><th>Item</th><th>Batch</th><th>Change</th><th>Balance</th><th>Ref</th><th>Remarks</th></tr></thead><tbody>";
            data.forEach(row => {
                const date = new Date(row.enteredTime).toLocaleString();
                const change = row.toUnits - row.fromUnits;
                const changeStr = change >= 0 ? `+${change.toFixed(2)}` : change.toFixed(2);
                html += s`<tr>
                    <td>${date}</td><td>${row.itemcode}</td><td>${row.batchcode}</td>
                    <td style="color:${change >= 0 ? 'green' : 'red'};">${changeStr}</td>
                    <td>${row.units.toFixed(2)}</td><td>${row.reference || ''}</td><td>${row.remarks || ''}</td>
                </tr>`;
            });
            return html + "</tbody></table>";
        }

        async function init() {
            const token = await getCookie("auth-token");
            if (!token) { window.location.href = '/Pages/LoginWeb'; return; }
            const res = await fetch('/GetAllTags', { method: 'POST', headers: { 'Authorization': `Bearer ${token}` }, body: JSON.stringify({}) });
            if (res.status === 401 || res.status === 403) { window.location.href = '/Pages/LoginWeb'; return; }
            const tags = await res.json();
            const select = document.getElementById('tagDropdown');
            select.innerHTML = '<option value="">All Tags</option>' + tags.map(t => s`<option value="${t.tag}">${t.tag}</option>`).join('');
            document.getElementById('tagDatalist').innerHTML = tags.map(t => s`<option value="${t.tag}">`).join('');
            loadData();
        }

        async function loadData() {
            const token = await getCookie("auth-token");
            const container = document.getElementById('tableContainer');
            if (!token) return;

            const tag = document.getElementById('tagDropdown').value || document.getElementById('tagInput').value;
            const item = document.getElementById('filterItem').value;
            const batch = document.getElementById('filterBatch').value;
            const payload = {};
            if (tag) payload.Tags = [tag];
            if (item) payload.ItemCode = parseInt(item);
            if (batch) payload.BatchCode = parseInt(batch);

            container.innerHTML = "Fetching...";
            const res = await fetch('/SearchBinCardWeb', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            if (!res.ok) container.innerHTML = "<p>Error</p>";
            else container.innerHTML = renderTable(await res.json());
        }

        checkPagePermissions(requiredEndpoints);
        init();
        setInterval(loadData, 30000);
    </script>
</body>
</html>