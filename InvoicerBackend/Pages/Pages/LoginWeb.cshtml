@page "/Pages/LoginWeb"
@functions { }
<!DOCTYPE html>
<html>
<head>
    <title>Login</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
</head>
<body>
    <h1>Login</h1>
    <div class="card" style="max-width: 400px;">
        <form id="loginForm" onsubmit="doLogin(event)">
            <div style="margin-bottom: 10px;">
                <label><strong>User:</strong></label><br />
                <input type="text" id="User" name="User" required />
            </div>
            <div style="margin-bottom: 10px;">
                <label><strong>Password:</strong></label><br />
                <input type="password" id="Password" name="Password" required />
            </div>
            <div style="margin-bottom: 10px;">
                <label><strong>Terminal:</strong></label><br />
                <input type="text" id="Terminal" name="Terminal" value="WebClient" />
            </div>
            <div style="margin-bottom: 10px;">
                <label><strong>TOTP (Optional):</strong></label><br />
                <input type="text" id="TOTP" name="TOTP" placeholder="123456" />
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%;">Login</button>
        </form>
        <div id="statusMessage" style="margin-top: 15px; font-weight: bold;"></div>
        <div id="rawOutput" class="result-box" style="display: none; font-family: monospace; word-break: break-all;"></div>
    </div>

    <script src="/Pages/static/u.js"></script>
    <script>
        async function doLogin(e) {
            e.preventDefault();
            const user = document.getElementById('User').value;
            const password = document.getElementById('Password').value;
            const terminal = document.getElementById('Terminal').value;
            const totp = document.getElementById('TOTP').value;
            const statusDiv = document.getElementById('statusMessage');
            const rawDiv = document.getElementById('rawOutput');

            const payload = { User: user, Password: password, Terminal: terminal, TOTP: totp || null };

            statusDiv.innerText = "Logging in...";
            statusDiv.style.color = "blue";
            rawDiv.style.display = "none";

            try {
                const response = await fetch('/Login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();

                if (!response.ok || data.error) {
                    statusDiv.innerText = "Error: " + (data.error || response.statusText);
                    statusDiv.style.color = "red";
                } else {
                    const loginTokenObject = {
                        TokenID: data.tokenID,
                        Token: data.token,
                        SecretToken: data.secretToken,
                        Error: data.error
                    };

                    const jsonString = JSON.stringify(loginTokenObject);
                    const base64Token = btoa(jsonString);

                    rawDiv.style.display = "block";
                    rawDiv.innerText = "Generated Bearer Token (Base64):\n" + base64Token;

                    document.cookie = `auth-token=${base64Token}; path=/`;

                    statusDiv.innerText = "Login Successful! Redirecting...";
                    statusDiv.style.color = "green";

                    setTimeout(() => { window.location.href = "/Pages/DumpAuth"; }, 1000);
                }
            } catch (err) {
                console.error(err);
                statusDiv.innerText = "Network Error.";
                statusDiv.style.color = "red";
            }
        }
    </script>
</body>
</html>