@page "/Pages/Docs/Index"

@functions {
    public string ErrorMessage { get; set; } = "";
}

<!DOCTYPE html>
<html>
<head>
    <title>Documents</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            font-family: sans-serif;
            padding: 20px;
        }

        .doc-card {
            border: 1px solid #ddd;
            padding: 15px;
            margin-bottom: 15px;
            border-radius: 5px;
            background: #fff;
        }

        .doc-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .doc-title {
            font-weight: bold;
            font-size: 1.1em;
            flex-grow: 1;
        }

        .doc-meta {
            font-size: 0.9em;
            color: #666;
            margin-top: 5px;
        }

        .doc-image {
            max-width: 100%;
            max-height: 300px;
            margin-top: 10px;
            border: 1px solid #eee;
            display: block;
        }

        .btn {
            padding: 6px 12px;
            text-decoration: none;
            color: white;
            border-radius: 4px;
            border: none;
            cursor: pointer;
            font-size: 0.9em;
        }

        .btn-primary {
            background: #007bff;
        }

        .btn-success {
            background: #28a745;
        }

        .btn-warning {
            background: #ffc107;
            color: #000;
        }

        .btn-secondary {
            background: #6c757d;
        }

        .transcription-area {
            margin-top: 10px;
            width: 100%;
            height: 200px;
            display: none;
            font-family: sans-serif;
            font-size: 0.95em;
            padding: 10px;
            border: 1px solid #ccc;
            background: #f9f9f9;
            resize: vertical;
            white-space: pre-wrap;
        }

            .transcription-area.json-mode {
                font-family: monospace;
                font-size: 0.85em;
            }

        .transcription-controls {
            margin-top: 5px;
            display: none;
            gap: 10px;
        }

        .transcription-list {
            margin-top: 10px;
        }

        .transcription-item {
            margin-bottom: 5px;
            font-size: 0.9em;
        }

            .transcription-item a {
                color: #007bff;
                cursor: pointer;
                text-decoration: underline;
            }
    </style>
</head>
<body>
    <h1>Latest Documents</h1>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <p style="color: red;">@ErrorMessage</p>
    }

    <div id="docList">Loading...</div>

    <div style="margin-top: 20px; padding-top: 20px; border-top: 1px solid #eee;">
        <a href="/Pages/Docs/Add" class="btn btn-primary">Add New</a> |
        <a href="/Pages/Docs/Search" class="btn btn-success">Search</a>
    </div>

    <script>
        // Store current transcription indices globally
        window.currentTranscriptionIndices = {};

        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
        }

        async function loadDocs() {
            const token = getCookie("auth-token");
            const listDiv = document.getElementById('docList');

            if (!token) {
                window.location.href = '/Pages/LoginWeb';
                return;
            }

            // Check for specific ID in query string
            const params = new URLSearchParams(window.location.search);
            const targetId = params.get('id');

            try {
                const response = await fetch('/GetDocuments', {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({})
                });

                if (!response.ok) throw new Error(`Error ${response.status}`);

                const docs = await response.json();

                if (docs.length === 0) {
                    listDiv.innerHTML = "<p>No documents found.</p>";
                    return;
                }

                // Logic: If ID is present, show only that doc. Otherwise show list.
                let docsToRender = docs;
                if (targetId) {
                    const found = docs.find(d => d.refId == targetId);
                    if (found) {
                        docsToRender = [found];
                    } else {
                        listDiv.innerHTML = `<p>Document with ID ${targetId} not found in recent documents.</p>`;
                        return;
                    }
                }

                let html = '';
                docsToRender.forEach(doc => {
                    const date = new Date(doc.createdAt).toLocaleString();
                    const transAreaId = `trans-${doc.refId}`;
                    const transListId = `list-${doc.refId}`;
                    const transControlsId = `ctrl-${doc.refId}`;

                    html += `
                        <div class="doc-card" id="card-${doc.refId}">
                            <div class="doc-header">
                                <div class="doc-title">${doc.refText || 'Untitled'}</div>
                                <div>
                                    <button class="btn btn-warning" onclick="retranscribe(${doc.refId})">Retranscribe</button>
                                    <button class="btn btn-primary" onclick="toggleTranscriptions(${doc.refId})">View Transcriptions</button>
                                </div>
                            </div>
                            <div class="doc-meta">ID: ${doc.refId} | Created: ${date}</div>

                            <img src="data:image/jpeg;base64,${doc.refImage}" class="doc-image" alt="Document Image" />

                            <div id="${transListId}" class="transcription-list" style="display:none;"></div>

                            <div id="${transControlsId}" class="transcription-controls">
                                <button class="btn btn-secondary" id="btn-toggle-${doc.refId}" onclick="toggleJson(${doc.refId})">Show JSON</button>
                            </div>
                            <textarea id="${transAreaId}" class="transcription-area" readonly data-mode="content"></textarea>
                        </div>
                    `;
                });
                listDiv.innerHTML = html;

                // If a specific ID was requested, automatically open its transcriptions
                if (targetId && docsToRender.length > 0) {
                    await toggleTranscriptions(parseInt(targetId));
                }

            } catch (err) {
                listDiv.innerHTML = `<p style="color: red;">Failed to load documents: ${err.message}</p>`;
                console.error(err);
            }
        }

        async function retranscribe(refId) {
            const token = getCookie("auth-token");
            if (!token) { window.location.href = '/Pages/LoginWeb'; return; }

            const card = document.getElementById(`card-${refId}`);
            const statusId = `status-${refId}`;

            const existingStatus = document.getElementById(statusId);
            if (existingStatus) existingStatus.remove();

            const status = document.createElement('div');
            status.id = statusId;
            status.innerText = "Transcribing...";
            status.style.color = "blue";
            status.style.marginTop = "10px";
            card.appendChild(status);

            try {
                const payload = {
                    RefDoc: refId,
                    TranscriberLlmName: "z-ai/glm-4.6v"
                };

                const response = await fetch('/ReTranscribeRefDoc', {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                if (!response.ok) {
                    const err = await response.text();
                    throw new Error(err);
                }

                const result = await response.json();

                const statusEl = document.getElementById(statusId);
                if (statusEl) statusEl.remove();

                loadTranscriptions(refId);
                alert("Transcription complete!");

            } catch (err) {
                const statusEl = document.getElementById(statusId);
                if (statusEl) {
                    statusEl.innerText = "Error: " + err.message;
                    statusEl.style.color = "red";
                }
                console.error(err);
            }
        }

        async function toggleTranscriptions(refId) {
            const listDiv = document.getElementById(`list-${refId}`);
            const textArea = document.getElementById(`trans-${refId}`);
            const controlsDiv = document.getElementById(`ctrl-${refId}`);

            if (listDiv.style.display === 'block') {
                listDiv.style.display = 'none';
                textArea.style.display = 'none';
                controlsDiv.style.display = 'none';
                return;
            }

            await loadTranscriptions(refId);
        }

        async function loadTranscriptions(refId) {
            const token = getCookie("auth-token");
            const listDiv = document.getElementById(`list-${refId}`);
            const textArea = document.getElementById(`trans-${refId}`);
            const controlsDiv = document.getElementById(`ctrl-${refId}`);

            if (!token) return;

            listDiv.innerHTML = "Loading...";
            listDiv.style.display = 'block';
            textArea.style.display = 'none';
            controlsDiv.style.display = 'none';

            try {
                const response = await fetch('/GetTranscriptions', {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ RefId: refId })
                });

                if (!response.ok) throw new Error("Failed to load transcriptions");

                const transcriptions = await response.json();

                if (transcriptions.length === 0) {
                    listDiv.innerHTML = "<em>No transcriptions found.</em>";
                    return;
                }

                let html = '<strong>Select a transcription to view:</strong><br>';
                transcriptions.forEach((t, index) => {
                    const date = new Date(t.transcribedAt).toLocaleString();
                    html += `<div class="transcription-item">
                        <a onclick="showTranscription(${refId}, ${index})">[${date}] ${t.transcriberLlmName}</a>
                    </div>`;

                    if (!listDiv.dataset.jsonData) listDiv.dataset.jsonData = JSON.stringify(transcriptions);
                });

                listDiv.innerHTML = html;

            } catch (err) {
                listDiv.innerHTML = "Error loading transcriptions.";
                console.error(err);
            }
        }

        function showTranscription(refId, index) {
            const listDiv = document.getElementById(`list-${refId}`);
            const textArea = document.getElementById(`trans-${refId}`);
            const controlsDiv = document.getElementById(`ctrl-${refId}`);
            const toggleBtn = document.getElementById(`btn-toggle-${refId}`);

            if (!listDiv.dataset.jsonData) return;

            const transcriptions = JSON.parse(listDiv.dataset.jsonData);
            const selected = transcriptions[index];

            window.currentTranscriptionIndices[refId] = index;

            // FIX: Explicitly show controls and textarea
            controlsDiv.style.display = 'flex';
            textArea.style.display = 'block';

            textArea.dataset.mode = 'content';
            textArea.classList.remove('json-mode');
            textArea.value = selected.transcribedContent || "No content available.";
            toggleBtn.innerText = "Show JSON";
        }

        function toggleJson(refId) {
            const textArea = document.getElementById(`trans-${refId}`);
            const toggleBtn = document.getElementById(`btn-toggle-${refId}`);
            const listDiv = document.getElementById(`list-${refId}`);

            if (!listDiv.dataset.jsonData) return;

            const index = window.currentTranscriptionIndices[refId];
            if (index === undefined) return;

            const transcriptions = JSON.parse(listDiv.dataset.jsonData);
            const selected = transcriptions[index];

            if (textArea.dataset.mode === 'content') {
                textArea.value = JSON.stringify(selected, null, 2);
                textArea.dataset.mode = 'json';
                textArea.classList.add('json-mode');
                toggleBtn.innerText = "Show Content";
            } else {
                textArea.value = selected.transcribedContent || "No content available.";
                textArea.dataset.mode = 'content';
                textArea.classList.remove('json-mode');
                toggleBtn.innerText = "Show JSON";
            }
        }

        loadDocs();
    </script>
</body>
</html>