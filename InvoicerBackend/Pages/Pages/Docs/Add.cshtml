@page "/Pages/Docs/Add"
@functions {
    public string StatusMessage { get; set; } = "Ready";
}
<!DOCTYPE html>
<html>
<head>
    <title>Add Document</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
</head>
<body>
    <div class="container">
        <h1>Add Document</h1>
        <div id="permWarning" class="perm-warning" style="display:none;"></div>
        <p>@StatusMessage</p>

        <div class="form-group">
            <label>Take Photo or Upload (Max 10MB input, will be resized)</label>
            <input type="file" id="fileInput" accept="image/*" capture="environment">
            <img id="preview" style="max-width:100%; display:none; border:1px solid #ccc;" />
        </div>

        <div class="form-group">
            <button class="btn btn-primary" id="btnUpload">Upload & Transcribe</button>
        </div>

        <div id="result" class="result-box" style="display:none;"></div>

        <div style="margin-top: 20px;">
            <a href="/Pages/Docs/Index">Back to List</a> |
            <a href="/Pages/Docs/Search">Search</a>
        </div>
    </div>

    <script src="/Pages/static/u.js"></script>
    <script>
        const requiredEndpoints = ["SaveRefDoc", "ReTranscribeRefDoc"];

        function convertToJpeg(file, maxWidth = 1920, quality = 0.9) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = (e) => {
                    const img = new Image();
                    img.onload = () => {
                        const canvas = document.createElement('canvas');
                        let width = img.width; let height = img.height;
                        if (width > maxWidth) { height = Math.round(height * (maxWidth / width)); width = maxWidth; }
                        canvas.width = width; canvas.height = height;
                        const ctx = canvas.getContext('2d');
                        ctx.fillStyle = "#FFFFFF"; ctx.fillRect(0, 0, width, height); ctx.drawImage(img, 0, 0, width, height);
                        resolve(canvas.toDataURL('image/jpeg', quality));
                    };
                    img.onerror = reject; img.src = e.target.result;
                };
                reader.onerror = reject; reader.readAsDataURL(file);
            });
        }

        document.getElementById('fileInput').addEventListener('change', function(e) {
            const file = e.target.files[0]; const preview = document.getElementById('preview');
            if (!file) { preview.style.display = 'none'; return; }
            if (file.size > 10 * 1024 * 1024) { alert("File too large."); return; }
            const reader = new FileReader(); reader.onload = (e) => { preview.src = e.target.result; preview.style.display = 'block'; }; reader.readAsDataURL(file);
        });

        document.getElementById('btnUpload').addEventListener('click', async function() {
            const token = await getCookie("auth-token");
            const file = document.getElementById('fileInput').files[0];
            const resultDiv = document.getElementById('result'); resultDiv.style.display = 'block';

            if (!file) { alert("Select a file."); return; }
            resultDiv.innerText = "Processing...";

            try {
                const jpegDataUrl = await convertToJpeg(file);
                if (jpegDataUrl.length > 12000000) throw new Error("Image too large after processing.");

                const base64Image = jpegDataUrl.split(',')[1];
                resultDiv.innerText = "Uploading...";

                // 1. Save
                const saveRes = await fetch('/SaveRefDoc', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ RefText: file.name, RefImage: base64Image })
                });
                if (!saveRes.ok) throw new Error(await saveRes.text());
                const savedDoc = await saveRes.json();
                resultDiv.innerText = `Saved! ID: ${savedDoc.refId}. Transcribing...`;

                // 2. Transcribe
                const transRes = await fetch('/ReTranscribeRefDoc', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ RefDoc: savedDoc.refId, TranscriberLlmName: "z-ai/glm-4.6v" })
                });
                if (!transRes.ok) throw new Error(await transRes.text());

                const transcription = await transRes.json();
                resultDiv.innerText = JSON.stringify(transcription, null, 2);
                alert("Success!");
                document.getElementById('fileInput').value = "";
                document.getElementById('preview').style.display = 'none';
            } catch (err) { resultDiv.innerText = "Error: " + err.message; }
        });

        checkPagePermissions(requiredEndpoints);
    </script>
</body>
</html>