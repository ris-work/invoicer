@page "/Pages/Docs/Untranscribed"
@functions {
    public string ErrorMessage { get; set; } = "";
}
<!DOCTYPE html>
<html>
<head>
    <title>Untranscribed Documents</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
</head>
<body>
    <h1>Untranscribed Documents</h1>
    <div id="permWarning" class="perm-warning" style="display:none;"></div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <p style="color: red;">@ErrorMessage</p>
    }

    <div id="docList">Loading...</div>

    <div style="margin-top: 20px;">
        <a href="/Pages/Docs/Index" class="btn btn-primary">Back to List</a>
    </div>

    <script src="/Pages/static/u.js"></script>
    <script>
        const requiredEndpoints = ["GetUntranscribed", "ReTranscribeRefDoc", "GetTranscriptions"];

        async function loadDocs() {
            const token = await getCookie("auth-token");
            const listDiv = document.getElementById('docList');
            try {
                const res = await fetch('/GetUntranscribed', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }, body: JSON.stringify({})
                });
                if (!res.ok) throw new Error("Failed");
                const docs = await res.json();

                if (docs.length === 0) { listDiv.innerHTML = "<p>None found.</p>"; return; }

                let html = '';
                docs.forEach(doc => {
                    html += s`
                        <div class="doc-card" id="card-${doc.refId}">
                            <div class="doc-header">
                                <div class="doc-title">${doc.refText || 'Untitled'}</div>
                                <button class="btn btn-warning" onclick="retranscribe(${doc.refId})">Transcribe</button>
                            </div>
                            <div class="doc-meta">ID: ${doc.refId}</div>
                            <img src="data:image/jpeg;base64,${doc.refImage}" class="doc-image" />
                        </div>`;
                });
                listDiv.innerHTML = html;
            } catch (err) { listDiv.innerHTML = s`<p style="color:red;">Error: ${err.message}</p>`; }
        }

        async function retranscribe(refId) {
            const token = await getCookie("auth-token");
            const card = document.getElementById(`card-${refId}`);
            const btn = card.querySelector("button");
            btn.disabled = true; btn.innerText = "Processing...";

            const res = await fetch('/ReTranscribeRefDoc', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ RefDoc: refId, TranscriberLlmName: "z-ai/glm-4.6v" })
            });
            if (res.ok) { alert("Done"); loadDocs(); } else { alert("Error"); btn.disabled = false; btn.innerText = "Transcribe"; }
        }

        checkPagePermissions(requiredEndpoints);
        loadDocs();
    </script>
</body>
</html>