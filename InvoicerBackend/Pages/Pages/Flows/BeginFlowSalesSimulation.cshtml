@page "/Pages/Flows/BeginFlowSalesSimulation"
@functions { }
<!DOCTYPE html>
<html>
<head>
    <title>Start Sales Simulation</title>
</head>
<body>
    <p>Initializing Sales Flow...</p>
    <script src="/Pages/static/u.js"></script>
    <script>
        const requiredEndpoints = ["SetFlowData"];

        async function init() {
            await checkPagePermissions(requiredEndpoints); // Optional check
            const token = await getCookie("auth-token");
            const flowId = 'flow-' + Date.now();

            const steps = [
                "/Pages/SearchAndSelect/PiiSelect",
                "/Pages/SearchAndSelect/ItemSelect",
                "/Pages/Sales/SelectPrice",
                "/Pages/Sales/EnterQuantity",
                "/Pages/Sales/ReviewBatches"
            ];

            await fetch('/SetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "FlowSteps", Value: JSON.stringify(steps) })
            });
            await fetch('/SetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "FlowStepIndex", Value: "0" })
            });

            window.location.href = steps[0] + "?flowId=" + flowId;
        }
        init();
    </script>
</body>
</html>