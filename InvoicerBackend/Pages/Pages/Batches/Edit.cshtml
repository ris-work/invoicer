@page "/Pages/Batches/Edit"
@functions { }
<!DOCTYPE html>
<html>
<head>
    <title>Edit Batch</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
</head>
<body>
    <h2>Edit Batch</h2>
    <div id="permWarning" class="perm-warning" style="display:none;"></div>
    <div id="status">Checking flow...</div>

    <div id="batchList" style="display:none;"><h3>Select Batch</h3><div id="listContent"></div></div>

    <div id="editForm" style="display:none;">
        <div class="form-group"><label>Item Code</label><input type="text" id="itemCode" readonly></div>
        <div class="form-group"><label>Batch Code</label><input type="text" id="batchCode" readonly></div>
        <div class="form-group"><label>Mfg Date</label><input type="date" id="mfgDate"></div>
        <div class="form-group"><label>Exp Date</label><input type="date" id="expDate"></div>
        <div class="form-group"><label>Remarks</label><textarea id="remarks" rows="3"></textarea></div>

        <div class="barcode-section">
            <h3>Barcodes</h3>
            <div class="input-group"><input type="text" id="newBarcode" placeholder="Scan/Enter"><button class="btn btn-secondary" onclick="addBarcode()">Add</button></div>
            <div id="barcodeList"></div>
        </div>
        <div style="margin-top: 20px;"><button class="btn btn-primary" onclick="saveBatch()">Save Changes</button></div>
    </div>

    <script src="/Pages/static/u.js"></script>
    <script>
        const params = new URLSearchParams(window.location.search);
        const flowId = params.get('flowId');
        const batchCodeParam = params.get('batchCode');
        let currentBatch = null;
        let selectedItemCode = null;
        const requiredEndpoints = ["GetFlowData", "SearchBatchesWeb", "GetBatchWeb", "GetBarcodes", "AssignBarcode", "EditBatchWeb"];

        async function init() {
            const token = await getCookie("auth-token");
            const flowRes = await fetch('/GetFlowData', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "selectedItemCode" })
            });
            const flowData = await flowRes.json();
            if (!flowData.value) { document.getElementById('status').innerText = "Flow Broken."; return; }
            selectedItemCode = flowData.value;
            document.getElementById('status').style.display = 'none';

            if (batchCodeParam) await loadBatch(selectedItemCode, batchCodeParam);
            else await loadBatchList(selectedItemCode);
        }

        async function loadBatchList(itemCode) {
            const token = await getCookie("auth-token");
            const listDiv = document.getElementById('batchList');
            const res = await fetch('/SearchBatchesWeb', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ ItemCode: parseInt(itemCode) })
            });
            const batches = await res.json();
            listDiv.style.display = 'block';
            if (batches.length === 0) { document.getElementById('listContent').innerHTML = "<p>No batches.</p>"; return; }
            document.getElementById('listContent').innerHTML = batches.map(b => s`
                <div class="batch-item">
                    <div><strong>Batch: ${b.batchcode}</strong> | Qty: ${b.units}</div>
                    <div class="batch-actions">
                        <a href="?flowId=${flowId}&batchCode=${b.batchcode}" class="btn-sm btn-primary">Edit</a>
                        <a href="/Pages/Batches/Split?flowId=${flowId}&itemCode=${b.itemcode}&batchCode=${b.batchcode}" class="btn-sm btn-warning">Split</a>
                        <a href="/Pages/Batches/Adjust?flowId=${flowId}&itemCode=${b.itemcode}&batchCode=${b.batchcode}" class="btn-sm btn-danger">Adjust</a>
                    </div>
                </div>
            `).join('');
        }

        async function loadBatch(itemCode, batchCode) {
            const token = await getCookie("auth-token");
            document.getElementById('editForm').style.display = 'block';
            const res = await fetch('/GetBatchWeb', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ ItemCode: parseInt(itemCode), BatchCode: parseInt(batchCode) })
            });
            currentBatch = await res.json();
            document.getElementById('itemCode').value = currentBatch.itemcode;
            document.getElementById('batchCode').value = currentBatch.batchcode;
            document.getElementById('mfgDate').value = currentBatch.mfgDate ? new Date(currentBatch.mfgDate).toISOString().split('T')[0] : "";
            document.getElementById('expDate').value = currentBatch.expDate ? new Date(currentBatch.expDate).toISOString().split('T')[0] : "";
            document.getElementById('remarks').value = currentBatch.remarks || "";
            await loadBarcodes(token);
        }

        async function loadBarcodes(token) {
            const res = await fetch('/GetBarcodes', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ Batchcode: parseInt(currentBatch.batchcode) })
            });
            const codes = await res.json();
            document.getElementById('barcodeList').innerHTML = codes.map(b => s`<div class="barcode-item"><strong>${b.code}</strong></div>`).join('');
        }

        async function addBarcode() {
            const token = await getCookie("auth-token");
            const code = document.getElementById('newBarcode').value; if(!code) return;
            const res = await fetch('/AssignBarcode', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ Code: code, Itemcode: parseInt(currentBatch.itemcode), Batchcode: parseInt(currentBatch.batchcode) })
            });
            if (res.ok) { document.getElementById('newBarcode').value = ""; await loadBarcodes(token); }
            else alert("Error adding barcode");
        }

        async function saveBatch() {
            const token = await getCookie("auth-token");
            const payload = { Itemcode: parseInt(currentBatch.itemcode), Batchcode: parseInt(currentBatch.batchcode) };
            const newMfg = document.getElementById('mfgDate').value;
            const newExp = document.getElementById('expDate').value;
            const newRem = document.getElementById('remarks').value;
            if (newMfg) payload.MfgDate = new Date(newMfg).toISOString();
            if (newExp) payload.ExpDate = new Date(newExp).toISOString();
            payload.Remarks = newRem;
            const res = await fetch('/EditBatchWeb', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            if (res.ok) { alert("Saved!"); location.reload(); }
            else alert("Error saving.");
        }

        checkPagePermissions(requiredEndpoints);
        init();
    </script>
</body>
</html>