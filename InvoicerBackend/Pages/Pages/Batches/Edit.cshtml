@page "/Pages/Batches/Edit"

@functions {
}

<!DOCTYPE html>
<html>
<head>
    <title>Edit Batch</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            font-family: sans-serif;
            padding: 20px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }

        input, select, textarea {
            width: 100%;
            padding: 8px;
            box-sizing: border-box;
        }

        button {
            padding: 10px 15px;
            cursor: pointer;
        }

        #batchList {
            margin-bottom: 20px;
        }

        .batch-item {
            border: 1px solid #ccc;
            padding: 10px;
            margin-bottom: 5px;
        }

        .batch-actions {
            margin-top: 8px;
            display: flex;
            gap: 5px;
            flex-wrap: wrap;
        }

        .btn-sm {
            padding: 5px 10px;
            font-size: 0.85em;
            text-decoration: none;
            color: white;
            border-radius: 3px;
            border: none;
            display: inline-block;
            cursor: pointer;
        }

        .btn-primary {
            background: #007bff;
        }

        .btn-warning {
            background: #ffc107;
            color: #000;
        }

        .btn-danger {
            background: #dc3545;
        }

        .btn-secondary {
            background: #6c757d;
        }
    </style>
</head>
<body>
    <h2>Edit Batch</h2>
    <div id="status">Checking flow...</div>

    <div id="batchList" style="display:none;">
        <div style="margin-bottom: 10px;">
            <a href="/Pages/Adjustments/Index" class="btn-sm btn-secondary">View All Adjustments</a>
        </div>
        <h3>Select Batch</h3>
        <div id="listContent"></div>
    </div>

    <div id="editForm" style="display:none;">
        <!-- ... Keep existing Edit Form HTML here ... -->
        <div class="form-group">
            <label>Item Code</label>
            <input type="text" id="itemCode" readonly>
        </div>
        <div class="form-group">
            <label>Batch Code</label>
            <input type="text" id="batchCode" readonly>
        </div>

        <div class="form-group">
            <label>Mfg Date</label>
            <input type="date" id="mfgDate">
        </div>
        <div class="form-group">
            <label>Exp Date</label>
            <input type="date" id="expDate">
        </div>

        <div class="form-group">
            <label>Remarks</label>
            <textarea id="remarks" rows="3"></textarea>
        </div>

        <div class="form-group">
            <label>Tags</label>
            <input type="text" id="tags">
        </div>

        <div class="form-group">
            <label>Volume Discounts Enabled</label>
            <input type="checkbox" id="volDisc">
        </div>
        <div class="form-group">
            <label>User Discounts Enabled</label>
            <input type="checkbox" id="userDisc">
        </div>

        <button onclick="saveBatch()">Save Changes</button>
    </div>

    <script>
        const params = new URLSearchParams(window.location.search);
        const flowId = params.get('flowId');
        let selectedItemCode = null;
        let initialBatchData = null;

        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
        }

        async function init() {
            const token = getCookie("auth-token");
            const statusDiv = document.getElementById('status');

            if (!flowId) {
                statusDiv.innerText = "Error: No Flow ID provided.";
                return;
            }

            const res = await fetch('/GetFlowData', {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ FlowId: flowId, Key: "selectedItemCode" })
            });

            const data = await res.json();
            if (!data.value) {
                statusDiv.innerText = "Flow Broken: No Item selected.";
                return;
            }

            selectedItemCode = data.value;
            statusDiv.style.display = 'none';

            const batchCodeParam = params.get('batchCode');
            if (batchCodeParam) {
                await loadBatch(selectedItemCode, batchCodeParam);
            } else {
                await loadBatchList(selectedItemCode);
            }
        }

        async function loadBatchList(itemCode) {
            const token = getCookie("auth-token");
            const listDiv = document.getElementById('batchList');
            const listContent = document.getElementById('listContent');

            const res = await fetch('/SearchBatchesWeb', {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ ItemCode: parseInt(itemCode) })
            });

            const batches = await res.json();
            listDiv.style.display = 'block';

            if (batches.length === 0) {
                listContent.innerHTML = "<p>No batches found.</p>";
                return;
            }

            listContent.innerHTML = batches.map(b => `
                <div class="batch-item">
                    <div><strong>Batch: ${b.batchcode}</strong> | Qty: ${b.units} | Exp: ${b.expDate ? new Date(b.expDate).toLocaleDateString() : 'N/A'}</div>
                    <div class="batch-actions">
                        <a href="?flowId=${flowId}&batchCode=${b.batchcode}" class="btn-sm btn-primary">Edit</a>
                        <a href="/Pages/Batches/Split?flowId=${flowId}&itemCode=${b.itemcode}&batchCode=${b.batchcode}" class="btn-sm btn-warning">Split</a>
                        <a href="/Pages/Batches/Adjust?flowId=${flowId}&itemCode=${b.itemcode}&batchCode=${b.batchcode}" class="btn-sm btn-danger">Adjustment</a>
                    </div>
                </div>
            `).join('');
        }

        async function loadBatch(itemCode, batchCode) {
            const token = getCookie("auth-token");
            const editForm = document.getElementById('editForm');
            const batchList = document.getElementById('batchList');

            batchList.style.display = 'none';
            editForm.style.display = 'block';

            const res = await fetch('/GetBatchWeb', {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ ItemCode: parseInt(itemCode), BatchCode: parseInt(batchCode) })
            });

            const batch = await res.json();
            if (!batch) { alert("Batch not found"); return; }

            initialBatchData = batch;

            document.getElementById('itemCode').value = batch.itemcode;
            document.getElementById('batchCode').value = batch.batchcode;
            document.getElementById('mfgDate').value = batch.mfgDate ? new Date(batch.mfgDate).toISOString().split('T')[0] : "";
            document.getElementById('expDate').value = batch.expDate ? new Date(batch.expDate).toISOString().split('T')[0] : "";
            document.getElementById('remarks').value = batch.remarks || "";
            document.getElementById('tags').value = batch.tags || "";
            document.getElementById('volDisc').checked = batch.volumeDiscounts;
            document.getElementById('userDisc').checked = batch.userDiscounts;
        }

        async function saveBatch() {
            const token = getCookie("auth-token");

            const payload = {
                Itemcode: parseInt(document.getElementById('itemCode').value),
                Batchcode: parseInt(document.getElementById('batchCode').value),
                MfgDate: document.getElementById('mfgDate').value ? new Date(document.getElementById('mfgDate').value).toISOString() : null,
                ExpDate: document.getElementById('expDate').value ? new Date(document.getElementById('expDate').value).toISOString() : null,
                Remarks: document.getElementById('remarks').value,
                Tags: document.getElementById('tags').value,
                VolumeDiscounts: document.getElementById('volDisc').checked,
                UserDiscounts: document.getElementById('userDisc').checked
            };

            const res = await fetch('/EditBatchWeb', {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (res.ok) {
                alert("Batch updated!");
                initialBatchData = { ...initialBatchData, ...payload };
            } else {
                alert("Error updating.");
            }
        }

        init();
    </script>
</body>
</html>