@page "/Pages/Catalogue/Edit"

@functions {
}

<!DOCTYPE html>
<html>
<head>
    <title>Edit Catalogue Item</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            font-family: sans-serif;
            padding: 20px;
        }

        .container {
            max-width: 600px;
            margin: 0 auto;
        }

        .form-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }

        input, select, textarea {
            width: 100%;
            padding: 8px;
            box-sizing: border-box;
        }

        button {
            padding: 10px 15px;
            cursor: pointer;
        }

        #preview {
            max-width: 100%;
            margin-top: 10px;
            border: 1px solid #ccc;
            display: none;
        }

        /* Section Styles */
        .section {
            margin-top: 20px;
            border-top: 1px solid #eee;
            padding-top: 15px;
        }

        .input-group {
            display: flex;
            gap: 5px;
            margin-bottom: 10px;
        }

        /* List Styles */
        .list-item {
            background: #f8f9fa;
            padding: 8px;
            margin-bottom: 5px;
            border-radius: 3px;
            border: 1px solid #e9ecef;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .list-item button {
                background: #dc3545;
                color: white;
                border: none;
                padding: 2px 8px;
                cursor: pointer;
                font-size: 0.8em;
            }
    </style>
    <!-- Assuming u.js is served statically, otherwise he() needs definition -->
    <script src="/Pages/static/u.js"></script>
</head>
<body>
    <div class="container">
        <h1>Edit Catalogue Item</h1>

        <div id="status">Loading...</div>

        <div id="editForm" style="display:none;">
            <div class="form-group">
                <label>Item Code</label>
                <input type="number" id="itemCode" readonly>
            </div>

            <div class="form-group">
                <label>Description</label>
                <input type="text" id="description">
            </div>

            <div class="form-group">
                <label>Active Status</label>
                <select id="active">
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>

            <div class="form-group">
                <label>Tags</label>
                <input type="text" id="tags">
            </div>

            <div class="form-group">
                <label>Remarks</label>
                <textarea id="remarks" rows="3"></textarea>
            </div>

            <div class="form-group">
                <label>Update Image (Optional)</label>
                <input type="file" id="fileInput" accept="image/*" capture="environment">
                <img id="preview" alt="Preview" />
            </div>

            <!-- Suggested Prices Section -->
            <div class="section">
                <h3>Suggested Prices</h3>
                <div class="form-group">
                    <div class="input-group">
                        <input type="number" id="newPrice" placeholder="Enter price (e.g. 350.00)" step="0.01">
                        <button onclick="addPrice()">Add</button>
                    </div>
                </div>
                <div id="priceList"></div>
            </div>

            <!-- Barcode Section -->
            <div class="section">
                <h3>Barcodes</h3>
                <div class="form-group">
                    <div class="input-group">
                        <input type="text" id="newBarcode" placeholder="Scan or enter barcode">
                        <button onclick="addBarcode()">Add</button>
                    </div>
                </div>
                <div id="barcodeList" class="list-group"></div>
            </div>

            <div style="margin-top: 20px;">
                <button onclick="saveItem()">Save All Changes</button>
            </div>
        </div>
    </div>

    <script>
        const params = new URLSearchParams(window.location.search);
        const itemCode = params.get('itemcode');
        let originalData = null;

        // State for lists
        let currentPrices = [];
        let originalPrices = [];
        let currentBarcodes = [];

        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
        }

        // Canvas resizing helper
        function convertToJpeg(file, maxWidth = 1920, quality = 0.9) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = (e) => {
                    const img = new Image();
                    img.onload = () => {
                        const canvas = document.createElement('canvas');
                        let width = img.width;
                        let height = img.height;
                        if (width > maxWidth) { height = Math.round(height * (maxWidth / width)); width = maxWidth; }
                        canvas.width = width; canvas.height = height;
                        const ctx = canvas.getContext('2d');
                        ctx.fillStyle = "#FFFFFF";
                        ctx.fillRect(0, 0, width, height);
                        ctx.drawImage(img, 0, 0, width, height);
                        resolve(canvas.toDataURL('image/jpeg', quality));
                    };
                    img.onerror = reject;
                    img.src = e.target.result;
                };
                reader.onerror = reject;
                reader.readAsDataURL(file);
            });
        }

        async function init() {
            const token = getCookie("auth-token");
            if (!itemCode) return;

            // 1. Load Item Data
            const res = await fetch('/GetCatalogueItemWeb', {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ ItemCode: parseInt(itemCode) })
            });

            if (!res.ok) { document.getElementById('status').innerText = "Error loading item."; return; }

            const data = await res.json();
            originalData = data;

            document.getElementById('itemCode').value = data.itemcode;
            document.getElementById('description').value = data.description || "";
            document.getElementById('active').value = data.active ? "true" : "false";
            document.getElementById('tags').value = data.tags || "";
            document.getElementById('remarks').value = data.remarks || "";

            // 2. Load Image
            if (data.refDocId && data.refDocId > 0) {
                const imgRes = await fetch('/CatalogueDefaultImageGet', {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ItemCode: parseInt(itemCode) })
                });
                if (imgRes.ok) {
                    const imgData = await imgRes.json();
                    if (imgData && imgData.imageBase64) {
                        document.getElementById('preview').src = `data:image/jpeg;base64,${imgData.imageBase64}`;
                        document.getElementById('preview').style.display = 'block';
                    }
                }
            }

            // 3. Load Prices
            await loadPrices(token);

            // 4. Load Barcodes
            await loadBarcodes(token);

            document.getElementById('status').style.display = 'none';
            document.getElementById('editForm').style.display = 'block';
        }

        // --- Price Logic ---
        async function loadPrices(token) {
            const res = await fetch('/GetSuggestedPrices', {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify(parseInt(itemCode))
            });
            const data = await res.json();

            originalPrices = data.map(p => p.price).sort((a,b) => a-b);
            currentPrices = [...originalPrices]; // Copy

            renderPrices();
        }

        function renderPrices() {
            const list = document.getElementById('priceList');
            // Use he() for XSS protection
            list.innerHTML = currentPrices.map((p, i) => `
                <div class="list-item">
                    <span>${he(p.toFixed(2))}</span>
                    <button onclick="removePrice(${i})">X</button>
                </div>
            `).join('');
        }

        function addPrice() {
            const input = document.getElementById('newPrice');
            const val = parseFloat(input.value);
            if (isNaN(val) || val <= 0) { alert("Invalid price"); return; }

            if (!currentPrices.includes(val)) {
                currentPrices.push(val);
                currentPrices.sort((a,b) => a-b);
                renderPrices();
            }
            input.value = "";
        }

        function removePrice(index) {
            currentPrices.splice(index, 1);
            renderPrices();
        }

        // --- Barcode Logic ---
        async function loadBarcodes(token) {
            const res = await fetch('/GetBarcodes', {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ Itemcode: parseInt(itemCode) })
            });
            currentBarcodes = await res.json();
            renderBarcodes();
        }

        function renderBarcodes() {
            const list = document.getElementById('barcodeList');
            list.innerHTML = currentBarcodes.map(b => `
                <div class="list-item">
                    <span>${he(b.code)}</span>
                </div>
            `).join('');
        }

        async function addBarcode() {
            const token = getCookie("auth-token");
            const code = document.getElementById('newBarcode').value;
            if (!code) return;

            const res = await fetch('/AssignBarcode', {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ Code: code, Itemcode: parseInt(itemCode) })
            });

            if (res.ok) {
                document.getElementById('newBarcode').value = "";
                await loadBarcodes(token);
            } else {
                alert("Error adding barcode");
            }
        }

        // --- Save Logic ---
        async function saveItem() {
            const token = getCookie("auth-token");
            const payload = { ItemCode: parseInt(itemCode) };

            // 1. Track Item Changes
            if (document.getElementById('description').value !== originalData.description) payload.Description = document.getElementById('description').value;
            if (document.getElementById('active').value !== (originalData.active ? "true" : "false")) payload.Active = document.getElementById('active').value === "true";
            if (document.getElementById('tags').value !== (originalData.tags || "")) payload.Tags = document.getElementById('tags').value;
            if (document.getElementById('remarks').value !== (originalData.remarks || "")) payload.Remarks = document.getElementById('remarks').value;

            // Save Item Metadata
            if (Object.keys(payload).length > 1) {
                const res = await fetch('/EditCatalogueWeb', {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (!res.ok) { alert("Error saving item: " + await res.text()); return; }
            }

            // 2. Save Prices (if changed)
            const pricesChanged = (JSON.stringify(currentPrices) !== JSON.stringify(originalPrices));

            if (pricesChanged) {
                const pRes = await fetch('/SetSuggestedPrices', {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ItemCode: parseInt(itemCode), Prices: currentPrices })
                });
                if (!pRes.ok) { alert("Error saving prices"); }
            }

            // 3. Save Image if changed
            const fileInput = document.getElementById('fileInput');
            if (fileInput.files.length > 0) {
                const file = fileInput.files[0];
                const jpegDataUrl = await convertToJpeg(file);
                const base64Image = jpegDataUrl.split(',')[1];

                const imgRes = await fetch('/CatalogueDefaultImageSet', {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ItemCode: parseInt(itemCode), ImageBase64: base64Image })
                });
                if (!imgRes.ok) { alert("Error uploading image"); }
            }

            alert("Saved Successfully!");
            location.reload();
        }

        init();
    </script>
</body>
</html>