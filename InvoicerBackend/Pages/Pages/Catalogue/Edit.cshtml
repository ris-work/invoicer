@page "/Pages/Catalogue/Edit"
@functions { }
<!DOCTYPE html>
<html>
<head>
    <title>Edit Catalogue Item</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
</head>
<body>
    <div class="container">
        <h1>Edit Catalogue Item</h1>
        <div id="permWarning" class="perm-warning" style="display:none;"></div>
        <div id="status">Loading...</div>

        <div id="editForm" style="display:none;">
            <div class="form-group"><label>Item Code</label><input type="number" id="itemCode" readonly></div>
            <div class="form-group"><label>Description</label><input type="text" id="description"></div>
            <div class="form-group"><label>Active</label><select id="active"><option value="true">Active</option><option value="false">Inactive</option></select></div>
            <div class="form-group"><label>Tags</label><input type="text" id="tags"></div>
            <div class="form-group"><label>Remarks</label><textarea id="remarks"></textarea></div>
            <div class="form-group"><label>Update Image</label><input type="file" id="fileInput"><img id="preview" style="display:none; max-width:100%;"></div>

            <div class="section">
                <h3>Suggested Prices</h3>
                <div class="input-group"><input type="number" id="newPrice" step="0.01"><button class="btn btn-secondary" onclick="addPrice()">Add</button></div>
                <div id="priceList"></div>
            </div>

            <div class="section">
                <h3>Barcodes</h3>
                <div class="input-group"><input type="text" id="newBarcode"><button class="btn btn-secondary" onclick="addBarcode()">Add</button></div>
                <div id="barcodeList"></div>
            </div>

            <div style="margin-top: 20px;"><button class="btn btn-primary" onclick="saveItem()">Save All</button></div>
        </div>
    </div>

    <script src="/Pages/static/u.js"></script>
    <script>
        const params = new URLSearchParams(window.location.search);
        const itemCode = params.get('itemcode');
        let originalData = null;
        let currentPrices = [];
        let originalPrices = [];
        let currentBarcodes = [];
        const requiredEndpoints = ["GetCatalogueItemWeb", "CatalogueDefaultImageGet", "GetSuggestedPrices", "SetSuggestedPrices", "GetBarcodes", "AssignBarcode", "EditCatalogueWeb", "CatalogueDefaultImageSet"];

        async function init() {
            const token = await getCookie("auth-token");
            if (!itemCode) return;
            const res = await fetch('/GetCatalogueItemWeb', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ ItemCode: parseInt(itemCode) })
            });
            if (!res.ok) return;
            const data = await res.json();
            originalData = data;
            document.getElementById('itemCode').value = data.itemcode;
            document.getElementById('description').value = data.description || "";
            document.getElementById('active').value = data.active ? "true" : "false";
            document.getElementById('tags').value = data.tags || "";
            document.getElementById('remarks').value = data.remarks || "";

            // Load Image
            if (data.refDocId > 0) {
                const imgRes = await fetch('/CatalogueDefaultImageGet', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ItemCode: parseInt(itemCode) })
                });
                if (imgRes.ok) {
                    const imgData = await imgRes.json();
                    if (imgData?.imageBase64) {
                        document.getElementById('preview').src = `data:image/jpeg;base64,${imgData.imageBase64}`;
                        document.getElementById('preview').style.display = 'block';
                    }
                }
            }
            await loadPrices(token);
            await loadBarcodes(token);
            document.getElementById('status').style.display = 'none';
            document.getElementById('editForm').style.display = 'block';
        }

        async function loadPrices(token) {
            const res = await fetch('/GetSuggestedPrices', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify(parseInt(itemCode))
            });
            const data = await res.json();
            originalPrices = data.map(p => p.price).sort((a,b) => a-b);
            currentPrices = [...originalPrices];
            renderPrices();
        }

        function renderPrices() {
            document.getElementById('priceList').innerHTML = currentPrices.map((p, i) => s`
                <div class="list-item"><span>${p.toFixed(2)}</span><button onclick="removePrice(${i})">X</button></div>
            `).join('');
        }
        function addPrice() { const v = parseFloat(document.getElementById('newPrice').value); if (v && !currentPrices.includes(v)) { currentPrices.push(v); currentPrices.sort((a,b)=>a-b); renderPrices(); } }
        function removePrice(i) { currentPrices.splice(i, 1); renderPrices(); }

        async function loadBarcodes(token) {
            const res = await fetch('/GetBarcodes', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ Itemcode: parseInt(itemCode) })
            });
            currentBarcodes = await res.json();
            document.getElementById('barcodeList').innerHTML = currentBarcodes.map(b => s`<div class="list-item"><span>${b.code}</span></div>`).join('');
        }
        async function addBarcode() {
            const token = await getCookie("auth-token");
            const code = document.getElementById('newBarcode').value; if(!code) return;
            const res = await fetch('/AssignBarcode', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ Code: code, Itemcode: parseInt(itemCode) })
            });
            if(res.ok) { document.getElementById('newBarcode').value = ""; await loadBarcodes(token); }
        }

        async function saveItem() {
            const token = await getCookie("auth-token");
            const payload = { ItemCode: parseInt(itemCode) };
            if (document.getElementById('description').value !== originalData.description) payload.Description = document.getElementById('description').value;
            // ... other fields
            if (Object.keys(payload).length > 1) {
                 await fetch('/EditCatalogueWeb', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
            }
            if (JSON.stringify(currentPrices) !== JSON.stringify(originalPrices)) {
                 await fetch('/SetSuggestedPrices', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ItemCode: parseInt(itemCode), Prices: currentPrices })
                });
            }
            // Handle Image upload...
            alert("Saved!"); location.reload();
        }

        checkPagePermissions(requiredEndpoints);
        init();
    </script>
</body>
</html>