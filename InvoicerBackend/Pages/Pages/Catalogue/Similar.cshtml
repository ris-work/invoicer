@page "/Pages/Catalogue/Similar"
@functions { }
<!DOCTYPE html>
<html>
<head>
    <title>Similar Items</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
</head>
<body>
    <h1>Similar Items</h1>
    <div id="permWarning" class="perm-warning" style="display:none;"></div>

    <div class="form-group"><label>Item Code or Description</label><input type="text" id="searchQuery"></div>
    <button class="btn btn-primary" id="btnFind">Find Similar</button>
    <div id="results" style="margin-top: 20px;"></div>

    <script src="/Pages/static/u.js"></script>
    <script>
        const requiredEndpoints = ["SuggestCatalogueWeb"];

        document.getElementById('btnFind').addEventListener('click', async function() {
            const token = await getCookie("auth-token");
            const query = document.getElementById('searchQuery').value;
            const resultsDiv = document.getElementById('results');
            if(!query) return;
            resultsDiv.innerHTML = "Finding...";

            try {
                const res = await fetch('/SuggestCatalogueWeb', {
                    method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({ Query: query })
                });
                if (!res.ok) throw new Error("Request failed");
                const items = await res.json();
                if (items.length === 0) { resultsDiv.innerHTML = "<p>No similar items.</p>"; return; }

                let html = `<h3>${items.length} Item(s)</h3>`;
                items.forEach(item => {
                    html += s`
                        <div class="result-card">
                            <div class="result-title">${item.itemcode} - ${item.description || "N/A"}</div>
                            <div class="result-meta">Created: ${new Date(item.createdOn).toLocaleString()}</div>
                            <a href="/Pages/Catalogue/Edit?itemcode=${item.itemcode}">Edit</a>
                        </div>`;
                });
                resultsDiv.innerHTML = html;
            } catch (err) { resultsDiv.innerHTML = s`<p style="color:red;">Error: ${err.message}</p>`; }
        });

        checkPagePermissions(requiredEndpoints);
    </script>
</body>
</html>