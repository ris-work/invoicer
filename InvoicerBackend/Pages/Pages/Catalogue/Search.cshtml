@page "/Pages/Catalogue/Search"

@functions {
}

<!DOCTYPE html>
<html>
<head>
    <title>Search Catalogue</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
        body {
            font-family: sans-serif;
            padding: 20px;
        }

        .container {
            max-width: 600px;
            margin: 0 auto;
        }

        .form-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }

        input[type="text"] {
            width: 100%;
            padding: 8px;
            box-sizing: border-box;
        }

        button {
            padding: 10px 15px;
            cursor: pointer;
        }

        .result-card {
            border: 1px solid #ddd;
            padding: 10px;
            margin-bottom: 10px;
            border-radius: 5px;
        }

        .result-title {
            font-weight: bold;
            font-size: 1.1em;
        }

        .result-meta {
            font-size: 0.9em;
            color: #666;
            margin-top: 5px;
        }
    </style>
</head>
<body>
    <h1>Search Catalogue</h1>

    <div class="form-group">
        <label>Search or Scan Barcode</label>
        <input type="text" id="searchQuery" placeholder="Type description or scan barcode...">
    </div>

    <button id="btnSearch">Search</button>

    <div id="results" style="margin-top: 20px;"></div>

    <div style="margin-top: 20px;">
        <a href="/Pages/Catalogue/Add">Add New</a>
    </div>

    <script>
        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
        }

        async function handleSearch() {
            const token = getCookie("auth-token");
            const query = document.getElementById('searchQuery').value;
            const resultsDiv = document.getElementById('results');

            if (!token) {
                window.location.href = '/Pages/LoginWeb';
                return;
            }

            if (!query) {
                alert("Please enter a search term.");
                return;
            }

            resultsDiv.innerHTML = "Checking...";

            try {
                // 1. Check if it is a barcode first
                const barcodeRes = await fetch('/ResolveBarcode', {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(query) // Send raw string
                });

                if (barcodeRes.ok) {
                    const barcodeData = await barcodeRes.json();

                    if (barcodeData.found) {
                        resultsDiv.innerHTML = "<p>Barcode found! Redirecting...</p>";

                        if (barcodeData.batchCode) {
                            // Redirect to Batch Edit
                            // We need to create a flow for this
                            const flowId = 'flow-' + Date.now();
                            // Set Flow Data
                            await fetch('/SetFlowData', {
                                method: 'POST',
                                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                                body: JSON.stringify({ FlowId: flowId, Key: "selectedItemCode", Value: barcodeData.itemCode.toString() })
                            });

                            window.location.href = `/Pages/Batches/Edit?flowId=${flowId}&batchCode=${barcodeData.batchCode}`;
                            return;
                        }
                        else if (barcodeData.itemCode) {
                            // Redirect to Item Edit
                            window.location.href = `/Pages/Catalogue/Edit?itemcode=${barcodeData.itemCode}`;
                            return;
                        }
                    }
                }

                // 2. If not a barcode, do normal search
                resultsDiv.innerHTML = "Searching...";

                const searchRes = await fetch('/SearchCatalogueWeb', {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ Query: query })
                });

                if (!searchRes.ok) throw new Error(`Error ${searchRes.status}`);
                const items = await searchRes.json();

                if (items.length === 0) {
                    resultsDiv.innerHTML = "<p>No results found.</p>";
                    return;
                }

                let html = `<h3>${items.length} Result(s)</h3>`;
                items.forEach(item => {
                    const date = new Date(item.createdOn).toLocaleString();
                    html += `
                        <div class="result-card">
                            <div class="result-title">${item.itemcode} - ${item.description || "No Description"}</div>
                            <div class="result-meta">ID: ${item.itemcode} | Created: ${date}</div>
                            <a href="/Pages/Catalogue/Edit?itemcode=${item.itemcode}" style="color:#007bff;">Edit</a>
                        </div>
                    `;
                });
                resultsDiv.innerHTML = html;

            } catch (err) {
                resultsDiv.innerHTML = `<p style="color: red;">Search failed: ${err.message}</p>`;
                console.error(err);
            }
        }

        document.getElementById('btnSearch').addEventListener('click', handleSearch);

        // Optional: Auto-search on Enter key
        document.getElementById('searchQuery').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') handleSearch();
        });
    </script>
</body>
</html>