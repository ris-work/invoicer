@page "/Pages/Catalogue/Search"
@functions { }
<!DOCTYPE html>
<html>
<head>
    <title>Search Catalogue</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
</head>
<body>
    <h1>Search Catalogue</h1>
    <div id="permWarning" class="perm-warning" style="display:none;"></div>

    <div class="form-group"><label>Search or Scan</label><input type="text" id="searchQuery"></div>
    <button class="btn btn-primary" id="btnSearch">Search</button>
    <div id="results" style="margin-top: 20px;"></div>
    <div style="margin-top: 20px;"><a href="/Pages/Catalogue/Add" class="btn btn-secondary">Add New</a></div>

    <script src="/Pages/static/u.js"></script>
    <script>
        const requiredEndpoints = ["ResolveBarcode", "SetFlowData", "SearchCatalogueWeb"];

        async function handleSearch() {
            const token = await getCookie("auth-token");
            const query = document.getElementById('searchQuery').value;
            const resultsDiv = document.getElementById('results');
            if(!query) return;
            resultsDiv.innerHTML = "Checking...";

            // 1. Barcode
            const bRes = await fetch('/ResolveBarcode', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify(query)
            });
            if (bRes.ok) {
                const bData = await bRes.json();
                if (bData.found && bData.batchCode) {
                    const flowId = 'flow-' + Date.now();
                    await fetch('/SetFlowData', {
                        method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                        body: JSON.stringify({ FlowId: flowId, Key: "selectedItemCode", Value: bData.itemCode.toString() })
                    });
                    window.location.href = `/Pages/Batches/Edit?flowId=${flowId}&batchCode=${bData.batchCode}`;
                    return;
                } else if (bData.found && bData.itemCode) {
                    window.location.href = `/Pages/Catalogue/Edit?itemcode=${bData.itemCode}`;
                    return;
                }
            }

            // 2. Search
            const sRes = await fetch('/SearchCatalogueWeb', {
                method: 'POST', headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({ Query: query })
            });
            if (!sRes.ok) { resultsDiv.innerHTML = "<p>Error</p>"; return; }
            const items = await sRes.json();
            if (items.length === 0) { resultsDiv.innerHTML = "<p>No results.</p>"; return; }

            let html = `<h3>${items.length} Result(s)</h3>`;
            items.forEach(item => {
                html += s`
                    <div class="result-card">
                        <div class="result-title">${item.itemcode} - ${item.description || "N/A"}</div>
                        <div class="result-meta">Created: ${new Date(item.createdOn).toLocaleString()}</div>
                        <a href="/Pages/Catalogue/Edit?itemcode=${item.itemcode}">Edit</a>
                    </div>`;
            });
            resultsDiv.innerHTML = html;
        }

        document.getElementById('btnSearch').addEventListener('click', handleSearch);
        document.getElementById('searchQuery').addEventListener('keypress', (e) => { if (e.key === 'Enter') handleSearch(); });

        checkPagePermissions(requiredEndpoints);
    </script>
</body>
</html>