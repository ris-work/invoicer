@page "/Pages/SessionInfo"
@functions { }
<!DOCTYPE html>
<html>
<head>
    <title>Session Info</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
</head>
<body>
    <h2>Active Flow Sessions</h2>
    <div id="content">Loading...</div>

    <script src="/Pages/static/u.js"></script>
    <script>
        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
        }

        async function load() {
            const token = getCookie("auth-token");
            const res = await fetch('/GetAllFlows', {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                body: JSON.stringify({})
            });

            const data = await res.json();
            const container = document.getElementById('content');
            const flows = Object.entries(data);

            if (flows.length === 0) {
                container.innerHTML = "<p>No active flows found.</p>"; return;
            }

            let html = '';
            flows.forEach(([id, values]) => {
                // Using s for XSS protection
                html += s`
                <div class="flow-card">
                    <div class="flow-header" onclick="this.nextElementSibling.style.display = this.nextElementSibling.style.display === 'block' ? 'none' : 'block'">
                        Flow ID: ${id}
                    </div>
                    <div class="flow-body">
                        <table>
                            <thead><tr><th>Key</th><th>Value</th></tr></thead>
                            <tbody>
                                ${Object.entries(values).map(([k, v]) => s`<tr><td>${k}</td><td>${v}</td></tr>`).join('')}
                            </tbody>
                        </table>
                    </div>
                </div>`;
            });
            container.innerHTML = html;
        }
        load();
    </script>
</body>
</html>