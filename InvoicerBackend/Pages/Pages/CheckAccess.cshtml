@page "/Pages/CheckAccess"
@functions { }
<!DOCTYPE html>
<html>
<head>
    <title>Access Control Check</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/Pages/static/u.css">
</head>
<body>
    <div class="container">
        <h1>Endpoint Access Check</h1>

        <div class="search-box">
            <input type="text" id="searchInput" placeholder="Search endpoints (e.g. BearerEcho, SaveMap)..." oninput="filterList()">
        </div>

        <div id="endpointList" class="endpoint-list">
            <p>Loading endpoints...</p>
        </div>
    </div>

    <!-- Modal -->
    <div id="resultModal" class="result-modal" onclick="closeModal(event)">
        <div class="modal-content" onclick="event.stopPropagation()">
            <div class="modal-header" id="modalTitle">Details</div>
            <div id="modalBody"></div>
            <div class="modal-footer">
                <button class="btn btn-close" onclick="closeModal()">Close</button>
            </div>
        </div>
    </div>

    <script src="/Pages/static/u.js"></script>
    <script>
        let allEndpoints = [];
        let userPrivileges = [];

        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${name}=`);
            if (parts.length === 2) return parts.pop().split(';').shift();
        }

        async function init() {
            const token = getCookie("auth-token");
            try {
                // 1. Fetch Privileges (Once)
                const privRes = await fetch('/BearerPrivileges', {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
                    body: JSON.stringify({})
                });

                if (privRes.ok) {
                    userPrivileges = await privRes.json(); // string[]
                    // Normalize to lowercase for comparison
                    userPrivileges = (userPrivileges || []).map(p => p.toLowerCase());
                } else {
                    console.error("Failed to fetch privileges");
                }

                // 2. Fetch Endpoints
                const res = await fetch('/Endpoints', {
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                allEndpoints = await res.json();

                // 3. Render with Calculated Permissions
                renderList(allEndpoints);

            } catch (e) {
                document.getElementById('endpointList').innerHTML = s`<p style="color:red">Failed to load: ${e.message}</p>`;
            }
        }

        function renderList(data) {
            const container = document.getElementById('endpointList');
            if (data.length === 0) {
                container.innerHTML = "<p>No endpoints found.</p>";
                return;
            }

            container.innerHTML = data.map(ep => {
                // Client-side check (case-insensitive)
                const required = (ep.privilege || "").toLowerCase();
                const allowed = userPrivileges.includes(required);

                const statusClass = allowed ? 'status-granted' : 'status-denied';
                const badgeClass = allowed ? 'badge-granted' : 'badge-denied';
                const badgeText = allowed ? 'Allowed' : 'Denied';

                return s`
                <div class="endpoint-card ${statusClass}" onclick="showDetails('${ep.name}', ${allowed}, '${ep.privilege}')">
                    <div>
                        <span class="endpoint-name">${ep.name}</span>
                        <span class="status-badge ${badgeClass}">${badgeText}</span>
                    </div>
                    <div class="endpoint-meta">
                        Privilege: <strong>${ep.privilege}</strong> |
                        Input: ${ep.inputType} | Output: ${ep.outputType}
                    </div>
                </div>`;
            }).join('');
        }

        function filterList() {
            const query = document.getElementById('searchInput').value.toLowerCase();
            const filtered = allEndpoints.filter(ep =>
                ep.name.toLowerCase().includes(query) ||
                ep.privilege.toLowerCase().includes(query)
            );
            renderList(filtered);
        }

        function showDetails(name, allowed, priv) {
            const modal = document.getElementById('resultModal');
            const title = document.getElementById('modalTitle');
            const body = document.getElementById('modalBody');

            title.innerText = allowed ? "✅ Access Granted" : "⛔ Access Denied";

            body.innerHTML = s`
                <p><strong>Endpoint:</strong> ${name}</p>
                <p><strong>Required Privilege:</strong> ${priv}</p>
                <p><strong>Status:</strong> ${allowed ? "You have permission." : "Permission denied."}</p>
            `;

            modal.style.display = 'flex';
        }

        function closeModal(e) {
            if (!e || e.target.id === 'resultModal') {
                document.getElementById('resultModal').style.display = 'none';
            }
        }

        init();
    </script>
</body>
</html>