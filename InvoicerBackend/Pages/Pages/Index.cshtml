@page "/Pages/Index"

@functions {
    public string TextContent { get; set; } = "";
    public string Result { get; set; } = "";
    public static int Count = 0;

    public string ActiveHandler { get; set; } = "Initial Load";

    // MAGIC: Triggered when URL contains ?handler=Echo
    public void OnPostEcho()
    {
        ActiveHandler = "Magic Echo (URL Mode)";
        TextContent = Request.Form["Text"].ToString();
        Result = TextContent;
    }

    // MAGIC: Triggered when URL contains ?handler=Increment
    public void OnPostIncrement()
    {
        ActiveHandler = "Magic Increment (URL Mode)";
        Count++;
        // Keep the text box populated
        TextContent = Request.Form["Text"].ToString();
    }
}

<!DOCTYPE html>
<html>
<body>
    <h1>Reliable Magic Mode</h1>

    <form action="/Pages/Index" method="post">
        @Html.AntiForgeryToken()

        <input type="text" name="Text" placeholder="Type something..." value="@TextContent" />

        @* 
           THE FIX:
           'formaction' overrides the form's action for just this button.
           It adds ?handler=Echo to the URL, forcing OnPostEcho to run.
           This is 100% reliable, unlike the form-body convention.
        *@
        <button type="submit" formaction="/Pages/Index?handler=Echo">Echo Text</button>
        <button type="submit" formaction="/Pages/Index?handler=Increment">Increment (@Count)</button>
    </form>

    <div style="background: #f0f0f0; padding: 15px; margin-top: 20px; border: 1px solid #ccc;">
        <h3>App State:</h3>
        <p><strong>Last Handler Run:</strong> @ActiveHandler</p>
        <p><strong>Current Count:</strong> @Count</p>
        <p><strong>Result Text:</strong> @Result</p>
    </div>

    @* --- THE COMPREHENSIVE DUMP --- *@
    <div style="background: #e6f7ff; padding: 15px; margin-top: 20px; border: 1px solid blue;">
        <h3>Full Request Dump</h3>

        <p><strong>Method:</strong> @Request.Method</p>
        <p><strong>URL (Query String):</strong> @Request.QueryString</p>
        <p><strong>Content-Type:</strong> @Request.ContentType</p>

        <h4>Form Body Data:</h4>
        @if (Request.HasFormContentType)
        {
            @if (Request.Form.Count > 0)
            {
                <ul>
                    @foreach (var key in Request.Form.Keys)
                    {
                        <li><strong>@key:</strong> @Request.Form[key]</li>
                    }
                </ul>
            }
            else
            {
                <p style="color:red; font-style:italic;">Form is empty (no data found in body)</p>
            }
        }
        else
        {
            <p style="color:red; font-style:italic;">Request is not a Form (likely GET)</p>
        }
    </div>
</body>
</html>