@page "/Pages/EndpointsBrowser"
@functions { }
<!DOCTYPE html>
<html>
<head>
    <title>API Endpoints</title>
    <link rel="stylesheet" href="/Pages/static/u.css">
</head>
<body>
    <h2>API Endpoints Definition</h2>
    <div id="list">Loading...</div>

    <script src="/Pages/static/u.js"></script>
    <script>
        function getCookie(n) {
            const v = `; ${document.cookie}`;
            const p = v.split(`; ${n}=`);
            return p.length === 2 ? p.pop().split(';').shift() : null;
        }

        async function load() {
            const token = getCookie("auth-token");
            const res = await fetch('/Endpoints', {
                method: 'GET',
                headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' }
            });

            if (!res.ok) {
                document.getElementById('list').innerText = "Error loading endpoints: " + await res.text();
                return;
            }

            const data = await res.json();
            render(data);
        }

        function render(data) {
            const container = document.getElementById('list');
            container.innerHTML = '';

            data.forEach(endpoint => {
                const card = document.createElement('div');
                card.className = 'card';

                // Using s for XSS safety
                card.innerHTML = s`
                    <div class="endpoint-name" style="margin-bottom:10px; border-bottom:1px solid #eee; padding-bottom:5px;">
                        ${endpoint.name}
                        <span class="btn btn-secondary" style="float:right; cursor:default;">${endpoint.privilege}</span>
                    </div>
                    <div>
                        <h4>Input: ${endpoint.inputType}</h4>
                        <pre>${JSON.stringify(endpoint.inputSchema, null, 2)}</pre>
                    </div>
                    <div>
                        <h4>Output: ${endpoint.outputType}</h4>
                        <pre>${JSON.stringify(endpoint.outputSchema, null, 2)}</pre>
                    </div>
                `;
                container.appendChild(card);
            });
        }
        load();
    </script>
</body>
</html>